---
import jetBrainsMono400Url from "@fontsource/jetbrains-mono/latin-400.css?url";
import outfit400Url from "@fontsource/outfit/latin-400.css?url";
import outfit500Url from "@fontsource/outfit/latin-500.css?url";
import smileyFontUrl from "cn-fontsource-smiley-sans-oblique-regular/font.css?url";
import { ClientRouter } from "astro:transitions";
import TrackCar from "@/components/astro/TrackCar.astro";
import { MobileHeaderMenu } from "@/components/mobile-header-menu";
import { SearchDialog } from "@/components/search-dialog";
import {
  buildJsonLd,
  OG_HEIGHT,
  OG_WIDTH,
  ogType,
  pageImage,
  pageTitle,
  type PageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site";
import "../index.css";

type Props = {
  meta: PageMeta;
  noindex?: boolean;
  status?: string;
};

const { meta, noindex = false, status } = Astro.props;
const currentPath = decodeURI(Astro.url.pathname.replace(/\/$/, "") || "/");
const image = pageImage(meta);
const title = pageTitle(meta);
const analyticsHost = new URL(siteConfig.url).hostname;
const fontUrls = [outfit400Url, outfit500Url, jetBrainsMono400Url, smileyFontUrl];
const navItems = [
  { href: "/projects/", path: "/projects" },
  { href: "/photos/", path: "/photos" },
  { href: "/about/", path: "/about" },
  { href: "/feed.xml", path: "/feed" },
];
const defaultStatus = currentPath.startsWith("/posts/")
  ? "READING"
  : currentPath.startsWith("/tags/")
    ? "TAG ARCHIVE"
    : currentPath === "/projects"
      ? "PROJECTS"
      : currentPath === "/photos"
        ? "PHOTOS"
        : currentPath === "/about"
          ? "ABOUT"
          : currentPath === "/"
            ? "NORMAL"
            : "SYSTEM";
const pageTransition = {
  forwards: {
    old: {
      name: "page-slide-out-left",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "page-slide-in-right",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "page-slide-out-right",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "page-slide-in-left",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
};
---

<!doctype html>
<html lang={siteConfig.language} transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={meta.url} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href={`${siteConfig.url}/feed.xml`}
    />
    <meta name="theme-color" content="#fafaf7" />
    <script is:inline>
      (function () {
        var colorScheme = matchMedia("(prefers-color-scheme: dark)");

        function applyTheme() {
          var theme = colorScheme.matches ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) {
            themeColor.setAttribute("content", theme === "dark" ? "#131418" : "#fafaf7");
          }
        }

        applyTheme();
        colorScheme.addEventListener("change", applyTheme);
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <meta property="og:type" content={ogType(meta)} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={meta.title} />
    {
      meta.type === "article" && meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    {
      meta.type === "article" &&
        meta.tags?.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    {fontUrls.map((href) => <link rel="stylesheet" href={href} />)}
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(buildJsonLd(meta))}></script>
  </head>
  <body>
    <div class="relative min-h-[100dvh] pb-[30px]">
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[6px] focus:bg-ink-800 focus:px-4 focus:py-2 focus:text-paper"
      >
        跳到正文
      </a>

      <header class="sticky top-0 z-20 border-b border-line bg-surface">
        <div class="mx-auto flex h-[60px] max-w-320 items-center gap-3 px-3 sm:gap-4 sm:px-6 lg:px-8">
          <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="返回首页">
            <img
              src="/logo.svg"
              alt=""
              width="28"
              height="28"
              class="site-logo h-7 w-7 object-contain"
            />
            <span class="hidden font-mono text-xs tracking-[0.05em] text-ink-800 sm:inline">
              xingkaixin.me
            </span>
          </a>

          {currentPath !== "/" && (
            <span class="hidden max-w-52 shrink-0 truncate font-mono text-xs text-ink-400 xl:inline">
              {currentPath}
            </span>
          )}

          <SearchDialog client:load />

          <nav aria-label="主导航" class="hidden shrink-0 items-center gap-0.5 lg:flex">
            {
              navItems.map((item) => {
                const active = currentPath === item.path;
                return (
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "rounded-[6px] px-2.5 py-1.5 font-mono text-xs transition-colors duration-(--duration-quick) hover:bg-ink-50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40",
                      active ? "bg-ink-50 text-ink-800" : "text-ink-500",
                    ]}
                  >
                    {item.path}
                  </a>
                );
              })
            }
          </nav>

          <MobileHeaderMenu currentPath={currentPath} client:load />
        </div>
      </header>

      <main id="main-content" transition:name="page-content" transition:animate={pageTransition}>
        <slot />
      </main>

      <TrackCar
        mode={meta.type === "article" ? "progress" : "cruise"}
        label={status ?? defaultStatus}
      />
    </div>

    <script>
      document.addEventListener("astro:before-preparation", (event) => {
        const isReturningToPostList =
          event.from.pathname.startsWith("/posts/") && event.to.pathname === "/";
        if (isReturningToPostList) {
          event.direction = "back";
        }
      });

      const isTypingTarget = (target: EventTarget | null) =>
        target instanceof HTMLElement &&
        (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);

      const toggleTheme = () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const apply = () => {
          root.dataset.theme = next;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", next === "dark" ? "#131418" : "#fafaf7");
        };

        const canWipe =
          typeof document.startViewTransition === "function" &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!canWipe) {
          apply();
          return;
        }

        root.classList.add("theme-wipe");
        document.startViewTransition(apply).finished.finally(() => {
          root.classList.remove("theme-wipe");
        });
      };

      window.addEventListener("site:toggle-theme", toggleTheme);
      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "j" && !isTypingTarget(event.target)) {
          event.preventDefault();
          toggleTheme();
        }
      });
    </script>
    <script is:inline define:vars={{ analyticsHost }}>
      if (location.hostname === analyticsHost) {
        const loadAnalytics = () => {
          const umami = document.createElement("script");
          umami.src = "https://cloud.umami.is/script.js";
          umami.defer = true;
          umami.dataset.websiteId = "8c39c77b-edab-4799-b07e-6638092c01e1";
          document.head.append(umami);

          const cloudflare = document.createElement("script");
          cloudflare.src = "https://static.cloudflareinsights.com/beacon.min.js";
          cloudflare.defer = true;
          cloudflare.dataset.cfBeacon =
            '{"token":"1c3ce5d60e4e4d4a87e9063032aa37af"}';
          document.head.append(cloudflare);
        };

        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadAnalytics);
        } else {
          setTimeout(loadAnalytics, 0);
        }
      }
    </script>
  </body>
</html>
