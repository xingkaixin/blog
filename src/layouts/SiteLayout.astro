---
import jetBrainsMono400Url from "@fontsource/jetbrains-mono/latin-400.css?url";
import outfit400Url from "@fontsource/outfit/latin-400.css?url";
import outfit500Url from "@fontsource/outfit/latin-500.css?url";
import smileyFontUrl from "cn-fontsource-smiley-sans-oblique-regular/font.css?url";
import { ClientRouter } from "astro:transitions";
import SceneFooter from "@/components/astro/SceneFooter.astro";
import ReadingProgress from "@/components/astro/ReadingProgress.astro";
import SearchLauncher from "@/components/astro/SearchLauncher.astro";
import { MobileHeaderMenu } from "@/components/mobile-header-menu";
import {
  buildJsonLd,
  OG_HEIGHT,
  OG_WIDTH,
  ogType,
  pageImage,
  pageTitle,
  serializeJsonLd,
  type PageMeta,
} from "@/lib/seo";
import {
  htmlLang,
  localeFromPath,
  localizedHref,
  locales,
  ogLocale,
  translatedPath,
  type Locale,
} from "@/lib/i18n";
import { chromeMessages } from "@/lib/messages/chrome";
import { siteConfig, siteCopy } from "@/lib/site";
import {
  desktopNavigation,
  isSiteRouteActive,
  normalizeSitePath,
} from "@/lib/site-navigation";
import { THEME_TOGGLE_EVENT } from "@/lib/site-events";
import "../index.css";

type Props = {
  meta: PageMeta;
  noindex?: boolean;
  smartHeader?: boolean;
  footerStage?: boolean;
};

const { meta, noindex = false, smartHeader = meta.type === "article", footerStage = true } = Astro.props;
const currentPath = normalizeSitePath(Astro.url.pathname);
const locale = localeFromPath(Astro.url.pathname);
const copy = siteCopy[locale];
const t = chromeMessages[locale];
const alternates = locales.flatMap((target) => {
  const path = translatedPath(Astro.url.pathname, target);
  return path ? [{ locale: target, href: `${siteConfig.url}${path}` }] : [];
});
const englishAlternate = alternates.find((alternate) => alternate.locale === "en");
const switchLocale: Locale = locale === "zh" ? "en" : "zh";
const switchPath = translatedPath(Astro.url.pathname, switchLocale);
const image = pageImage(meta, locale);
const title = pageTitle(meta, locale);
const themeToggleEvent = THEME_TOGGLE_EVENT;
const fontUrls = [outfit400Url, outfit500Url, jetBrainsMono400Url];
const navItems = desktopNavigation(locale);
const pageTransition = {
  forwards: {
    old: {
      name: "page-slide-out-left",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "page-slide-in-right",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "page-slide-out-right",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "page-slide-in-left",
      duration: "250ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
};
---

<!doctype html>
<html lang={htmlLang[locale]} transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={meta.url} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={htmlLang[alternate.locale]} href={alternate.href} />
    ))}
    {englishAlternate && <link rel="alternate" hreflang="x-default" href={englishAlternate.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${copy.title} RSS`}
      href={`${siteConfig.url}/feed.xml`}
    />
    <meta name="theme-color" content="#f8faf9" />
    <script is:inline define:vars={{ themeToggleEvent }}>
      (function () {
        var storageKey = "site-theme";
        var colorScheme = matchMedia("(prefers-color-scheme: dark)");
        var themeColors = { light: "#f8faf9", dark: "#131715" };

        function readStoredTheme() {
          try {
            var storedTheme = localStorage.getItem(storageKey);
            return storedTheme === "light" || storedTheme === "dark" ? storedTheme : null;
          } catch {
            return null;
          }
        }

        function writeStoredTheme(theme) {
          try {
            localStorage.setItem(storageKey, theme);
          } catch {}
        }

        function preferredTheme() {
          return readStoredTheme() || (colorScheme.matches ? "dark" : "light");
        }

        function applyTheme(theme) {
          document.documentElement.dataset.theme = theme;
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) {
            themeColor.setAttribute("content", themeColors[theme]);
          }
        }

        function applyPreferredTheme() {
          applyTheme(preferredTheme());
        }

        function toggleTheme() {
          var nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          var apply = function () {
            writeStoredTheme(nextTheme);
            applyTheme(nextTheme);
          };
          var canWipe =
            typeof document.startViewTransition === "function" &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!canWipe) {
            apply();
            return;
          }

          document.documentElement.classList.add("theme-wipe");
          document.startViewTransition(apply).finished.finally(function () {
            document.documentElement.classList.remove("theme-wipe");
          });
        }

        applyPreferredTheme();
        colorScheme.addEventListener("change", applyPreferredTheme);
        document.addEventListener("astro:after-swap", applyPreferredTheme);
        window.addEventListener(themeToggleEvent, toggleTheme);
      })();
    </script>
    <meta property="og:type" content={ogType(meta)} />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates
      .filter((alternate) => alternate.locale !== locale)
      .map((alternate) => <meta property="og:locale:alternate" content={ogLocale[alternate.locale]} />)}
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={meta.title} />
    {
      meta.type === "article" && meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    {
      meta.type === "article" &&
        meta.tags?.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    {fontUrls.map((href) => <link rel="stylesheet" href={href} />)}
    <!-- 先用回退字体显示文字，中文字体 CSS 下载完成后再参与屏幕渲染。 -->
    <link
      rel="stylesheet"
      href={smileyFontUrl}
      media="print"
      onload="this.media='all'"
      transition:persist="smiley-font"
    />
    <noscript><link rel="stylesheet" href={smileyFontUrl} /></noscript>
    <ClientRouter />
    <script type="application/ld+json" set:html={serializeJsonLd(buildJsonLd(meta, locale))}></script>
  </head>
  <body>
    <div class="relative flex min-h-[100dvh] flex-col">
      {meta.type === "article" && <ReadingProgress />}
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[6px] focus:bg-ink-800 focus:px-4 focus:py-2 focus:text-paper"
      >
        {t.skipToContent}
      </a>

      <header
        class="sticky top-0 z-20 border-b border-line bg-surface"
        data-site-header
        data-smart-header={smartHeader ? "" : undefined}
      >
        <div class="mx-auto flex h-[60px] max-w-320 items-center gap-3 px-3 sm:gap-4 sm:px-6 lg:px-8">
          <a href={localizedHref("/", locale)} class="flex shrink-0 items-center gap-2.5" aria-label={t.backHome}>
            <img
              src="/logo.svg"
              alt=""
              width="28"
              height="28"
              class="site-logo h-7 w-7 object-contain"
            />
            <span class="hidden font-mono text-xs tracking-[0.05em] text-ink-800 sm:inline">
              xingkaixin.me
            </span>
          </a>

          {currentPath !== "/" && currentPath !== "/en" && (
            <span class="hidden max-w-52 shrink-0 truncate font-mono text-xs text-ink-400 xl:inline">
              {decodeURI(currentPath)}
            </span>
          )}

          <SearchLauncher />

          <nav aria-label={t.mainNav} class="hidden shrink-0 items-center gap-0.5 lg:flex">
            {
              navItems.map((item) => {
                const active = isSiteRouteActive(currentPath, normalizeSitePath(item.href));
                return (
                  <a
                    href={item.href}
                    data-astro-reload={item.reload ? "" : undefined}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "rounded-[6px] px-2.5 py-1.5 font-mono text-xs transition-colors duration-(--duration-quick) hover:bg-ink-50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40",
                      active ? "bg-ink-50 text-ink-800" : "text-ink-500",
                    ]}
                  >
                    {item.path}
                    {item.chineseOnly && <span class="ml-1 text-[10px] text-ink-400">{t.chineseOnly}</span>}
                  </a>
                );
              })
            }
          </nav>

          {switchPath && (
            <a
              href={switchPath}
              hreflang={htmlLang[switchLocale]}
              lang={htmlLang[switchLocale]}
              aria-label={t.switchLanguage.aria}
              data-language-switch={switchLocale}
              data-astro-reload
              class="inline-flex h-[34px] shrink-0 items-center rounded-[8px] border border-line bg-surface px-2.5 font-mono text-xs text-ink-600 transition-colors duration-(--duration-quick) hover:bg-ink-50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
            >
              {t.switchLanguage.label}
            </a>
          )}

          <MobileHeaderMenu currentPath={currentPath} locale={locale} client:media="(max-width: 1023px)" />
        </div>
      </header>

      <main id="main-content" class="flex-1" tabindex="-1" transition:name="page-content" transition:animate={pageTransition}>
        <slot />
      </main>

      <SceneFooter currentPath={currentPath} stage={footerStage} />
    </div>

    <script>
      import { LOCALE_COOKIE } from "@/lib/i18n";
      import { attachSmartHeader, type SmartHeaderController } from "@/lib/smart-header";
      import { installSiteShortcuts } from "@/lib/site-shortcuts";
      import { skipToContent } from "@/lib/skip-to-content";
      import { registerBlogWebMcpTools } from "@/lib/webmcp";

      document.addEventListener("click", skipToContent, true);
      document.addEventListener("click", (event) => {
        const link =
          event.target instanceof Element
            ? event.target.closest<HTMLElement>("[data-language-switch]")
            : null;
        if (link) {
          document.cookie = `${LOCALE_COOKIE}=${link.dataset.languageSwitch}; path=/; max-age=31536000; samesite=lax`;
        }
      });

      registerBlogWebMcpTools(document).catch((error) => {
        console.error("Failed to register WebMCP tools", error);
      });

      document.addEventListener("astro:before-preparation", (event) => {
        const isReturningToPostList =
          event.from.pathname.startsWith("/posts/") &&
          event.from.pathname !== "/posts/" &&
          event.to.pathname === "/posts/";
        if (isReturningToPostList) {
          event.direction = "back";
        }
      });

      installSiteShortcuts(window);

      let headerController: SmartHeaderController | null = null;

      function setupSmartHeader() {
        headerController?.destroy();
        headerController = null;

        const header = document.querySelector<HTMLElement>("header[data-smart-header]");
        if (!header) {
          return;
        }

        const thresholdTarget = document.querySelector<HTMLElement>("[data-post-header]");
        headerController = attachSmartHeader({
          header,
          thresholdTarget,
          isLocked: () => Boolean(header.querySelector('button[aria-expanded="true"]')),
        });
      }

      document.addEventListener("astro:page-load", setupSmartHeader);
      document.addEventListener("astro:before-swap", () => {
        headerController?.destroy();
        headerController = null;
      });
    </script>
    <script>
      import { installAnalytics } from "@/lib/analytics";

      installAnalytics();
    </script>
  </body>
</html>
