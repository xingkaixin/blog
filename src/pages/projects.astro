---
import { ProjectConsole } from "@/components/project-console";
import PageArtwork from "@/components/astro/PageArtwork.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { projects } from "@/lib/projects";
import { siteConfig } from "@/lib/site";

const meta = {
  title: "工具箱",
  description: "Kevin 发布和维护的 AI、CLI、数据库与开发者工具。",
  url: `${siteConfig.url}/projects/`,
  type: "webpage" as const,
};
---

<SiteLayout meta={meta} status={`PROJECTS · ${projects.length} items`}>
  <div class="relative isolate overflow-hidden">
    <PageArtwork scene="building" />
    <ProjectConsole projects={projects} client:load />
  </div>
</SiteLayout>
