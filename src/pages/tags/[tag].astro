---
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import PostCover from "@/components/astro/PostCover.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublishedPosts, toPostListItem } from "@/lib/astro-posts";
import { buildPostTaxonomy, type TagArchive } from "@/lib/post-tags";
import { postHref } from "@/lib/published-post";
import { siteConfig } from "@/lib/site";

type Props = {
  archive: TagArchive;
};

export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).map(toPostListItem);
  return buildPostTaxonomy(posts).archives.map((archive) => ({
    params: { tag: archive.tag },
    props: { archive },
  }));
}

const { archive } = Astro.props as Props;
const { tag, posts } = archive;
const url = `${siteConfig.url}${archive.href}`;
const meta = {
  title: `#${tag}`,
  description: `浏览 ${siteConfig.title} 中标记为“${tag}”的 ${posts.length} 篇文章。`,
  url,
  type: "webpage" as const,
  breadcrumb: [
    { name: "首页", url: `${siteConfig.url}/` },
    { name: "标签", url: `${siteConfig.url}/tags/` },
    { name: `#${tag}`, url },
  ],
};
---

<SiteLayout meta={meta} status={`TAG · ${tag} · ${posts.length}`}>
  <section class="mx-auto max-w-320 px-3 pb-20 pt-7 sm:px-5 lg:px-8 lg:pt-9">
    <header class="border-b border-line pb-5">
      <Breadcrumb
        items={[
          { name: "首页", url: "/" },
          { name: "标签", url: "/tags/" },
          { name: `#${tag}` },
        ]}
      />
      <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">Tag archive</p>
          <h1 class="mt-2 font-display text-4xl leading-none text-ink-800 sm:text-5xl">#{tag}</h1>
        </div>
        <p class="font-mono text-[10px] text-ink-400">{posts.length} 篇 · 按时间倒序</p>
      </div>
    </header>

    <div aria-label={`标记为${tag}的文章`}>
      {
        posts.map((post) => (
          <a
            href={postHref(post.slug)}
            class="group -mx-1 block border-b border-ink-100 px-3 py-3.5 transition-[background-color,box-shadow] hover:bg-surface hover:shadow-[inset_3px_0_0_var(--accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/40 lg:flex lg:items-center lg:gap-5 lg:px-4 lg:py-3"
          >
            <span class="font-mono text-[10px] text-ink-400 lg:w-[76px] lg:shrink-0">
              {post.date}
            </span>
            <span class="mt-1 block min-w-0 flex-1 lg:mt-0">
              <h2 class="text-[15px] leading-6 text-ink-800 transition-colors group-hover:text-accent">
                {post.title}
              </h2>
              <span class="mt-0.5 line-clamp-2 text-[12px] leading-5 text-ink-500 lg:line-clamp-1">
                {post.summary}
              </span>
            </span>
            <span
              class="hover-preview-reveal hidden w-24 shrink-0 overflow-hidden rounded-[6px] border border-line lg:block"
              transition:name={`cover-${post.slug}`}
            >
              <PostCover src={post.cover} alt="" imageClass="aspect-video object-cover" />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
