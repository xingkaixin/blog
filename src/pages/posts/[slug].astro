---
import { render } from "astro:content";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import PostCover from "@/components/astro/PostCover.astro";
import PostTag from "@/components/astro/PostTag.astro";
import TocNav from "@/components/astro/TocNav.astro";
import { SignatureAnimation } from "@/components/signature-animation";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  getPublishedPosts,
  toPostDetail,
  toPostListItem,
  type BlogPostEntry,
} from "@/lib/astro-posts";
import { formatCalendarDate } from "@/lib/calendar-date";
import { estimateReadingMetrics } from "@/lib/reading-metrics";
import { buildPostTaxonomy } from "@/lib/post-tags";
import { postHref } from "@/lib/published-post";
import { siteConfig } from "@/lib/site";

type Props = {
  post: BlogPostEntry;
  archivedTags: string[];
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const archivedTags = buildPostTaxonomy(posts.map(toPostListItem)).archives.map(({ tag }) => tag);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, archivedTags },
  }));
}

const { post, archivedTags } = Astro.props as Props;
const archivedTagSet = new Set(archivedTags);
const readingMetrics = estimateReadingMetrics(post.body);
const { Content, headings } = await render(post);
const postMeta = toPostDetail(post, headings);
const canonicalPostUrl = `${siteConfig.url}${postHref(postMeta.slug)}`;
const meta = {
  title: postMeta.title,
  description: postMeta.summary,
  url: canonicalPostUrl,
  image: `${siteConfig.url}/og/${postMeta.slug}.png`,
  type: "article" as const,
  publishedTime: postMeta.date,
  tags: postMeta.tags,
  breadcrumb: [
    { name: "首页", url: `${siteConfig.url}/` },
    { name: postMeta.title, url: canonicalPostUrl },
  ],
};
---

<SiteLayout meta={meta} status={`READING · ${readingMetrics.readingMinutes} min`}>
  <section class="mx-auto max-w-320 px-3 pb-20 pt-7 sm:px-5 lg:px-8 lg:pt-9">
    <div
      class:list={[
        "grid min-w-0 gap-x-8 gap-y-6 lg:items-start",
        postMeta.toc.length && "lg:grid-cols-[minmax(0,860px)_260px] lg:justify-center",
        !postMeta.toc.length && "mx-auto max-w-[860px]",
      ]}
    >
      <header
        class="order-1 min-w-0 border-b border-line pb-5 lg:col-start-1 lg:row-start-1"
        data-post-header
      >
        <Breadcrumb items={[{ name: "首页", url: "/" }, { name: postMeta.title }]} />
        <h1 class="mt-4 max-w-[30ch] text-balance font-display text-4xl leading-[1.15] text-ink-800 [overflow-wrap:anywhere] sm:text-5xl">
          {postMeta.title}
        </h1>
        <p class="mt-4 max-w-[70ch] text-[15px] leading-7 text-ink-500">{postMeta.summary}</p>
        <div class="mt-5 flex flex-col gap-3 border-t border-line pt-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-x-2 font-mono text-[10px] text-ink-400">
            <span>{formatCalendarDate(postMeta.date)}</span>
            <span class="text-ink-200">·</span>
            <span>{readingMetrics.wordCount.toLocaleString("zh-CN")} 字</span>
            <span class="text-ink-200">·</span>
            <span>{readingMetrics.readingMinutes} 分钟</span>
          </div>
          <div class="flex flex-wrap gap-1.5 sm:justify-end">
            {
              postMeta.tags.map((tag) => (
                <PostTag tag={tag} linked={archivedTagSet.has(tag)} />
              ))
            }
          </div>
        </div>
      </header>

      <article class="order-3 min-w-0 space-y-8 lg:col-start-1 lg:row-start-2">
        <figure
          class="w-full max-w-full overflow-hidden rounded-[10px] border border-line"
          transition:name={`cover-${postMeta.slug}`}
        >
          <PostCover cover={postMeta.cover} alt={postMeta.coverAlt} priority />
        </figure>

        <div class="border-y border-line py-8 sm:px-2">
          <div class="article-prose">
            <Content />
          </div>
        </div>

        <div class="relative rounded-[10px] border border-line bg-surface/60 px-5 py-7 sm:px-8">
              <svg
                aria-hidden="true"
                class="absolute right-5 top-5 h-7 w-7 text-ink-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <text
                  x="12"
                  y="16"
                  text-anchor="middle"
                  fill="currentColor"
                  stroke="none"
                  font-size="13"
                  font-weight="500"
                  font-family="system-ui, sans-serif"
                >
                  C
                </text>
              </svg>
              <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-500">
                版权声明
              </h2>
              <dl class="mt-5 grid gap-2.5 text-[13px] text-ink-600">
                <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[10px] text-ink-400">作者</dt>
                  <dd>{siteConfig.author}</dd>
                </div>
                <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[10px] text-ink-400">标题</dt>
                  <dd>{postMeta.title}</dd>
                </div>
                <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[10px] text-ink-400">发布时间</dt>
                  <dd>{formatCalendarDate(postMeta.date)}</dd>
                </div>
                <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[10px] text-ink-400">文章链接</dt>
                  <dd class="min-w-0">
                    <a
                      href={canonicalPostUrl}
                      class="block truncate text-ink-800 underline decoration-line underline-offset-3 hover:text-accent"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {canonicalPostUrl}
                    </a>
                  </dd>
                </div>
              </dl>
              <p class="mt-6 text-[13px] text-ink-500">
                本作品采用
                <a
                  href="https://creativecommons.org/licenses/by-nc-nd/4.0/deed.zh-hans"
                  class="text-ink-800 underline decoration-line underline-offset-3 hover:text-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  CC BY-NC-ND 4.0 DEED
                </a>
                许可。
              </p>
              <SignatureAnimation client:visible />
        </div>
      </article>

      {
        postMeta.toc.length > 0 && (
          <aside class="order-2 lg:sticky lg:top-20 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:z-10 lg:self-start">
            <TocNav items={postMeta.toc} />
          </aside>
        )
      }
    </div>
  </section>
</SiteLayout>
