---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ContactCard from "@/components/astro/ContactCard.astro";
import KoiPond from "@/components/astro/KoiPond.astro";
import { siteConfig, siteContacts } from "@/lib/site";

const meta = {
  title: "关于",
  description: "XingKaiXin，坐标上海的工程师与摄影爱好者。这是他的个人博客——行开心的颠倒世界。",
  url: `${siteConfig.url}/about/`,
  type: "webpage" as const,
  breadcrumb: [
    { name: "首页", url: `${siteConfig.url}/` },
    { name: "关于", url: `${siteConfig.url}/about/` },
  ],
};

const contacts = Object.values(siteContacts);
---

<SiteLayout meta={meta} status="ABOUT · SHANGHAI">
  <section class="mx-auto grid min-h-[calc(100dvh-90px)] max-w-320 px-3 pb-14 sm:px-5 lg:grid-cols-[190px_minmax(0,1fr)] lg:px-0 xl:grid-cols-[210px_minmax(0,1fr)_280px]">
    <nav aria-label="关于页大纲" class="border-b border-line py-4 lg:border-b-0 lg:border-r lg:px-5 lg:py-8">
      <p class="hidden font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400 lg:block">
        大纲
      </p>
      <div class="flex gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:mt-3 lg:block lg:space-y-1">
        <a href="#intro" class="outline-link">简介</a>
        <a href="#pond" class="outline-link">池塘</a>
        <a href="#contact" class="outline-link">联系</a>
      </div>
    </nav>

    <article class="min-w-0 py-8 lg:px-8 lg:py-10 xl:px-10">
      <section id="intro" class="scroll-mt-20">
        <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
          <img
            src="/avatar.webp"
            alt="XingKaiXin 的手绘头像"
            width="96"
            height="96"
            class="avatar-sticker h-24 w-24 shrink-0 object-cover"
          />
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">About</p>
            <h1 class="mt-1.5 text-3xl font-medium tracking-[-0.04em] text-ink-800 sm:text-4xl">
              XingKaiXin
            </h1>
            <p class="mt-1.5 font-mono text-[11px] text-ink-400">上海 · 工程师 · 摄影爱好者</p>
          </div>
        </div>
        <p class="mt-7 text-[15px] leading-8 text-ink-700">{siteConfig.about}</p>
        <blockquote class="mt-5 border-l-3 border-accent py-1 pl-4 text-[14px] leading-7 text-ink-500">
          {siteConfig.motto}
        </blockquote>
      </section>

      <section id="pond" class="mt-12 scroll-mt-20">
        <KoiPond />
        <p class="mt-6 font-mono text-[10px] leading-5 text-ink-400">
          源码公开在 <a
            href="https://github.com/xingkaixin/blog"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-600 underline decoration-line underline-offset-3 hover:text-accent"
          >GitHub</a>，内容版权归作者所有。
        </p>
      </section>
    </article>

    <aside id="contact" class="scroll-mt-20 border-t border-line py-8 lg:col-start-2 lg:px-8 xl:col-start-3 xl:row-start-1 xl:border-l xl:border-t-0 xl:px-5 xl:py-10">
      <p class="section-kicker">联系</p>
      <p class="mt-2 text-[13px] leading-6 text-ink-500">聊 AI、工具、摄影，或者只是来打个招呼。</p>
      <div class="mt-4 border-t border-line">
        {contacts.map((contact) => <ContactCard contact={contact} />)}
      </div>
    </aside>
  </section>
</SiteLayout>

<style>
  .outline-link {
    display: block;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    transition:
      color var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  @media (min-width: 64rem) {
    .outline-link {
      border-color: transparent;
      padding: 0.4rem 0.5rem;
      font-family: var(--font-sans);
      font-size: 0.8125rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .outline-link:hover {
      color: var(--ink-800);
      background: var(--ink-50);
    }
  }

  .avatar-sticker {
    border-radius: 1.25rem;
    border: 3px solid #fff;
    box-shadow:
      0 0 0 1px var(--line),
      0 6px 16px -6px rgba(20, 21, 26, 0.28);
    transform: rotate(-3deg);
    transition: transform var(--duration-quick) var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .avatar-sticker:hover {
      transform: rotate(0deg) scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-sticker,
    .avatar-sticker:hover {
      transform: rotate(-3deg);
      transition: none;
    }
  }
</style>
