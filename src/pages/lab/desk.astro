---
import { getImage } from "astro:assets";
import chiangMai from "@/assets/photo-backgrounds/chiang-mai.webp";
import chongqing from "@/assets/photo-backgrounds/chongqing.webp";
import hongKong from "@/assets/photo-backgrounds/hong-kong.webp";
import kyoto from "@/assets/photo-backgrounds/kyoto.webp";
import { GravityDesk } from "@/components/gravity-desk";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { siteConfig } from "@/lib/site";

const photoCards = await Promise.all(
  [
    { id: "kyoto", label: "KYOTO", image: kyoto },
    { id: "chongqing", label: "CHONGQING", image: chongqing },
    { id: "hong-kong", label: "HONG KONG", image: hongKong },
    { id: "chiang-mai", label: "CHIANG MAI", image: chiangMai },
  ].map(async ({ id, label, image }) => {
    const rendered = await getImage({ src: image, width: 320, format: "webp" });
    return { id, label, src: rendered.src, href: `/photos/#album=${id}` };
  }),
);

const meta = {
  title: "颠倒引力桌",
  description:
    "由 Matter.js 驱动的互动物理桌面，集齐自制工具贴纸、旅行拍立得与红印。按 ⌘J 切换暗色模式时重力反转。",
  url: `${siteConfig.url}/lab/desk/`,
  type: "webpage" as const,
};
---

<SiteLayout meta={meta} footerStage={false}>
  <GravityDesk photoCards={photoCards} client:load />
</SiteLayout>
