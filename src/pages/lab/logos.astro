---
import { HolidayLogoGallery } from "@/components/holiday-logo-gallery";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { holidayDateAt } from "@/lib/holiday-logo-calendar";
// 保留构建期校验，避免错误日期进入发布产物。
import "@/lib/holiday-logo-config";
import { siteConfig } from "@/lib/site";

const meta = {
  title: "节日 Logo 工坊",
  description: "把玩网站的节日 Logo：按压徽章、翻转昼夜、拆解图层，转动时光罗盘浏览一年里的节日与生日。",
  url: `${siteConfig.url}/lab/logos/`,
  type: "webpage" as const,
};
---

<SiteLayout meta={meta} footerStage={false}>
  <HolidayLogoGallery initialToday={holidayDateAt()} client:load />
</SiteLayout>
