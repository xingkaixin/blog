---
import { render } from "astro:content";
import AgentView from "@/components/astro/AgentView.astro";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import PostCover from "@/components/astro/PostCover.astro";
import PostEnhancements from "@/components/astro/PostEnhancements.astro";
import PostTag from "@/components/astro/PostTag.astro";
import QuoteToolbar from "@/components/astro/QuoteToolbar.astro";
import SignatureAnimation from "@/components/astro/SignatureAnimation.astro";
import TocNav from "@/components/astro/TocNav.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  getLocalizedPublishedPosts,
  toLocalizedPostDetail,
  type LocalizedBlogPostEntry,
} from "@/lib/astro-posts";
import { formatCalendarDate } from "@/lib/calendar-date";
import { buildCoverSrcSet, POST_COVER_SIZES, resolveCover } from "@/lib/covers";
import { htmlLang, locales, localizedHref, type Locale } from "@/lib/i18n";
import { postsMessages } from "@/lib/messages/posts";
import { buildPostTaxonomy, relatedPosts } from "@/lib/post-tags";
import { postHref, type PublishedPost } from "@/lib/published-post";
import { estimateReadingMetrics } from "@/lib/reading-metrics";
import { siteConfig } from "@/lib/site";
import "@/styles/article.css";

type Props = {
  entry: LocalizedBlogPostEntry;
  locale: Locale;
  archivedTags: string[];
  related: PublishedPost[];
};

export async function getStaticPaths() {
  const byLocale = await Promise.all(
    locales.map(async (locale) => ({
      locale,
      entries: await getLocalizedPublishedPosts(locale),
    })),
  );

  return byLocale.flatMap(({ locale, entries }) => {
    const items = entries.map((entry) => entry.post);
    const archivedTags = buildPostTaxonomy(items).archives.map(({ tag }) => tag);
    return entries.map((entry) => ({
      params: { lang: locale === "en" ? "en" : undefined, slug: entry.slug },
      props: {
        entry,
        locale,
        archivedTags,
        related: relatedPosts(items, entry.post, 3),
      },
    }));
  });
}

const { entry, locale, archivedTags, related } = Astro.props as Props;
const t = postsMessages[locale].detail;
const archivedTagSet = new Set(archivedTags);
const readingMetrics = estimateReadingMetrics(entry.body);
const { Content, headings } = await render(entry.contentEntry);
const postMeta = toLocalizedPostDetail(entry, headings);
const currentPostHref = postHref(postMeta.slug, locale);
const canonicalPostUrl = `${siteConfig.url}${currentPostHref}`;
const alternateLocale: Locale = locale === "en" ? "zh" : "en";
const alternatePostHref = postHref(postMeta.slug, alternateLocale);
const homeHref = localizedHref("/", locale);
const postsListHref = localizedHref("/posts/", locale);
const cover = resolveCover(postMeta.cover);
const coverAvifSrcSet = buildCoverSrcSet(cover, {
  mobile: cover.mobileAvif,
  desktop: cover.desktopAvif,
  full: cover.fullAvif,
});
const cssString = (value: string) => JSON.stringify(value).replaceAll("<", "\\3c ");
const printPageStyle = `@page {
  @top-left { content: ${cssString(canonicalPostUrl.replace(/^https:\/\//, ""))}; }
  @top-right { content: ${cssString(postMeta.date)}; }
  @bottom-left { content: ${cssString(postMeta.title)}; }
}`;
const meta = {
  title: postMeta.title,
  description: postMeta.summary,
  url: canonicalPostUrl,
  image: `${siteConfig.url}/og/${postMeta.slug}.png`,
  type: "article" as const,
  publishedTime: postMeta.date,
  ...(postMeta.updated ? { modifiedTime: postMeta.updated } : {}),
  tags: postMeta.tags,
  breadcrumb: [
    { name: t.home, url: `${siteConfig.url}${homeHref}` },
    { name: t.posts, url: `${siteConfig.url}${postsListHref}` },
    { name: postMeta.title, url: canonicalPostUrl },
  ],
};
---

<SiteLayout
  meta={meta}
  compactHeader={{
    title: postMeta.title,
    backHref: postsListHref,
    backLabel: t.posts,
    hasToc: postMeta.toc.length > 0,
  }}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={coverAvifSrcSet}
    imagesizes={POST_COVER_SIZES}
    fetchpriority="high"
  />
  <style is:inline set:html={printPageStyle}></style>
  <section class="mx-auto max-w-320 px-3 pb-20 pt-7 sm:px-5 lg:px-8 lg:pt-9">
    <div
      data-post-grid
      class="grid min-w-0 gap-x-8 gap-y-6 lg:items-start lg:justify-center"
    >
      <header
        class="order-1 min-w-0 border-b border-line pb-5 lg:col-start-1 lg:row-start-1"
        data-post-header
      >
        <Breadcrumb
          ariaLabel={t.breadcrumbAria}
          items={[{ name: t.home, url: homeHref }, { name: t.posts, url: postsListHref }, { name: postMeta.title }]}
        />
        <h1
          data-post-title
          class="mt-4 max-w-[30ch] text-balance font-display text-4xl leading-[1.15] text-ink-800 [overflow-wrap:anywhere] sm:text-5xl"
        >
          {postMeta.title}
        </h1>
        <p data-post-summary class="mt-4 max-w-[70ch] text-pretty text-[15px] leading-7 text-ink-500">{postMeta.summary}</p>
        <div class="mt-5 flex flex-col gap-3 border-t border-line pt-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-x-2 font-mono text-[11px] text-ink-500">
            <span>{formatCalendarDate(postMeta.date)}</span>
            <span class="text-ink-200">·</span>
            <span data-post-word-count data-word-count={String(readingMetrics.wordCount)}>
              {t.wordCount(readingMetrics.wordCount)}
            </span>
            <span class="text-ink-200">·</span>
            <span data-post-reading-minutes data-reading-minutes={String(readingMetrics.readingMinutes)}>
              {t.readingMinutes(readingMetrics.readingMinutes)}
            </span>
            <span class="text-ink-200 print:hidden" aria-hidden="true">·</span>
            <AgentView path={currentPostHref} locale={locale} />
            <span class="text-ink-200 print:hidden" aria-hidden="true">·</span>
            {
              locale === "en" ? (
                <a
                  href={alternatePostHref}
                  hreflang={htmlLang.zh}
                  lang={htmlLang.zh}
                  data-original-toggle-link
                  aria-pressed="false"
                  class="print:hidden text-ink-500 underline decoration-line underline-offset-3 transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
                >
                  {t.switchToChineseOriginal}
                </a>
              ) : (
                <a
                  href={alternatePostHref}
                  hreflang={htmlLang[alternateLocale]}
                  lang={htmlLang[alternateLocale]}
                  data-language-switch={alternateLocale}
                  data-astro-reload
                  class="print:hidden text-ink-500 underline decoration-line underline-offset-3 transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
                >
                  {t.switchToEnglishAi}
                </a>
              )
            }
          </div>
          <div class="flex flex-wrap gap-1.5 sm:justify-end">
            {
              postMeta.tags.map((tag) => (
                <PostTag tag={tag} linked={archivedTagSet.has(tag)} />
              ))
            }
          </div>
        </div>
      </header>

      <article class="order-3 min-w-0 space-y-8 lg:col-start-1 lg:row-start-2">
        <figure
          class="w-full max-w-full overflow-hidden rounded-[10px] border border-line print:hidden"
          data-post-cover
        >
          <PostCover cover={postMeta.cover} alt={postMeta.coverAlt} priority />
        </figure>

        {
          locale === "en" && (
            <aside
              data-ai-translation-notice
              data-post-original-switch
              data-original-href={alternatePostHref}
              data-current-href={currentPostHref}
              data-ui-locale={locale}
              data-content-lang="en"
              class="translation-notice print:hidden flex flex-col gap-3 rounded-[10px] border border-line bg-surface/75 px-4 py-3 text-[13px] leading-6 text-ink-600 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
            >
              <div class="flex min-w-0 flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <span
                  data-translation-badge
                  class="translation-notice-badge rounded-[4px] border border-accent/30 bg-accent-soft px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] text-accent"
                >
                  {t.aiTranslationBadge}
                </span>
                <span data-translation-status aria-live="polite">{t.aiTranslationNotice}</span>
              </div>
              <div
                data-lang-segmented
                data-active="en"
                role="group"
                aria-label={t.contentLanguageAria}
                class="translation-segmented relative inline-grid shrink-0 grid-cols-2 items-center self-start rounded-[8px] border border-line bg-ink-50 p-[3px] sm:self-auto"
              >
                <span aria-hidden="true" class="translation-segmented-thumb" />
                <button
                  type="button"
                  data-content-lang-target="en"
                  aria-pressed="true"
                  class="translation-seg-btn"
                >
                  {t.switchToEnglishAi}
                </button>
                <button
                  type="button"
                  data-content-lang-target="zh"
                  aria-pressed="false"
                  lang={htmlLang.zh}
                  class="translation-seg-btn"
                >
                  中文原文
                </button>
              </div>
            </aside>
          )
        }

        <div class="border-y border-line py-8 sm:px-2 print:border-0 print:py-0">
          <div
            class="article-prose"
            data-quote-scope
            data-highlight-path={currentPostHref}
            lang={htmlLang[locale]}
          >
            <Content />
          </div>
          <QuoteToolbar title={postMeta.title} date={postMeta.date} url={canonicalPostUrl} locale={locale} />
          <PostEnhancements locale={locale} />
        </div>

        {
          related.length > 0 && (
            <nav aria-labelledby="related-posts-heading" class="print:hidden">
              <h2 id="related-posts-heading" class="font-display text-2xl text-ink-800">
                {t.relatedHeading}
              </h2>
              <ul class="mt-4 divide-y divide-line border-y border-line">
                {related.map((item) => (
                  <li>
                    <a
                      href={postHref(item.slug, locale)}
                      class="group block rounded-[6px] px-2 py-4 transition-colors hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
                    >
                      <span class="block text-balance text-[15px] leading-6 text-ink-800 group-hover:text-accent">
                        {item.title}
                      </span>
                      <span class="mt-1 text-[13px] leading-6 text-ink-500 line-clamp-2">
                        {item.summary}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="relative break-inside-avoid rounded-[10px] border border-line bg-surface/60 px-5 py-7 sm:px-8 print:border-0 print:bg-transparent print:px-0">
              <svg
                aria-hidden="true"
                class="absolute right-5 top-5 h-7 w-7 text-ink-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <text
                  x="12"
                  y="16"
                  text-anchor="middle"
                  fill="currentColor"
                  stroke="none"
                  font-size="13"
                  font-weight="500"
                  font-family="system-ui, sans-serif"
                >
                  C
                </text>
              </svg>
              <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-500">
                {t.copyrightHeading}
              </h2>
              <dl class="mt-5 grid gap-2.5 text-[13px] text-ink-600">
                <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[11px] text-ink-500">{t.copyrightAuthor}</dt>
                  <dd>{siteConfig.author}</dd>
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[11px] text-ink-500">{t.copyrightTitle}</dt>
                  <dd data-copyright-title>{postMeta.title}</dd>
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[11px] text-ink-500">{t.copyrightDate}</dt>
                  <dd>{formatCalendarDate(postMeta.date)}</dd>
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3">
                  <dt class="font-mono text-[11px] text-ink-500">{t.copyrightLink}</dt>
                  <dd class="min-w-0">
                    <a
                      href={canonicalPostUrl}
                      class="block truncate text-ink-800 underline decoration-line underline-offset-3 hover:text-accent"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {canonicalPostUrl}
                    </a>
                  </dd>
                </div>
              </dl>
              <p class="mt-6 text-[13px] text-ink-500">
                {t.licensePrefix}{" "}
                <a
                  href={t.licenseHref}
                  class="text-ink-800 underline decoration-line underline-offset-3 hover:text-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  CC BY-NC-ND 4.0 DEED
                </a>
                {locale === "en" ? t.licenseSuffix : ` ${t.licenseSuffix}`}
              </p>
              <SignatureAnimation />
        </div>
      </article>

      <aside data-post-toc hidden={!postMeta.toc.length} class="order-2 print:hidden lg:sticky lg:top-20 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:z-10 lg:self-start">
        <TocNav items={postMeta.toc} locale={locale} />
      </aside>
    </div>
  </section>
</SiteLayout>

<script>
  import { attachPostOriginalSwitch } from "@/lib/post-original-switch";

  let detachOriginalSwitch: (() => void) | undefined;

  function mountOriginalSwitch() {
    detachOriginalSwitch?.();
    detachOriginalSwitch = attachPostOriginalSwitch();
  }

  document.addEventListener("astro:before-swap", () => {
    detachOriginalSwitch?.();
    detachOriginalSwitch = undefined;
  });
  document.addEventListener("astro:page-load", mountOriginalSwitch);
  mountOriginalSwitch();
</script>

<style>
  [data-post-grid]:has(> aside[hidden]) {
    margin-inline: auto;
    max-width: 860px;
  }

  @media (min-width: 64rem) {
    :where([data-post-grid]:has(> aside:not([hidden]))) {
      grid-template-columns: minmax(0, 860px) 260px;
    }
  }

  .translation-notice {
    transition:
      border-color 220ms var(--ease-smooth-out),
      background-color 220ms var(--ease-smooth-out);
  }

  .translation-notice[data-content-lang="zh"] {
    border-color: color-mix(in srgb, var(--accent) 32%, var(--line));
    background: color-mix(in srgb, var(--accent-soft) 28%, var(--surface));
  }

  .translation-notice-badge {
    transition:
      background-color 200ms var(--ease-smooth-out),
      border-color 200ms var(--ease-smooth-out),
      color 200ms var(--ease-smooth-out);
  }

  .translation-notice[data-content-lang="zh"] .translation-notice-badge {
    border-color: var(--ink-800);
    background: var(--ink-800);
    color: var(--bg);
  }

  .translation-segmented-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(20, 21, 26, 0.08);
    transform: translateX(0%);
    transition: transform 220ms var(--ease-smooth-out);
    pointer-events: none;
  }

  .translation-segmented[data-active="zh"] .translation-segmented-thumb {
    transform: translateX(100%);
  }

  .translation-seg-btn {
    position: relative;
    z-index: 1;
    padding: 5px 11px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--duration-quick) var(--ease-smooth-out),
      transform 130ms var(--ease-smooth-out);
  }

  .translation-seg-btn:active {
    transform: scale(0.97);
  }

  .translation-seg-btn[aria-pressed="true"] {
    color: var(--ink-800);
  }

  .translation-seg-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .translation-seg-btn:hover:not([aria-pressed="true"]) {
      color: var(--ink-800);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .translation-notice,
    .translation-notice-badge,
    .translation-segmented-thumb,
    .translation-seg-btn {
      transition: none;
    }

    .translation-seg-btn:active {
      transform: none;
    }
  }
</style>
