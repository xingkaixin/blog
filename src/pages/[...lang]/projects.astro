---
import ProjectConsole from "@/components/astro/ProjectConsole.astro";
import PageArtwork from "@/components/astro/PageArtwork.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { bilingualStaticPaths, localeFromPath, localizedHref } from "@/lib/i18n";
import { projectMessages } from "@/lib/messages/projects";
import { localizedProjects, projects } from "@/lib/projects";
import { siteConfig, siteCopy } from "@/lib/site";

export const getStaticPaths = bilingualStaticPaths;

const locale = localeFromPath(Astro.url.pathname);
const t = projectMessages[locale];
const pageUrl = `${siteConfig.url}${localizedHref("/projects/", locale)}`;
const meta = {
  title: t.title,
  description: t.description,
  url: pageUrl,
  type: "webpage" as const,
  projects: localizedProjects(locale),
  breadcrumb: [
    { name: siteCopy[locale].title, url: `${siteConfig.url}${localizedHref("/", locale)}` },
    { name: t.title, url: pageUrl },
  ],
};
---

<SiteLayout meta={meta}>
  <div class="relative isolate overflow-hidden">
    <PageArtwork scene="building" />
    <ProjectConsole projects={projects} locale={locale} />
  </div>
</SiteLayout>
