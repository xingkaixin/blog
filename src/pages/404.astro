---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublishedPosts } from "@/lib/astro-posts";
import { postHref } from "@/lib/published-post";
import { shuffleablePosts } from "@/lib/record-shuffle";
import { siteConfig } from "@/lib/site";

const meta = {
  title: "页面未找到",
  description: "这篇内容可能已经删除、移动，或者链接已经过期。",
  url: `${siteConfig.url}/404`,
  type: "webpage" as const,
};
const oldPostHrefs = shuffleablePosts(await getPublishedPosts()).map((post) => postHref(post.id));
---

<SiteLayout meta={meta} noindex footerStage={false}>
  <!-- 在首帧绘制前翻转，避免先闪一下正向页面 -->
  <script is:inline>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      var root = document.documentElement;
      root.dataset.upsideDown = root.dataset.theme || "light";
      root.dataset.theme = "dark";
    }
  </script>
  <button type="button" data-flip-back aria-label="把页面翻回来" class="flip-overlay">
    <span class="flip-hint">
      <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.7M20 4v4.7h-4.7M20 12a8 8 0 0 1-13.7 5.6L4 15.3M4 20v-4.7h4.7" />
      </svg>
      这一页掉进了颠倒世界 · 点一下翻回来
    </span>
  </button>
  <section class="mx-auto flex min-h-[calc(100dvh-90px)] max-w-320 items-center px-3 py-16 sm:px-5 lg:px-8">
    <div class="mx-auto w-full max-w-3xl border-y border-line py-8 sm:py-10">
      <div class="grid gap-5 sm:grid-cols-[130px_minmax(0,1fr)] sm:items-start sm:gap-8">
        <span aria-hidden="true" class="font-mono text-6xl leading-none text-ink-200 sm:text-7xl">
          404
        </span>
        <div>
          <h1 class="font-display text-4xl leading-none text-ink-800">页面未找到</h1>
          <p class="mt-4 text-[15px] leading-7 text-ink-500">
            这篇内容可能已经删除、移动，或者链接已经过期。
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a
              href="/"
              class="inline-flex h-9 items-center justify-center rounded-[6px] border border-ink-800 bg-ink-800 px-4 font-mono text-[11px] text-paper transition-colors hover:border-accent hover:bg-accent hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
            >
              ← 返回首页
            </a>
            <a
              href="/posts/"
              data-random-post={JSON.stringify(oldPostHrefs)}
              class="inline-flex h-9 items-center justify-center gap-2 rounded-[6px] border border-line px-3.5 font-mono text-[11px] text-ink-700 transition-colors hover:border-ink-300 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
            >
              <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
              随机放一首旧文
            </a>
          </div>
          <p lang="en" class="mt-8 border-t border-line pt-5 text-[13px] leading-6 text-ink-500">
            Page not found. It may have been removed, moved, or the link has expired.
            <a href="/en/" class="ml-1 text-ink-700 underline decoration-ink-300 underline-offset-4 hover:text-accent">Back to the English homepage →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  :global([data-site-shell]) {
    transition: transform 900ms var(--ease-in-out);
  }

  :global(:root[data-upside-down] [data-site-shell]) {
    transform: rotate(180deg);
  }

  .flip-overlay {
    display: none;
  }

  :global(:root[data-upside-down]) .flip-overlay {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: block;
    width: 100%;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  /* 外壳整体转了 180°，提示放在顶部再自转回来，才会正着出现在屏幕底部；
     main 有 view-transition-name 自成层叠上下文，提示要避开页眉所在的区域 */
  .flip-hint {
    position: absolute;
    top: 96px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-600);
    font: 12px var(--font-mono);
    white-space: nowrap;
    transform: translateX(-50%) rotate(180deg);
  }

  .flip-overlay:focus-visible .flip-hint {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

<script>
  import { pickRandom } from "@/lib/record-shuffle";

  function setup() {
    const flipBack = document.querySelector<HTMLButtonElement>("[data-flip-back]");
    flipBack?.addEventListener("click", () => {
      const root = document.documentElement;
      if (root.dataset.upsideDown) {
        root.dataset.theme = root.dataset.upsideDown;
        delete root.dataset.upsideDown;
      }
    });

    const randomLink = document.querySelector<HTMLAnchorElement>("[data-random-post]");
    const href = pickRandom(JSON.parse(randomLink?.dataset.randomPost ?? "[]") as string[]);
    if (randomLink && href) {
      randomLink.href = href;
    }
  }

  document.addEventListener("astro:page-load", setup);
</script>
