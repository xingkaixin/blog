---
import { PostConsole, type PostConsoleItem } from "@/components/post-console";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublishedPosts, toPostListItem } from "@/lib/astro-posts";
import { estimateReadingMetrics } from "@/lib/markdown";
import { siteConfig } from "@/lib/site";

const entries = await getPublishedPosts();
const posts: PostConsoleItem[] = entries.map((entry) => ({
  ...toPostListItem(entry),
  ...estimateReadingMetrics(entry.body),
}));
const meta = {
  title: siteConfig.title,
  description: siteConfig.description,
  url: `${siteConfig.url}/`,
  type: "website" as const,
};
---

<SiteLayout meta={meta} status={`NORMAL · ${posts.length} posts`}>
  <PostConsole posts={posts} client:load />
</SiteLayout>
