---
import HomeStory from "@/components/astro/HomeStory.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { siteConfig, siteContacts } from "@/lib/site";

const meta = {
  title: siteConfig.title,
  description: siteConfig.description,
  url: `${siteConfig.url}/`,
  type: "website" as const,
};
---

<SiteLayout meta={meta} footerStage={false}>
  <h1 class="sr-only">{siteConfig.title}</h1>
  <template data-agent-content>
    <h1>{siteConfig.title}</h1>
    <p>{siteConfig.description}</p>
    <h2>关于</h2>
    <p>{siteConfig.about}</p>
    <blockquote>{siteConfig.motto}</blockquote>
    <h2>联系</h2>
    <ul>
      {Object.values(siteContacts).map((contact) => (
        <li><a href={contact.href}>{contact.label}</a>：{contact.value}</li>
      ))}
    </ul>
    <h2>栏目</h2>
    <ul>
      <li><a href="/posts/">文章</a></li>
      <li><a href="/projects/">项目</a></li>
      <li><a href="/photos/">照片墙</a></li>
    </ul>
  </template>
  <HomeStory />
</SiteLayout>
