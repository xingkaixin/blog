---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { siteConfig } from "@/lib/site";

const feedUrl = `${siteConfig.url}/feed.xml`;
const meta = {
  title: "RSS 订阅",
  description: "通过 RSS 订阅行开心的颠倒世界，在你习惯的阅读器里接收新文章。",
  url: `${siteConfig.url}/rss/`,
  type: "webpage" as const,
};
---

<SiteLayout meta={meta}>
  <article class="rss-page" data-agent-content>
    <svg class="rss-background" viewBox="0 0 320 320" fill="none" aria-hidden="true">
      <circle cx="64" cy="256" r="22" fill="currentColor" />
      <path d="M64 156a100 100 0 0 1 100 100M64 56a200 200 0 0 1 200 200" stroke="currentColor" stroke-width="28" stroke-linecap="round" />
    </svg>
    <div class="rss-content">
      <h1>RSS 订阅</h1>
      <p class="intro">在你习惯的阅读器里，收到我的新文章。</p>
      <p class="description">关于 AI、编程，也关于生活。无需反复打开网站，订阅后就能在阅读器里看到更新。</p>

      <rss-subscription>
        <label for="rss-address">订阅地址</label>
        <div class="address-row">
          <input id="rss-address" type="url" value={feedUrl} readonly spellcheck="false" />
          <button type="button" hidden>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g class="copy-icon"><rect x="7" y="7" width="10" height="10" rx="2" /><path d="M12 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h2" /></g>
              <path class="check-icon" d="m4 10 4 4 8-8" />
            </svg>
            <span>复制链接</span>
          </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </rss-subscription>

      <p class="instructions">复制上面的地址，在 RSS 阅读器中选择「添加订阅」，粘贴即可。</p>
      <a class="feed-link" href={feedUrl} data-astro-reload>查看原始 RSS 文件</a>
    </div>
  </article>
</SiteLayout>

<style>
  .rss-page { position: relative; isolation: isolate; overflow: hidden; max-width: 1056px; margin: auto; padding: 88px 32px 80px; }
  .rss-content { position: relative; max-width: 600px; }
  .rss-background { position: absolute; z-index: -1; width: 400px; height: 400px; right: -24px; top: 24px; color: var(--accent); opacity: .07; pointer-events: none; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(36px, 5vw, 48px); line-height: 1.25; color: var(--ink-800); }
  .intro { margin: 24px 0 12px; font-size: 20px; line-height: 1.7; color: var(--ink-700); }
  .description { font-size: 14px; line-height: 1.9; color: var(--ink-500); text-wrap: pretty; }
  rss-subscription { display: block; margin-top: 36px; }
  label { display: block; margin-bottom: 10px; font-size: 13px; color: var(--ink-600); }
  .address-row { display: flex; gap: 10px; }
  input { min-width: 0; flex: 1; width: 100%; border: 1px solid var(--line); border-radius: 6px; padding: 14px; background: var(--surface); color: var(--ink-700); font: 13px var(--font-mono); }
  button { flex-shrink: 0; min-width: 128px; border-radius: 6px; padding: 12px 16px; background: var(--ink-800); color: var(--bg); font-size: 13px; cursor: pointer; transition: transform 150ms var(--ease-smooth-out); }
  button:not([hidden]) { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
  button:active:not(:focus-visible) { transform: scale(.97); }
  button:disabled { cursor: wait; }
  button[data-copied] { background: var(--accent-soft); color: var(--accent); }
  .check-icon, button[data-copied] .copy-icon { display: none; }
  button[data-copied] .check-icon { display: block; }
  @media (hover: hover) and (pointer: fine) {
    button:hover:not([data-copied]):not(:disabled) { background: var(--ink-700); }
  }
  @media (prefers-reduced-motion: reduce) {
    button { transition: none; }
    button:active:not(:focus-visible) { transform: none; }
  }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .copy-status { min-height: 24px; margin-top: 8px; font-size: 12px; line-height: 2; color: var(--ink-600); }
  .instructions { margin: 8px 0 16px; font-size: 13px; line-height: 1.9; color: var(--ink-500); }
  .feed-link { font-size: 12px; color: var(--ink-500); text-decoration: underline; text-underline-offset: 4px; }
  .feed-link:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .rss-page { padding: 52px 20px 48px; }
    .rss-background { width: 260px; height: 260px; right: -80px; top: 0; }
    .intro { font-size: 18px; }
    .address-row { flex-direction: column; }
    button { min-height: 44px; }
    input { font-size: 12px; }
  }
</style>

<script>
  class RssSubscription extends HTMLElement {
    private resetTimer: ReturnType<typeof setTimeout> | undefined;

    connectedCallback() {
      this.querySelector("button")!.hidden = false;
    }

    disconnectedCallback() {
      clearTimeout(this.resetTimer);
    }

    constructor() {
      super();
      this.addEventListener("click", async (event) => {
        if (!(event.target instanceof Element) || !event.target.closest("button")) {
          return;
        }
        const input = this.querySelector("input")!;
        const button = this.querySelector("button")!;
        const label = button.querySelector("span")!;
        const status = this.querySelector<HTMLElement>('[role="status"]')!;
        clearTimeout(this.resetTimer);
        button.removeAttribute("data-copied");
        button.disabled = true;
        label.textContent = "复制中…";
        status.textContent = "";
        try {
          await navigator.clipboard.writeText(input.value);
          button.setAttribute("data-copied", "");
          label.textContent = "已复制";
          status.textContent = "链接已复制，可以粘贴到阅读器了。";
          this.resetTimer = setTimeout(() => {
            button.removeAttribute("data-copied");
            label.textContent = "复制链接";
          }, 2500);
        } catch {
          label.textContent = "重试复制";
          input.focus();
          input.select();
          status.textContent = "未能自动复制。地址已选中，请手动复制。";
        } finally {
          button.disabled = false;
        }
      });
    }
  }

  if (!customElements.get("rss-subscription")) {
    customElements.define("rss-subscription", RssSubscription);
  }
</script>
