---
type Props = {
  mode: "cruise" | "progress";
  label: string;
  hint?: string;
};

const {
  mode,
  label,
  hint = "⌘K 命令面板 · ⌘J 翻转世界",
} = Astro.props;
---

<footer
  class="fixed inset-x-0 bottom-0 z-30 h-[30px] border-t border-line bg-ink-50"
  aria-label="页面状态"
>
  <div class="relative mx-auto flex h-full max-w-320 items-center justify-between gap-4 px-4 font-mono text-[10px] tracking-[0.08em] text-ink-400 sm:px-6 lg:px-8">
    <span class="max-w-[52vw] truncate">{label}</span>
    <div class="track-lane pointer-events-none absolute inset-y-0 left-[35vw] right-[35vw] hidden overflow-hidden sm:block" aria-hidden="true">
      {mode === "progress" && <span class="track-trail absolute inset-x-0 top-0 h-px origin-left bg-accent/55" />}
      <span class="track-car absolute left-0 top-1" data-mode={mode}></span>
    </div>
    <span class="hidden shrink-0 sm:block">{hint}</span>
  </div>
</footer>

<style>
  .track-car {
    width: 86px;
    height: 20px;
    background-color: var(--accent);
    -webkit-mask: url("/f1-car.png") center / contain no-repeat;
    mask: url("/f1-car.png") center / contain no-repeat;
    will-change: transform;
  }

  .track-car[data-mode="cruise"] {
    animation: track-car-cruise 18s linear infinite;
  }

  .track-car[data-mode="progress"],
  .track-trail {
    animation: track-car-progress linear both;
    animation-timeline: scroll(root block);
  }

  .track-trail {
    animation-name: track-trail-progress;
  }

  @keyframes track-car-cruise {
    from {
      transform: translateX(-100px);
    }
    to {
      transform: translateX(30vw);
    }
  }

  @keyframes track-car-progress {
    to {
      transform: translateX(calc(30vw - 86px));
    }
  }

  @keyframes track-trail-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-car,
    .track-trail {
      animation: none;
      will-change: auto;
    }

    .track-car {
      left: 50%;
      transform: translateX(-50%);
    }

    .track-trail {
      transform: scaleX(0.5);
    }
  }
</style>
