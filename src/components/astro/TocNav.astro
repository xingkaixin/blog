---
import type { TocItem } from "@/lib/post-toc";

type Props = {
  items: TocItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <div
        data-toc-scroll
        class="hidden border-l border-line px-5 py-4 lg:block lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto"
      >
        <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">导览</p>
        <nav class="space-y-0.5">
          {items.map((item) => (
            <a
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block rounded-r-[5px] border-l-2 border-transparent px-2.5 py-1.5 text-[12px] leading-5 text-ink-500 transition-[color,border-color,background-color] duration-(--duration-quick) hover:bg-ink-50 hover:text-ink-800",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
      <details class="rounded-[8px] border border-line bg-surface px-4 py-3 lg:hidden">
        <summary class="cursor-pointer list-none font-mono text-[11px] text-ink-600">
          展开导览
        </summary>
        <nav class="mt-3 space-y-0.5 border-t border-line pt-3">
          {items.map((item) => (
            <a
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block border-l-2 border-transparent px-2.5 py-1.5 text-[12px] leading-5 text-ink-500",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </details>
      <script>
        import { resolveActiveTocId, TOC_ACTIVE_OFFSET } from "@/lib/toc-active";

        function keepActiveLinkVisible(container: HTMLElement, link: HTMLElement) {
          const containerRect = container.getBoundingClientRect();
          const linkRect = link.getBoundingClientRect();
          const isVisible = linkRect.top >= containerRect.top && linkRect.bottom <= containerRect.bottom;
          if (isVisible) {
            return;
          }

          container.scrollTo({
            top:
              container.scrollTop +
              linkRect.top -
              containerRect.top -
              container.clientHeight / 2 +
              link.clientHeight / 2,
            behavior: "auto",
          });
        }

        function setActive(links: Element[], id: string) {
          for (const link of links) {
            const isActive = link.getAttribute("data-toc-link") === id;
            if (isActive) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }

          const desktopNav = document.querySelector("[data-toc-scroll]");
          const activeLink = links.find((link) => link.getAttribute("data-toc-link") === id);
          if (
            desktopNav instanceof HTMLElement &&
            activeLink instanceof HTMLElement &&
            desktopNav.contains(activeLink)
          ) {
            keepActiveLinkVisible(desktopNav, activeLink);
          }
        }

        type TocWindow = Window & { blogTocControllerInstalled?: boolean };
        const tocWindow = window as TocWindow;

        if (!tocWindow.blogTocControllerInstalled) {
          tocWindow.blogTocControllerInstalled = true;
          let previousActiveId: string | null = null;
          let animationFrame = 0;

          function updateActiveHeading() {
            const links = Array.from(document.querySelectorAll("[data-toc-link]"));
            if (!links.length) {
              return;
            }

            const ids = [
              ...new Set(
                links
                  .map((link) => link.getAttribute("data-toc-link"))
                  .filter((id): id is string => Boolean(id)),
              ),
            ];
            const headings = ids
              .map((id) => document.getElementById(id))
              .filter((heading): heading is HTMLElement => Boolean(heading));

            if (!headings.length) {
              return;
            }

            const visibleIds = headings
              .filter((heading) => heading.getBoundingClientRect().top <= TOC_ACTIVE_OFFSET)
              .map((heading) => heading.id);
            const isAtPageEnd =
              window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
            const activeId = resolveActiveTocId(
              headings.map((heading) => heading.id),
              visibleIds,
              isAtPageEnd,
            );

            if (activeId && activeId !== previousActiveId) {
              previousActiveId = activeId;
              setActive(links, activeId);
            }
          }

          function scheduleUpdate() {
            if (animationFrame) {
              return;
            }
            animationFrame = requestAnimationFrame(() => {
              animationFrame = 0;
              updateActiveHeading();
            });
          }

          function initialize() {
            if (animationFrame) {
              cancelAnimationFrame(animationFrame);
              animationFrame = 0;
            }
            previousActiveId = null;
            scheduleUpdate();
          }

          window.addEventListener("scroll", scheduleUpdate, { passive: true });
          document.addEventListener("astro:page-load", initialize);
          document.addEventListener("astro:before-swap", () => {
            if (animationFrame) {
              cancelAnimationFrame(animationFrame);
              animationFrame = 0;
            }
            previousActiveId = null;
          });
          document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target.closest("[data-toc-link]") : null;
            target?.closest("details")?.removeAttribute("open");
          });
          initialize();
        }
      </script>
    </>
  )
}
