---
import type { TocItem } from "@/lib/post-toc";

type Props = {
  items: TocItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <div
        data-toc-scroll
        class="hidden border-l border-line px-5 py-4 lg:block lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto"
      >
        <nav data-toc-track class="relative space-y-0.5 pl-4">
          <span data-toc-dot aria-hidden="true" class="pointer-events-none absolute left-0 top-0 size-1.5 rounded-full bg-accent opacity-0" />
          {items.map((item) => (
            <a
              data-astro-reload
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block rounded-[5px] px-2.5 py-1.5 text-[12px] leading-5 text-ink-500 transition-[color,background-color] duration-(--duration-quick) hover:bg-ink-50 hover:text-ink-800",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
      <details data-toc-mobile-details class="rounded-[8px] border border-line bg-surface px-4 py-3 lg:hidden">
        <summary class="cursor-pointer list-none font-mono text-[11px] text-ink-600">
          展开导览
        </summary>
        <nav class="mt-3 space-y-0.5 border-t border-line pt-3">
          {items.map((item) => (
            <a
              data-astro-reload
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block border-l-2 border-transparent px-2.5 py-1.5 text-[12px] leading-5 text-ink-500",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </details>
      <script>
        import { getTocActiveOffset, resolveActiveTocId } from "@/lib/toc-active";

        function keepActiveLinkVisible(container: HTMLElement, link: HTMLElement) {
          const containerRect = container.getBoundingClientRect();
          const linkRect = link.getBoundingClientRect();
          const isVisible = linkRect.top >= containerRect.top && linkRect.bottom <= containerRect.bottom;
          if (isVisible) {
            return;
          }

          container.scrollTo({
            top:
              container.scrollTop +
              linkRect.top -
              containerRect.top -
              container.clientHeight / 2 +
              link.clientHeight / 2,
            behavior: "auto",
          });
        }

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let dotAnimation: Animation | undefined;
        let resizeObserver: ResizeObserver | undefined;
        let navigationTimer = 0;

        function moveDot(link: HTMLElement, animate = true) {
          const track = link.closest("[data-toc-track]");
          const dot = track?.querySelector<HTMLElement>("[data-toc-dot]");
          if (!(track instanceof HTMLElement) || !dot || !track.offsetWidth) {
            return;
          }

          const toY = link.offsetTop + link.offsetHeight / 2 - dot.offsetHeight / 2;
          const transform = new DOMMatrixReadOnly(getComputedStyle(dot).transform);
          const fromX = transform.m41;
          const fromY = transform.m42;
          const ready = dot.style.opacity === "1";
          dotAnimation?.cancel();
          dot.style.transform = `translate(0px, ${toY}px)`;
          dot.style.opacity = "1";
          if (!animate || !ready || reducedMotion.matches || (fromY === toY && fromX === 0)) {
            return;
          }

          const arcWidth = Math.min(10, Math.abs(toY - fromY) * 0.3);
          const frames = Array.from({ length: 17 }, (_, index) => {
            const progress = index / 16;
            const x = fromX * (1 - progress) - 4 * arcWidth * progress * (1 - progress);
            const y = fromY + (toY - fromY) * progress;
            return { transform: `translate(${x}px, ${y}px)` };
          });
          const styles = getComputedStyle(track);
          // CSS minification can convert milliseconds to seconds; Web Animations requires milliseconds.
          const duration = styles.getPropertyValue("--duration-fast").trim();
          dotAnimation = dot.animate(frames, {
            duration: parseFloat(duration) * (duration.endsWith("ms") ? 1 : 1000),
            easing: styles.getPropertyValue("--ease-smooth-out").trim(),
          });
        }

        function alignDot() {
          const link = document.querySelector<HTMLElement>('[data-toc-track] [aria-current="location"]');
          if (link) {
            moveDot(link, false);
          }
        }

        function setActive(links: Element[], id: string, animate = true) {
          for (const link of links) {
            const isActive = link.getAttribute("data-toc-link") === id;
            if (isActive) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }

          const desktopNav = document.querySelector("[data-toc-scroll]");
          const activeLink = links.find((link) => link.getAttribute("data-toc-link") === id);
          if (
            desktopNav instanceof HTMLElement &&
            activeLink instanceof HTMLElement &&
            desktopNav.contains(activeLink)
          ) {
            moveDot(activeLink, animate);
            keepActiveLinkVisible(desktopNav, activeLink);
          }
        }

        let previousActiveId: string | null = null;
        let animationFrame = 0;

        function updateActiveHeading() {
          if (navigationTimer) {
            return;
          }
          const links = Array.from(document.querySelectorAll("[data-toc-link]"));
          if (!links.length) {
            return;
          }

          const ids = [
            ...new Set(
              links
                .map((link) => link.getAttribute("data-toc-link"))
                .filter((id): id is string => Boolean(id)),
            ),
          ];
          const headings = ids
            .map((id) => document.getElementById(id))
            .filter((heading): heading is HTMLElement => Boolean(heading));

          if (!headings.length) {
            return;
          }

          const visibleIds = headings
            .filter((heading) => heading.getBoundingClientRect().top <= getTocActiveOffset(heading))
            .map((heading) => heading.id);
          const isAtPageEnd =
            window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
          const activeId = resolveActiveTocId(
            headings.map((heading) => heading.id),
            visibleIds,
            isAtPageEnd,
          );

          if (activeId && activeId !== previousActiveId) {
            previousActiveId = activeId;
            setActive(links, activeId);
          }
        }

        function scheduleUpdate() {
          if (animationFrame) {
            return;
          }
          animationFrame = requestAnimationFrame(() => {
            animationFrame = 0;
            updateActiveHeading();
          });
        }

        function initialize() {
          if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = 0;
          }
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          dotAnimation?.cancel();
          resizeObserver?.disconnect();
          const track = document.querySelector("[data-toc-track]");
          if (track) {
            resizeObserver = new ResizeObserver(alignDot);
            resizeObserver.observe(track);
          }
          previousActiveId = null;
          scheduleUpdate();
        }

        function finishNavigation() {
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          scheduleUpdate();
        }

        window.addEventListener("scroll", () => {
          if (navigationTimer) {
            clearTimeout(navigationTimer);
            navigationTimer = window.setTimeout(finishNavigation, 150);
          }
          scheduleUpdate();
        }, { passive: true });
        document.addEventListener("scrollend", finishNavigation);
        window.addEventListener("wheel", finishNavigation, { passive: true });
        window.addEventListener("touchstart", finishNavigation, { passive: true });
        window.addEventListener("keydown", finishNavigation);
        reducedMotion.addEventListener("change", alignDot);
        document.addEventListener("astro:page-load", initialize);
        type TocDetailsAnimation = {
          anim: Animation;
          closing: boolean;
        };

        const tocDetailsAnimations = new WeakMap<HTMLDetailsElement, TocDetailsAnimation>();
        let activeTocDetails: HTMLDetailsElement | null = null;

        function clearTocDetailsAnimation(details: HTMLDetailsElement | null) {
          if (!details) {
            return;
          }
          const entry = tocDetailsAnimations.get(details);
          if (!entry) {
            return;
          }
          tocDetailsAnimations.delete(details);
          entry.anim.cancel();
          if (entry.closing) {
            details.open = false;
          }
          details.style.height = "";
          details.style.overflow = "";
        }

        function setTocDetailsOpen(details: HTMLDetailsElement, targetOpen: boolean) {
          const entry = tocDetailsAnimations.get(details);
          if (entry) {
            if (entry.closing !== targetOpen) {
              return;
            }
          } else if (details.open === targetOpen) {
            return;
          }

          const startHeight = details.getBoundingClientRect().height || details.offsetHeight;
          if (entry) {
            tocDetailsAnimations.delete(details);
            entry.anim.cancel();
          }

          if (reducedMotion.matches || typeof details.animate !== "function") {
            details.style.height = "";
            details.style.overflow = "";
            details.open = targetOpen;
            return;
          }

          activeTocDetails = details;
          const easing =
            getComputedStyle(document.documentElement).getPropertyValue("--ease-smooth-out").trim() ||
            "cubic-bezier(0.22, 1, 0.36, 1)";
          const duration = 160;

          if (targetOpen) {
            details.style.height = "";
            details.open = true;
            const endHeight = details.getBoundingClientRect().height || details.offsetHeight;
            if (Math.abs(endHeight - startHeight) < 1) {
              details.style.overflow = "";
              return;
            }
            details.style.overflow = "hidden";
            const anim = details.animate(
              [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
              { duration, easing },
            );
            tocDetailsAnimations.set(details, { anim, closing: false });
            void anim.finished
              .catch(() => {})
              .finally(() => {
                if (tocDetailsAnimations.get(details)?.anim !== anim) {
                  return;
                }
                tocDetailsAnimations.delete(details);
                details.style.height = "";
                details.style.overflow = "";
              });
            return;
          }

          const summary = details.querySelector("summary");
          if (!(summary instanceof HTMLElement)) {
            details.style.height = "";
            details.style.overflow = "";
            details.open = false;
            return;
          }
          const cs = getComputedStyle(details);
          const closedHeight =
            summary.getBoundingClientRect().height +
            parseFloat(cs.paddingTop) +
            parseFloat(cs.paddingBottom) +
            parseFloat(cs.borderTopWidth) +
            parseFloat(cs.borderBottomWidth);
          if (startHeight <= closedHeight + 1) {
            details.style.height = "";
            details.style.overflow = "";
            details.open = false;
            return;
          }

          details.style.overflow = "hidden";
          details.style.height = `${closedHeight}px`;
          const anim = details.animate(
            [{ height: `${startHeight}px` }, { height: `${closedHeight}px` }],
            { duration, easing },
          );
          tocDetailsAnimations.set(details, { anim, closing: true });
          void anim.finished
            .catch(() => {})
            .finally(() => {
              if (tocDetailsAnimations.get(details)?.anim !== anim) {
                return;
              }
              tocDetailsAnimations.delete(details);
              details.open = false;
              details.style.height = "";
              details.style.overflow = "";
            });
        }

        document.addEventListener("astro:before-swap", () => {
          if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = 0;
          }
          previousActiveId = null;
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          dotAnimation?.cancel();
          resizeObserver?.disconnect();
          clearTocDetailsAnimation(activeTocDetails);
          activeTocDetails = null;
        });
        document.addEventListener("site:open-toc", () => {
          const details = document.querySelector<HTMLDetailsElement>("[data-toc-mobile-details]");
          if (details) {
            setTocDetailsOpen(details, true);
          }
        });
        document.addEventListener("click", (event) => {
          const summary =
            event.target instanceof Element
              ? event.target.closest("[data-toc-mobile-details] > summary")
              : null;
          if (summary) {
            const details = summary.parentElement;
            if (details instanceof HTMLDetailsElement) {
              event.preventDefault();
              const entry = tocDetailsAnimations.get(details);
              const isOpen = entry ? !entry.closing : details.open;
              setTocDetailsOpen(details, !isOpen);
            }
            return;
          }

          const target = event.target instanceof Element ? event.target.closest("[data-toc-link]") : null;
          if (!(target instanceof HTMLAnchorElement) || event.defaultPrevented || event.button !== 0 ||
            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            return;
          }
          const id = target.getAttribute("data-toc-link");
          if (!id || !document.getElementById(id)) {
            return;
          }

          // Keep the clicked destination selected while native smooth scrolling passes other headings.
          clearTimeout(navigationTimer);
          navigationTimer = window.setTimeout(finishNavigation, 150);
          previousActiveId = id;
          setActive(Array.from(document.querySelectorAll("[data-toc-link]")), id, event.detail > 0);
          const details = target.closest("details");
          if (details instanceof HTMLDetailsElement) {
            setTocDetailsOpen(details, false);
          }
        });
        initialize();
      </script>
    </>
  )
}
