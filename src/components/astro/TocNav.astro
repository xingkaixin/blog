---
import type { TocItem } from "@/lib/post-toc";

type Props = {
  items: TocItem[];
};

const { items } = Astro.props;
---

      <div
        data-toc-scroll
        class="hidden border-l border-line px-5 py-4 lg:block lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto"
      >
        <div data-toc-highlights hidden class="mb-4 border-b border-line pb-3">
          <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">
            我的划线 · <span data-toc-highlight-count>0</span>
          </p>
          <ul data-toc-highlight-list class="space-y-1"></ul>
        </div>
        <nav hidden={!items.length} data-toc-track class="relative space-y-0.5 pl-4">
          <span data-toc-dot aria-hidden="true" class="pointer-events-none absolute left-0 top-0 size-1.5 rounded-full bg-accent opacity-0" />
          {items.map((item) => (
            <a
              data-astro-reload
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block rounded-[5px] px-2.5 py-1.5 text-[12px] leading-5 text-ink-500 transition-[color,background-color] duration-(--duration-quick) hover:bg-ink-50 hover:text-ink-800",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
      <details data-toc-mobile-details class="rounded-[8px] border border-line bg-surface px-4 py-3 lg:hidden">
        <summary class="cursor-pointer list-none font-mono text-[11px] text-ink-600">
          展开导览
        </summary>
        <div data-toc-highlights hidden class="mt-3 border-t border-line pt-3">
          <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">
            我的划线 · <span data-toc-highlight-count>0</span>
          </p>
          <ul data-toc-highlight-list class="space-y-1"></ul>
        </div>
        <nav hidden={!items.length} class="mt-3 space-y-0.5 border-t border-line pt-3">
          {items.map((item) => (
            <a
              data-astro-reload
              data-toc-link={item.id}
              href={`#${item.id}`}
              class:list={[
                "toc-link block border-l-2 border-transparent px-2.5 py-1.5 text-[12px] leading-5 text-ink-500",
                item.depth === 3 && "ml-3",
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </details>
      <dialog
        data-toc-sheet
        aria-labelledby="toc-sheet-title"
        class="toc-sheet fixed inset-x-0 bottom-0 top-auto m-0 max-h-[75dvh] w-full max-w-none flex-col overflow-hidden rounded-t-[16px] border-t border-line bg-surface p-0 text-ink-800 shadow-[0_-20px_60px_-32px_rgba(20,21,26,0.45)] lg:hidden"
      >
        <div class="flex shrink-0 justify-center pb-1 pt-2" aria-hidden="true">
          <span class="h-1 w-9 rounded-full bg-ink-200" />
        </div>
        <div class="flex shrink-0 items-center justify-between border-b border-line px-5 pb-3 pt-1">
          <h2 id="toc-sheet-title" class="font-mono text-xs uppercase tracking-[0.08em] text-ink-500">
            目录
          </h2>
          <button
            type="button"
            data-toc-sheet-close
            aria-label="关闭目录"
            class="inline-flex size-8 items-center justify-center rounded-[6px] font-mono text-base text-ink-500 transition-colors hover:bg-ink-50 hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 pointer-coarse:size-10"
          >
            ×
          </button>
        </div>
        <div
          data-toc-sheet-body
          class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-3 pb-[max(1.25rem,env(safe-area-inset-bottom))]"
        >
          <div data-toc-highlights hidden class="mb-3 border-b border-line pb-3">
            <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-ink-400">
              我的划线 · <span data-toc-highlight-count>0</span>
            </p>
            <ul data-toc-highlight-list class="space-y-1"></ul>
          </div>
          <nav hidden={!items.length} class="space-y-0.5">
            {items.map((item) => (
              <a
                data-astro-reload
                data-toc-link={item.id}
                href={`#${item.id}`}
                class:list={[
                  "toc-link block border-l-2 border-transparent px-2.5 py-2 text-[13px] leading-5 text-ink-500 transition-colors hover:text-ink-800",
                  item.depth === 3 && "ml-3",
                ]}
              >
                {item.text}
              </a>
            ))}
          </nav>
        </div>
      </dialog>
      <script>
        import {
          HIGHLIGHT_ATTR,
          HIGHLIGHTS_CHANGED_EVENT,
          normalizeHighlightPath,
          readHighlights,
          removeHighlights,
        } from "@/lib/article-highlights";
        import { getTocActiveOffset, resolveActiveTocId } from "@/lib/toc-active";

        function orderedHighlightsForPage() {
          const saved = readHighlights(location.pathname);
          if (saved.length <= 1) {
            return saved;
          }
          const scope = document.querySelector<HTMLElement>("[data-quote-scope]");
          if (!scope) {
            return saved;
          }
          const order = new Map<string, number>();
          for (const mark of scope.querySelectorAll<HTMLElement>(`mark[${HIGHLIGHT_ATTR}]`)) {
            const id = mark.getAttribute(HIGHLIGHT_ATTR);
            if (id && !order.has(id)) {
              order.set(id, order.size);
            }
          }
          return saved.toSorted(
            (a, b) =>
              (order.get(a.id) ?? Number.MAX_SAFE_INTEGER) -
              (order.get(b.id) ?? Number.MAX_SAFE_INTEGER),
          );
        }

        function renderHighlightBookmarks() {
          const toc = document.querySelector<HTMLElement>("[data-post-toc]");
          if (!toc) {
            return;
          }
          const highlights = orderedHighlightsForPage();
          toc.hidden = !toc.querySelector("[data-toc-link]") && highlights.length === 0;
          const shortcut = document.querySelector<HTMLButtonElement>("[data-compact-toc]");
          if (shortcut) {
            shortcut.hidden = toc.hidden;
          }
          for (const section of document.querySelectorAll<HTMLElement>("[data-toc-highlights]")) {
            const list = section.querySelector<HTMLElement>("[data-toc-highlight-list]");
            const count = section.querySelector<HTMLElement>("[data-toc-highlight-count]");
            if (!list || !count) {
              continue;
            }
            section.hidden = highlights.length === 0;
            count.textContent = String(highlights.length);
            list.replaceChildren(
              ...highlights.map((item) => {
                const li = document.createElement("li");
                li.className = "flex items-start gap-1";

                const jump = document.createElement("button");
                jump.type = "button";
                jump.dataset.highlightJump = item.id;
                jump.className =
                  "min-w-0 flex-1 rounded-[5px] px-2 py-1 text-left text-[12px] leading-[18px] text-ink-600 transition-colors hover:bg-ink-50 hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40";
                const snippet = document.createElement("span");
                snippet.className = "line-clamp-2 border-l-2 border-accent/60 pl-2";
                snippet.textContent = item.text;
                jump.appendChild(snippet);

                const del = document.createElement("button");
                del.type = "button";
                del.dataset.highlightRemove = item.id;
                del.setAttribute("aria-label", `删除划线：${item.text.slice(0, 20)}`);
                del.className =
                  "mt-1 shrink-0 rounded px-1.5 py-0.5 font-mono text-[11px] text-ink-400 transition-colors hover:bg-ink-100 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40";
                del.textContent = "×";

                li.append(jump, del);
                return li;
              }),
            );
          }
          updateTocScrollMask();
        }

        function updateTocScrollMask() {
          const container = document.querySelector<HTMLElement>("[data-toc-scroll]");
          if (!container) {
            return;
          }
          const overflow = container.scrollHeight - container.clientHeight;
          container.toggleAttribute("data-more-above", overflow > 4 && container.scrollTop > 4);
          container.toggleAttribute(
            "data-more-below",
            overflow > 4 && container.scrollTop + container.clientHeight < container.scrollHeight - 4,
          );
        }

        function keepActiveLinkVisible(container: HTMLElement, link: HTMLElement) {
          const containerRect = container.getBoundingClientRect();
          const linkRect = link.getBoundingClientRect();
          const isVisible = linkRect.top >= containerRect.top && linkRect.bottom <= containerRect.bottom;
          if (isVisible) {
            return;
          }

          container.scrollTo({
            top:
              container.scrollTop +
              linkRect.top -
              containerRect.top -
              container.clientHeight / 2 +
              link.clientHeight / 2,
            behavior: "auto",
          });
          updateTocScrollMask();
        }

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let dotAnimation: Animation | undefined;
        let resizeObserver: ResizeObserver | undefined;
        let tocScrollController: AbortController | undefined;
        let sheetCloseTimer = 0;
        let navigationTimer = 0;

        function moveDot(link: HTMLElement, animate = true) {
          const track = link.closest("[data-toc-track]");
          const dot = track?.querySelector<HTMLElement>("[data-toc-dot]");
          if (!(track instanceof HTMLElement) || !dot || !track.offsetWidth) {
            return;
          }

          const toY = link.offsetTop + link.offsetHeight / 2 - dot.offsetHeight / 2;
          const transform = new DOMMatrixReadOnly(getComputedStyle(dot).transform);
          const fromX = transform.m41;
          const fromY = transform.m42;
          const ready = dot.style.opacity === "1";
          dotAnimation?.cancel();
          dot.style.transform = `translate(0px, ${toY}px)`;
          dot.style.opacity = "1";
          if (!animate || !ready || reducedMotion.matches || (fromY === toY && fromX === 0)) {
            return;
          }

          const arcWidth = Math.min(10, Math.abs(toY - fromY) * 0.3);
          const frames = Array.from({ length: 17 }, (_, index) => {
            const progress = index / 16;
            const x = fromX * (1 - progress) - 4 * arcWidth * progress * (1 - progress);
            const y = fromY + (toY - fromY) * progress;
            return { transform: `translate(${x}px, ${y}px)` };
          });
          const styles = getComputedStyle(track);
          // CSS minification can convert milliseconds to seconds; Web Animations requires milliseconds.
          const duration = styles.getPropertyValue("--duration-fast").trim();
          dotAnimation = dot.animate(frames, {
            duration: parseFloat(duration) * (duration.endsWith("ms") ? 1 : 1000),
            easing: styles.getPropertyValue("--ease-smooth-out").trim(),
          });
        }

        function alignDot() {
          const link = document.querySelector<HTMLElement>('[data-toc-track] [aria-current="location"]');
          if (link) {
            moveDot(link, false);
          }
        }

        function setActive(links: Element[], id: string, animate = true) {
          for (const link of links) {
            const isActive = link.getAttribute("data-toc-link") === id;
            if (isActive) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }

          const desktopNav = document.querySelector("[data-toc-scroll]");
          const activeLink = links.find((link) => link.getAttribute("data-toc-link") === id);
          if (
            desktopNav instanceof HTMLElement &&
            activeLink instanceof HTMLElement &&
            desktopNav.contains(activeLink)
          ) {
            moveDot(activeLink, animate);
            keepActiveLinkVisible(desktopNav, activeLink);
          }
        }

        let previousActiveId: string | null = null;
        let animationFrame = 0;

        function updateActiveHeading() {
          if (navigationTimer) {
            return;
          }
          const links = Array.from(document.querySelectorAll("[data-toc-link]"));
          if (!links.length) {
            return;
          }

          const ids = [
            ...new Set(
              links
                .map((link) => link.getAttribute("data-toc-link"))
                .filter((id): id is string => Boolean(id)),
            ),
          ];
          const headings = ids
            .map((id) => document.getElementById(id))
            .filter((heading): heading is HTMLElement => Boolean(heading));

          if (!headings.length) {
            return;
          }

          const visibleIds = headings
            .filter((heading) => heading.getBoundingClientRect().top <= getTocActiveOffset(heading))
            .map((heading) => heading.id);
          const isAtPageEnd =
            window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
          const activeId = resolveActiveTocId(
            headings.map((heading) => heading.id),
            visibleIds,
            isAtPageEnd,
          );

          if (activeId && activeId !== previousActiveId) {
            previousActiveId = activeId;
            setActive(links, activeId);
          }
        }

        function scheduleUpdate() {
          if (animationFrame) {
            return;
          }
          animationFrame = requestAnimationFrame(() => {
            animationFrame = 0;
            updateActiveHeading();
          });
        }

        function openTocSheet() {
          const sheet = document.querySelector<HTMLDialogElement>("[data-toc-sheet]");
          if (!sheet || typeof sheet.showModal !== "function") {
            const details = document.querySelector<HTMLDetailsElement>("[data-toc-mobile-details]");
            if (details) {
              setTocDetailsOpen(details, true);
            }
            return;
          }
          clearTimeout(sheetCloseTimer);
          sheetCloseTimer = 0;
          sheet.removeAttribute("data-closing");
          if (!sheet.open) {
            sheet.showModal();
          }
          const body = sheet.querySelector<HTMLElement>("[data-toc-sheet-body]");
          const activeLink = body?.querySelector<HTMLElement>('[aria-current="location"]');
          if (body && activeLink) {
            keepActiveLinkVisible(body, activeLink);
          }
        }

        function closeTocSheet(immediate = false) {
          const sheet = document.querySelector<HTMLDialogElement>("[data-toc-sheet]");
          clearTimeout(sheetCloseTimer);
          sheetCloseTimer = 0;
          if (!sheet) {
            return;
          }
          if (!sheet.open) {
            sheet.removeAttribute("data-closing");
            return;
          }
          if (immediate || reducedMotion.matches) {
            sheet.removeAttribute("data-closing");
            sheet.close();
            return;
          }
          if (sheet.hasAttribute("data-closing")) {
            return;
          }
          sheet.setAttribute("data-closing", "");
          const finish = () => {
            clearTimeout(sheetCloseTimer);
            sheetCloseTimer = 0;
            sheet.removeAttribute("data-closing");
            if (sheet.open) {
              sheet.close();
            }
          };
          sheet.addEventListener("transitionend", finish, { once: true });
          sheetCloseTimer = window.setTimeout(finish, 200);
        }

        function initialize() {
          if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = 0;
          }
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          dotAnimation?.cancel();
          resizeObserver?.disconnect();
          tocScrollController?.abort();
          tocScrollController = new AbortController();
          const { signal } = tocScrollController;
          const track = document.querySelector("[data-toc-track]");
          const scrollContainer = document.querySelector<HTMLElement>("[data-toc-scroll]");
          if (track || scrollContainer) {
            resizeObserver = new ResizeObserver(() => {
              alignDot();
              updateTocScrollMask();
            });
            if (track) {
              resizeObserver.observe(track);
            }
            if (scrollContainer) {
              resizeObserver.observe(scrollContainer);
            }
          }
          if (scrollContainer) {
            scrollContainer.addEventListener("scroll", updateTocScrollMask, {
              passive: true,
              signal,
            });
          }
          const sheet = document.querySelector<HTMLDialogElement>("[data-toc-sheet]");
          if (sheet) {
            sheet.addEventListener(
              "cancel",
              (event) => {
                if (!reducedMotion.matches) {
                  event.preventDefault();
                  closeTocSheet();
                }
              },
              { signal },
            );
            sheet.addEventListener(
              "close",
              () => {
                clearTimeout(sheetCloseTimer);
                sheetCloseTimer = 0;
                sheet.removeAttribute("data-closing");
              },
              { signal },
            );
          }
          previousActiveId = null;
          renderHighlightBookmarks();
          scheduleUpdate();
        }

        function finishNavigation() {
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          scheduleUpdate();
        }

        window.addEventListener("scroll", () => {
          if (navigationTimer) {
            clearTimeout(navigationTimer);
            navigationTimer = window.setTimeout(finishNavigation, 150);
          }
          scheduleUpdate();
        }, { passive: true });
        document.addEventListener("scrollend", finishNavigation);
        window.addEventListener("wheel", finishNavigation, { passive: true });
        window.addEventListener("touchstart", finishNavigation, { passive: true });
        window.addEventListener("keydown", finishNavigation);
        reducedMotion.addEventListener("change", alignDot);
        document.addEventListener("astro:page-load", initialize);
        window.addEventListener(HIGHLIGHTS_CHANGED_EVENT, (event) => {
          const detailPath = (event as CustomEvent<{ path?: string }>).detail?.path;
          if (!detailPath || detailPath === normalizeHighlightPath(location.pathname)) {
            renderHighlightBookmarks();
          }
        });
        type TocDetailsAnimation = {
          anim: Animation;
          closing: boolean;
        };

        const tocDetailsAnimations = new WeakMap<HTMLDetailsElement, TocDetailsAnimation>();
        let activeTocDetails: HTMLDetailsElement | null = null;

        function clearTocDetailsAnimation(details: HTMLDetailsElement | null) {
          if (!details) {
            return;
          }
          const entry = tocDetailsAnimations.get(details);
          if (!entry) {
            return;
          }
          tocDetailsAnimations.delete(details);
          entry.anim.cancel();
          if (entry.closing) {
            details.open = false;
          }
          details.style.height = "";
          details.style.overflow = "";
        }

        function setTocDetailsOpen(details: HTMLDetailsElement, targetOpen: boolean) {
          const entry = tocDetailsAnimations.get(details);
          if (entry) {
            if (entry.closing !== targetOpen) {
              return;
            }
          } else if (details.open === targetOpen) {
            return;
          }

          const startHeight = details.getBoundingClientRect().height || details.offsetHeight;
          if (entry) {
            tocDetailsAnimations.delete(details);
            entry.anim.cancel();
          }

          if (reducedMotion.matches || typeof details.animate !== "function") {
            details.style.height = "";
            details.style.overflow = "";
            details.open = targetOpen;
            return;
          }

          activeTocDetails = details;
          const easing =
            getComputedStyle(document.documentElement).getPropertyValue("--ease-smooth-out").trim() ||
            "cubic-bezier(0.22, 1, 0.36, 1)";
          const duration = 160;

          if (targetOpen) {
            details.style.height = "";
            details.open = true;
            const endHeight = details.getBoundingClientRect().height || details.offsetHeight;
            if (Math.abs(endHeight - startHeight) < 1) {
              details.style.overflow = "";
              return;
            }
            details.style.overflow = "hidden";
            const anim = details.animate(
              [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
              { duration, easing },
            );
            tocDetailsAnimations.set(details, { anim, closing: false });
            void anim.finished
              .catch(() => {})
              .finally(() => {
                if (tocDetailsAnimations.get(details)?.anim !== anim) {
                  return;
                }
                tocDetailsAnimations.delete(details);
                details.style.height = "";
                details.style.overflow = "";
              });
            return;
          }

          const summary = details.querySelector("summary");
          if (!(summary instanceof HTMLElement)) {
            details.style.height = "";
            details.style.overflow = "";
            details.open = false;
            return;
          }
          const cs = getComputedStyle(details);
          const closedHeight =
            summary.getBoundingClientRect().height +
            parseFloat(cs.paddingTop) +
            parseFloat(cs.paddingBottom) +
            parseFloat(cs.borderTopWidth) +
            parseFloat(cs.borderBottomWidth);
          if (startHeight <= closedHeight + 1) {
            details.style.height = "";
            details.style.overflow = "";
            details.open = false;
            return;
          }

          details.style.overflow = "hidden";
          details.style.height = `${closedHeight}px`;
          const anim = details.animate(
            [{ height: `${startHeight}px` }, { height: `${closedHeight}px` }],
            { duration, easing },
          );
          tocDetailsAnimations.set(details, { anim, closing: true });
          void anim.finished
            .catch(() => {})
            .finally(() => {
              if (tocDetailsAnimations.get(details)?.anim !== anim) {
                return;
              }
              tocDetailsAnimations.delete(details);
              details.open = false;
              details.style.height = "";
              details.style.overflow = "";
            });
        }

        document.addEventListener("astro:before-swap", () => {
          if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = 0;
          }
          previousActiveId = null;
          clearTimeout(navigationTimer);
          navigationTimer = 0;
          dotAnimation?.cancel();
          resizeObserver?.disconnect();
          tocScrollController?.abort();
          tocScrollController = undefined;
          closeTocSheet(true);
          clearTocDetailsAnimation(activeTocDetails);
          activeTocDetails = null;
        });
        document.addEventListener("site:open-toc", () => {
          openTocSheet();
        });
        document.addEventListener("click", (event) => {
          if (event.target instanceof HTMLDialogElement && event.target.hasAttribute("data-toc-sheet")) {
            closeTocSheet();
            return;
          }

          if (event.target instanceof Element && event.target.closest("[data-toc-sheet-close]")) {
            closeTocSheet();
            return;
          }

          const jumpButton =
            event.target instanceof Element ? event.target.closest<HTMLElement>("[data-highlight-jump]") : null;
          if (jumpButton) {
            if (jumpButton.closest("[data-toc-sheet]")) {
              closeTocSheet(true);
            }
            const id = jumpButton.dataset.highlightJump;
            const scope = document.querySelector<HTMLElement>("[data-quote-scope]");
            if (id && scope) {
              const marks = scope.querySelectorAll<HTMLElement>(`mark[${HIGHLIGHT_ATTR}="${CSS.escape(id)}"]`);
              marks[0]?.scrollIntoView({
                behavior: reducedMotion.matches ? "auto" : "smooth",
                block: "center",
              });
              for (const mark of marks) {
                mark.setAttribute("data-highlight-flash", "");
              }
              window.setTimeout(() => {
                for (const mark of marks) {
                  mark.removeAttribute("data-highlight-flash");
                }
              }, 900);
            }
            const details = jumpButton.closest("details");
            if (details instanceof HTMLDetailsElement) {
              setTocDetailsOpen(details, false);
            }
            return;
          }

          const removeButton =
            event.target instanceof Element ? event.target.closest<HTMLElement>("[data-highlight-remove]") : null;
          if (removeButton) {
            const id = removeButton.dataset.highlightRemove;
            if (id) {
              removeHighlights(location.pathname, [id]);
            }
            return;
          }

          const summary =
            event.target instanceof Element
              ? event.target.closest("[data-toc-mobile-details] > summary")
              : null;
          if (summary) {
            const details = summary.parentElement;
            if (details instanceof HTMLDetailsElement) {
              event.preventDefault();
              const entry = tocDetailsAnimations.get(details);
              const isOpen = entry ? !entry.closing : details.open;
              setTocDetailsOpen(details, !isOpen);
            }
            return;
          }

          const target = event.target instanceof Element ? event.target.closest("[data-toc-link]") : null;
          if (!(target instanceof HTMLAnchorElement) || event.defaultPrevented || event.button !== 0 ||
            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            return;
          }
          const id = target.getAttribute("data-toc-link");
          if (!id || !document.getElementById(id)) {
            return;
          }

          // Keep the clicked destination selected while native smooth scrolling passes other headings.
          clearTimeout(navigationTimer);
          navigationTimer = window.setTimeout(finishNavigation, 150);
          previousActiveId = id;
          setActive(Array.from(document.querySelectorAll("[data-toc-link]")), id, event.detail > 0);
          if (target.closest("[data-toc-sheet]")) {
            closeTocSheet(true);
          }
          const details = target.closest("details");
          if (details instanceof HTMLDetailsElement) {
            setTocDetailsOpen(details, false);
          }
        });
        initialize();
      </script>
