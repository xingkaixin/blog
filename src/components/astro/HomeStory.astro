---
import { getImage, Image } from "astro:assets";
import hello from "@/assets/footer/hello.png";
import building from "@/assets/footer/building.png";
import photography from "@/assets/footer/photography.png";
import feifei from "@/assets/about/feifei-angel.png";
import wallArt from "@/assets/page-backgrounds/photography.png";
import AboutCharacter from "./AboutCharacter.astro";
import AboutIntro from "./AboutIntro.astro";
import ContactCard from "./ContactCard.astro";
import KoiPond from "./KoiPond.astro";
import RecordPlayer from "./RecordPlayer.astro";
import SiteCredits from "./SiteCredits.astro";
import { SignatureAnimation } from "@/components/signature-animation";
import { localeFromPath } from "@/lib/i18n";
import { homeMessages } from "@/lib/messages/home";
import { siteContacts, siteCopy } from "@/lib/site";

const locale = localeFromPath(Astro.url.pathname);
const t = homeMessages[locale];
const contacts = Object.values(siteContacts);
// 唱片旁的琴键：F4–F6 两个八度，黑键压在相邻白键的接缝上
const keyRange = Array.from({ length: 25 }, (_, index) => 65 + index);
const blackPitches = new Set([1, 3, 6, 8, 10]);
const whiteKeys = keyRange.filter((midi) => !blackPitches.has(midi % 12));
const blackKeys = keyRange.filter((midi) => blackPitches.has(midi % 12));
const scenes = (["living-room", "say-hello", "credits", "pond"] as const).map((id) => ({ id, label: t.scenes[id] }));
// 夏天白天是树影，到了片尾的夜色换成萤火
const seasonLabels = [
  { id: "spring", label: t.seasons["spring"], glyph: "M7 12.5C4 11 2.4 8.6 2.6 6 2.8 3.8 4.2 2.2 5.6 2.4 6.3 2.5 6.7 3.1 7 3.8 7.3 3.1 7.7 2.5 8.4 2.4 9.8 2.2 11.2 3.8 11.4 6 11.6 8.6 10 11 7 12.5Z" },
  { id: "summer-day", label: t.seasons["summer-day"], glyph: "M2.5 11.5C2.5 6 6 2.5 11.5 2.5 11.5 8 8 11.5 2.5 11.5ZM2.5 11.5 8 6" },
  { id: "summer-night", label: t.seasons["summer-night"], glyph: "M7 5.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 1 0 0-3.6ZM7 1.5v1.6M7 10.9v1.6M1.5 7h1.6M10.9 7h1.6" },
  { id: "autumn", label: t.seasons["autumn"], glyph: "M7 12.5V8.2M7 8.2C4.2 8.2 1.8 6 1.6 3.4 4 2.8 5.6 3 6.4 2.6L7 4.6 7.6 2.6C8.4 3 10 2.8 12.4 3.4 12.2 6 9.8 8.2 7 8.2Z" },
  { id: "winter", label: t.seasons["winter"], glyph: "M7 1.5v11M2.2 4.2l9.6 5.6M2.2 9.8l9.6-5.6" },
];
// 首屏看不到这三位，滚动开始后才由脚本填入地址
const deferredSprites = await Promise.all(
  [
    { name: "building", image: building, widths: [640, 1280], sizes: "(max-width: 47.999rem) 27vh, 67vh" },
    { name: "walker", image: hello, widths: [400, 800], sizes: "(max-width: 47.999rem) 20vh, 44vh" },
    { name: "photographer", image: photography, widths: [400, 800], sizes: "(max-width: 47.999rem) 20vh, 40vh" },
  ].map(async ({ name, image, widths, sizes }) => ({
    name,
    sizes,
    image: await getImage({ src: image, widths, format: "webp" }),
  })),
);
---

<home-story>
  <div class="backdrop" aria-hidden="true">
    <div class="floor"></div>
    <Image
      src={wallArt}
      alt=""
      class="wall-art"
      data-story-art
      widths={[480, 960]}
      sizes="30vw"
      width={460}
      format="webp"
      loading="eager"
    />
    <div class="masthead" data-story-masthead>
      <SignatureAnimation client:load className="mt-0 justify-start text-ink-800" fontSize="inherit" />
    </div>
    <div class="night" data-story-night></div>
    <canvas class="season" data-story-season></canvas>
  </div>

  <div class="cast">
    <div class="sprite" data-sprite="sofa"><AboutCharacter /></div>
    {deferredSprites.map(({ name, sizes, image }) => (
      <img
        class="sprite"
        data-sprite={name}
        alt=""
        data-src={image.src}
        data-srcset={image.srcSet.attribute}
        sizes={sizes}
        width={image.attributes.width}
        height={image.attributes.height}
        decoding="async"
      />
    ))}
    <Image src={feifei} alt="" class="sprite" data-sprite="feifei" widths={[240, 480]} sizes="(max-width: 47.999rem) 8vh, 22vh" format="webp" loading="eager" />
    <nav class="rail story-rail" aria-label={t.railLabel}>
      {scenes.map((scene, index) => (
        <a href={`#${scene.id}`} data-story-rail aria-current={index === 0 ? "step" : undefined}>
          <span class="rail-label">{scene.label}</span>
          <span class="rail-dot" aria-hidden="true"></span>
        </a>
      ))}
    </nav>
    <div class="season-chip" data-season-chip hidden>
      {seasonLabels.map((season) => (
        <span class="season-label" data-season-label={season.id}>
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={season.glyph} /></svg>
          {season.label}
        </span>
      ))}
      <button type="button" aria-label={t.pauseSeason} aria-pressed="false">
        <svg data-icon="pause" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M4 3h2v8H4ZM8 3h2v8H8Z" /></svg>
        <svg data-icon="play" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M4.5 3 11 7l-6.5 4Z" /></svg>
      </button>
    </div>
  </div>

  <section id="living-room" class="scene room" data-story-scene>
    <div data-story-copy>
      <div class="room-copy">
        <div class="status-row">
          <span class="status-pill"><span aria-hidden="true"></span>{t.room.status}</span>
        </div>
        <AboutIntro />
        <p class="intro-extra">{t.room.extra}</p>
        <figure class="motto"><blockquote>{siteCopy[locale].motto}</blockquote></figure>
        <div class="record">
          <RecordPlayer />
          <p class="record-copy">
            <span class="record-title" data-idle>{t.room.recordIdle}</span>
            <span class="record-title" data-active>{t.room.recordActive}</span>
            <span class="record-hint" data-idle>{t.room.recordHint}</span>
            <span class="record-hint" data-active>{t.room.recordJam}</span>
            <span class="record-keys" aria-hidden="true">
              {whiteKeys.map((midi) => <i data-key={midi}></i>)}
              {blackKeys.map((midi) => <b data-key={midi} style={`--seam: ${(whiteKeys.indexOf(midi - 1) + 1) / whiteKeys.length}`}></b>)}
            </span>
          </p>
        </div>
      </div>
      <span class="cue" aria-hidden="true">
        {t.room.cue}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </span>
    </div>
  </section>

  <section id="say-hello" class="scene hello" data-story-scene>
    <div class="hello-copy" data-story-copy>
      <div class="bubble">
        <h2>{t.hello.title}</h2>
        <p>{t.hello.text}</p>
      </div>
      <div class="contacts">
        {contacts.map((contact) => <ContactCard contact={contact} />)}
      </div>
    </div>
  </section>

  <section id="credits" class="scene credits story-night" data-story-scene>
    <div class="credits-copy" data-story-copy>
      <SiteCredits />
    </div>
  </section>

  <section id="pond" class="scene pond story-night" data-story-scene>
    <div class="pond-copy" data-story-copy>
      <h2>{t.pond.title}</h2>
      <p>{t.pond.text}</p>
    </div>
    <div class="pond-water"><KoiPond /></div>
  </section>
</home-story>

<style>
  home-story {
    /* 站点页眉 60px 加 1px 底边；脚本会按实际高度覆盖 */
    --stage-top: 61px;
    --stage-h: calc(100dvh - var(--stage-top));
    --gutter: clamp(20px, 4vw, 56px);
    position: relative;
    display: block;
    isolation: isolate;
  }

  /* 背景与角色两层都吸附在页眉下方；负外边距让后面的场景从同一起点开始排布 */
  .backdrop, .cast {
    position: sticky;
    top: var(--stage-top);
    height: var(--stage-h);
    margin-bottom: calc(-1 * var(--stage-h));
    overflow: hidden;
    container-type: size;
  }
  .backdrop {
    z-index: 0;
    pointer-events: none;
    background-color: var(--bg);
    background-image: radial-gradient(color-mix(in srgb, var(--ink-800) 8%, transparent) 1px, transparent 1.4px);
    background-size: 20px 20px;
  }
  .floor { position: absolute; inset: auto 0 0; height: 15cqh; border-top: 1px solid var(--line); background: var(--ink-50); }
  :global([data-theme="dark"]) .floor { background: #101412; }
  .wall-art { position: absolute; top: 9cqh; right: 2vw; width: min(30vw, 460px); height: auto; opacity: calc(.16 * var(--art-fade, 1)); }
  :global([data-theme="dark"]) .wall-art { opacity: calc(.22 * var(--art-fade, 1)); }
  .masthead {
    position: absolute;
    top: 13cqh;
    left: var(--gutter);
    margin: 0;
    font-size: clamp(56px, 13.2vw, 190px);
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink-800);
  }
  .night {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-color: #0a0d0c;
    background-image: radial-gradient(rgb(255 255 255 / .5) 1px, transparent 1.6px), radial-gradient(rgb(255 255 255 / .28) 1px, transparent 1.6px);
    background-size: 173px 131px, 251px 197px;
    background-position: 13px 29px, 97px 61px;
  }
  .season { position: absolute; inset: 0; width: 100%; height: 100%; }

  .cast { z-index: 2; pointer-events: none; }
  .sprite {
    position: absolute;
    left: var(--xw);
    bottom: var(--bw);
    height: var(--hw);
    width: auto;
    translate: -50% 0;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  [data-sprite="sofa"] { --xw: 68%; --xn: 56%; --hw: 64cqh; --hn: 22cqh; --bw: 3cqh; --bn: 2cqh; aspect-ratio: 1160 / 970; }
  [data-sprite="walker"] { --hw: 66cqh; --hn: 30cqh; --bw: 2cqh; --bn: 1cqh; opacity: 0; }
  [data-sprite="building"] { --hw: 56cqh; --hn: 22cqh; --bw: 4cqh; --bn: 2cqh; opacity: 0; }
  [data-sprite="photographer"] { --hw: 60cqh; --hn: 30cqh; --bw: -1cqh; --bn: 0px; opacity: 0; }
  [data-sprite="feifei"] { --xw: calc(68% + 28cqh); --xn: calc(56% + 9.6cqh); --hw: 27cqh; --hn: 9.5cqh; --bw: 4cqh; --bn: 2cqh; }

  .rail { position: absolute; right: 20px; top: 50%; translate: 0 -50%; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; pointer-events: auto; }
  .rail a { display: flex; align-items: center; gap: 10px; height: 30px; color: var(--ink-400); font-size: 11px; font-weight: 500; }
  .rail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .rail-label { opacity: 0; translate: 4px 0; white-space: nowrap; transition: opacity 150ms ease-out, translate 150ms ease-out; }
  .rail-dot { width: 8px; height: 8px; border-radius: 9999px; background: var(--ink-200); transition: height 200ms var(--ease-smooth-out), background-color 200ms; }
  .rail a[aria-current] { color: var(--ink-800); }
  .rail a[aria-current] .rail-dot { height: 22px; background: var(--accent); }
  .rail a[aria-current] .rail-label, .rail a:hover .rail-label, .rail a:focus-visible .rail-label { opacity: 1; translate: 0; }

  .season-chip { position: absolute; top: 20px; right: 20px; align-items: center; gap: 7px; height: 32px; padding: 0 4px 0 11px; border: 1px solid var(--line); border-radius: 9999px; background: var(--surface); color: var(--ink-500); font-size: 11px; font-weight: 500; pointer-events: auto; }
  .season-chip:not([hidden]) { display: flex; }
  .season-label { display: none; align-items: center; gap: 7px; }
  .season-label svg { width: 14px; height: 14px; color: var(--accent); }
  home-story[data-season="spring"] [data-season-label="spring"],
  home-story[data-season="summer"]:not([data-night]) [data-season-label="summer-day"],
  home-story[data-season="summer"][data-night] [data-season-label="summer-night"],
  home-story[data-season="autumn"] [data-season-label="autumn"],
  home-story[data-season="winter"] [data-season-label="winter"] { display: inline-flex; }
  .season-chip button { position: relative; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 9999px; background: var(--ink-50); color: var(--ink-700); cursor: pointer; }
  /* 视觉上 24px，点击区域扩到 44px */
  .season-chip button::after { content: ""; position: absolute; inset: -10px; }
  .season-chip button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .season-chip button svg { width: 12px; height: 12px; }
  .season-chip [data-icon="play"], .season-chip [aria-pressed="true"] [data-icon="pause"] { display: none; }
  .season-chip [aria-pressed="true"] [data-icon="play"] { display: block; }

  .scene { position: relative; z-index: 1; box-sizing: border-box; min-height: var(--stage-h); padding: 96px var(--gutter) 64px; scroll-margin-top: var(--stage-top); }
  h2 { margin: 0; font-family: var(--font-display); font-size: 30px; line-height: 36px; font-weight: 400; color: var(--ink-800); }

  .room-copy { display: flex; flex-direction: column; gap: 20px; max-width: 520px; }
  .status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .status-pill { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; border: 1px solid var(--line); border-radius: 9999px; background: var(--surface); color: var(--ink-500); font-size: 11px; font-weight: 500; }
  .status-pill > span { width: 6px; height: 6px; border-radius: 9999px; background: var(--accent); }
  .intro-extra { margin: 0; font-size: 15px; line-height: 27px; color: var(--ink-500); }
  .motto { position: relative; align-self: flex-start; max-width: 420px; margin: 2px 0 0; padding: 16px 20px 16px 40px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); box-shadow: var(--shadow-card); rotate: -1.2deg; }
  .motto::before { content: ""; position: absolute; top: 12px; bottom: 12px; left: 22px; border-left: 1px dashed var(--ink-200); }
  .motto::after { content: ""; position: absolute; top: -9px; left: calc(50% - 32px); width: 64px; height: 18px; background: color-mix(in srgb, var(--accent) 20%, transparent); rotate: 2deg; }
  .motto blockquote { margin: 0; font-size: 14px; line-height: 24px; color: var(--ink-700); }
  .record { display: flex; align-items: flex-end; gap: 14px; }
  .record-copy { display: flex; flex-direction: column; gap: 2px; margin: 0; padding-bottom: 6px; }
  .record-title { font-size: 13px; line-height: 18px; font-weight: 500; color: var(--ink-800); }
  .record-hint { font-size: 12px; line-height: 17px; color: var(--ink-500); }
  .record [data-active], .record:has(record-player[data-playing]) [data-idle] { display: none; }
  .record:has(record-player[data-playing]) [data-active] { display: inline; }
  .record-keys { position: relative; display: none; width: 120px; height: 16px; margin-top: 4px; }
  .record:has(record-player[data-playing]) .record-keys { display: flex; }
  .record-keys i { flex: 1; border: 1px solid var(--ink-300); border-left-width: 0; background: var(--surface); }
  .record-keys i:first-child { border-left-width: 1px; border-radius: 3px 0 0 3px; }
  .record-keys i:last-of-type { border-radius: 0 3px 3px 0; }
  .record-keys b { position: absolute; top: 0; left: calc(var(--seam) * 100% - 2.5px); width: 5px; height: 9px; border-radius: 0 0 1.5px 1.5px; background: var(--ink-700); }
  .record-keys [data-lit] { background: var(--accent); }
  .cue { position: absolute; left: var(--gutter); bottom: 28px; display: inline-flex; align-items: center; gap: 8px; color: var(--ink-500); font-size: 12px; font-weight: 500; }
  .cue svg { width: 14px; height: 14px; animation: nudge 1.8s ease-in-out infinite; }
  @keyframes nudge { 50% { translate: 0 4px; } }

  .hello, .credits { display: flex; align-items: center; }
  .hello-copy { display: flex; flex-direction: column; gap: 18px; width: min(480px, 46%); margin-left: 46%; }
  .bubble { position: relative; align-self: flex-start; padding: 18px 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-card); }
  .bubble::before { content: ""; position: absolute; left: -8px; top: 26px; width: 14px; height: 14px; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); rotate: 45deg; }
  .bubble p { margin: 6px 0 0; font-size: 14px; line-height: 23px; color: var(--ink-500); }
  .contacts { padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow-card); }
  .contacts > :global(:last-child) { border-bottom: 0; }

  .credits-copy { display: flex; flex-direction: column; gap: 12px; width: 40%; }
  home-story[data-rolling] :global(.roll) { animation-play-state: running; }

  .pond { display: flex; flex-direction: column; gap: 32px; }
  .pond-copy { display: flex; flex-direction: column; gap: 10px; max-width: 520px; }
  .pond-copy p { margin: 0; font-size: 14px; line-height: 23px; color: var(--ink-500); }
  /* 池子世界是 3:1，取景框不能比它更扁，否则画布盖不满宽度 */
  .pond-water { height: max(calc(var(--stage-h) * .6), 33.4vw); margin: auto calc(-1 * var(--gutter)) 0; }

  /* 脚本未运行时没有夜幕，夜景场景自己铺底色以保证文字可读 */
  home-story:not([data-ready]) .story-night { background: #0a0d0c; }

  @media (max-width: 47.999rem) {
    .sprite { left: var(--xn); bottom: var(--bn); height: var(--hn); }
    .scene { padding: 48px 20px 34dvh; }
    .hello-copy, .credits-copy { width: 100%; margin-left: 0; }
    .wall-art, .rail, .cue, .intro-extra, .bubble::before { display: none; }
    .season-chip { top: 12px; right: 12px; }
    .pond-water { height: calc(var(--stage-h) * .42); }
  }

  .room { padding-top: calc(var(--stage-h) * .13 + clamp(56px, 13.2vw, 190px) * 1.2 + 16px); }
  .pond { padding-bottom: 0; }

  @media (prefers-reduced-motion: reduce) {
    .cue svg { animation: none; }
    .rail-label, .rail-dot { transition: none; }
    .season-chip:not([hidden]) { display: none; }
  }
</style>

<script>
  import type { RecordNote } from "@/lib/home-score";
  import { isSeason, seasonAt } from "@/lib/season";
  import type { SeasonBackdrop } from "@/lib/season-backdrop";

  type Key = number[];
  type Sprite = { keys: Key[]; steps?: number; lift?: number };

  // 关键帧：[进度, 宽屏 x %, 宽屏 x cqh, 窄屏 x %, 窄屏 x cqh, 透明度]。四个场景分别停在进度 0、1、2、3。
  const sprites: Record<string, Sprite> = {
    sofa: { keys: [[0, 68, 0, 56, 0, 1], [0.3, 68, 0, 56, 0, 1], [0.44, 72, 0, 59, 0, 0], [3, 72, 0, 59, 0, 0]] },
    walker: {
      keys: [
        [0, 68, -9.9, 56, -3.4, 0], [0.28, 68, -9.9, 56, -3.4, 0], [0.4, 66, -9.9, 55, -3.4, 1],
        [0.9, 20, 0, 72, 0, 1], [1.25, 20, 0, 72, 0, 1], [1.8, 72, 0, 62, 0, 1], [1.88, 72, 0, 62, 0, 0],
        [2.14, 72, 0, 62, 0, 0], [2.24, 70, 0, 60, 0, 1], [2.82, 14, 0, 22, 0, 1], [2.9, 14, 0, 22, 0, 0], [3, 14, 0, 22, 0, 0],
      ],
      steps: 7,
      lift: 9,
    },
    building: {
      keys: [[0, 72, 0, 62, 0, 0], [1.8, 72, 0, 62, 0, 0], [1.9, 72, 0, 62, 0, 1], [2.12, 72, 0, 62, 0, 1], [2.22, 72, 0, 62, 0, 0], [3, 72, 0, 62, 0, 0]],
    },
    photographer: { keys: [[0, 14, 0, 22, 0, 0], [2.82, 14, 0, 22, 0, 0], [2.92, 14, 0, 22, 0, 1], [3, 14, 0, 22, 0, 1]] },
    feifei: {
      keys: [
        [0, 68, 28, 56, 9.6, 1], [0.45, 68, 28, 56, 9.6, 1], [1, 20, -21, 72, -12, 1], [1.35, 20, -21, 72, -12, 1],
        [1.95, 72, -34, 62, -13, 1], [2.28, 72, -34, 62, -13, 1], [2.95, 14, 22, 22, 11, 1], [3, 14, 22, 22, 11, 1],
      ],
      steps: 5,
      lift: 14,
    },
  };

  function smooth(from: number, to: number, value: number) {
    const x = Math.min(1, Math.max(0, (value - from) / (to - from)));
    return x * x * (3 - 2 * x);
  }

  function track(keys: Key[], progress: number) {
    let index = 0;
    while (index < keys.length - 2 && progress > keys[index + 1][0]) {
      index++;
    }
    const from = keys[index];
    const to = keys[index + 1];
    const raw = Math.min(1, Math.max(0, (progress - from[0]) / (to[0] - from[0])));
    const eased = raw * raw * (3 - 2 * raw);
    return {
      value: from.map((n, k) => n + (to[k] - n) * eased),
      raw,
      moving: raw > 0 && raw < 1 && (from[1] !== to[1] || from[2] !== to[2]),
      direction: Math.sign(to[1] - from[1]),
    };
  }

  const seasonPausedKey = "season-backdrop-paused";

  function readSeasonPaused() {
    try {
      return localStorage.getItem(seasonPausedKey) === "1";
    } catch {
      return false;
    }
  }

  function writeSeasonPaused(paused: boolean) {
    try {
      if (paused) {
        localStorage.setItem(seasonPausedKey, "1");
      } else {
        localStorage.removeItem(seasonPausedKey);
      }
    } catch {
      // 隐私模式或禁用存储时只在本次访问内生效
    }
  }

  class HomeStory extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const scenes = [...this.querySelectorAll<HTMLElement>("[data-story-scene]")];
      const copies = scenes.map((scene) => scene.querySelector<HTMLElement>("[data-story-copy]")!);
      const links = [...this.querySelectorAll<HTMLAnchorElement>("[data-story-rail]")];
      const cast = [...this.querySelectorAll<HTMLElement>("[data-sprite]")].map((element) => ({
        element,
        sprite: sprites[element.dataset.sprite!],
      }));
      const masthead = this.querySelector<HTMLElement>("[data-story-masthead]")!;
      const art = this.querySelector<HTMLElement>("[data-story-art]")!;
      const night = this.querySelector<HTMLElement>("[data-story-night]")!;
      const seasonCanvas = this.querySelector<HTMLCanvasElement>("[data-story-season]")!;
      const seasonChip = this.querySelector<HTMLElement>("[data-season-chip]")!;
      const seasonToggle = seasonChip.querySelector("button")!;
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      let deferred = [...this.querySelectorAll<HTMLImageElement>("img[data-srcset]")];
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const events = new AbortController();
      // 开发时用 ?season=winter 预览其他季节
      const previewSeason = import.meta.env.DEV ? new URLSearchParams(location.search).get("season") : null;
      const season = isSeason(previewSeason) ? previewSeason : seasonAt(new Date());
      const recordPlayer = this.querySelector<HTMLElement>("record-player");
      const turntable = recordPlayer?.querySelector("button");
      const keys = new Map(
        [...this.querySelectorAll<HTMLElement>("[data-key]")].map((key) => [Number(key.dataset.key), key]),
      );
      const keyTimers = new Map<HTMLElement, number>();
      let backdrop: SeasonBackdrop | null = null;
      let tap: { x: number; y: number } | null = null;
      let seasonPaused = readSeasonPaused();
      let nightAmount = 0;
      let stageTop = 0;
      let tops: number[] = [];
      let active = -1;
      let frame = 0;

      const measure = () => {
        stageTop = header?.offsetHeight ?? 0;
        this.style.setProperty("--stage-top", `${stageTop}px`);
        tops = scenes.map((scene) => scene.getBoundingClientRect().top + scrollY - stageTop);
      };

      const progress = () => {
        let value = 0;
        for (let k = 0; k < tops.length - 1; k++) {
          if (scrollY >= tops[k]) {
            value = k + Math.min(1, (scrollY - tops[k]) / (tops[k + 1] - tops[k]));
          }
        }
        return value;
      };

      const render = () => {
        frame = 0;
        const p = progress();
        const still = reducedMotion.matches;
        if (p > 0 && deferred.length) {
          for (const image of deferred) {
            image.srcset = image.dataset.srcset!;
            image.src = image.dataset.src!;
          }
          deferred = [];
        }
        for (const { element, sprite } of cast) {
          const { value, raw, moving, direction } = track(sprite.keys, p);
          const bob = moving ? -Math.abs(Math.sin(raw * Math.PI * (sprite.steps ?? 0))) * (sprite.lift ?? 0) : 0;
          element.style.setProperty("--xw", `calc(${value[1]}% + ${value[2]}cqh)`);
          element.style.setProperty("--xn", `calc(${value[3]}% + ${value[4]}cqh)`);
          element.style.opacity = String(value[5]);
          if (element.dataset.sprite === "sofa") {
            element.inert = value[5] < 0.05;
          }
          element.style.transform = still ? "" : `translateY(${bob}px) rotate(${moving ? direction * 2 : 0}deg)`;
        }
        masthead.style.opacity = String(1 - smooth(0.12, 0.55, p));
        masthead.style.transform = still ? "" : `translateY(${-Math.min(p, 1) * 40}cqh)`;
        art.style.setProperty("--art-fade", String(1 - smooth(0.2, 0.7, p)));
        nightAmount = smooth(1.3, 1.75, p);
        night.style.opacity = String(nightAmount);
        backdrop?.setNight(nightAmount);

        const reveal = (copy: HTMLElement, from: number, to: number, leaveFrom?: number, leaveTo?: number) => {
          const enter = smooth(from, to, p);
          const leave = leaveFrom === undefined || leaveTo === undefined ? 0 : smooth(leaveFrom, leaveTo, p);
          copy.style.opacity = String(enter * (1 - leave));
          copy.style.transform = still ? "" : `translateY(${(1 - enter) * 40}px)`;
        };
        copies[0].style.opacity = String(1 - smooth(0.35, 0.75, p));
        reveal(copies[1], 0.55, 0.92, 1.3, 1.62);
        reveal(copies[2], 1.55, 1.92, 2.3, 2.6);
        reveal(copies[3], 2.6, 2.92);

        this.toggleAttribute("data-night", p > 1.55);
        this.toggleAttribute("data-rolling", p > 1.7 && p < 2.5);
        const current = Math.min(scenes.length - 1, Math.max(0, Math.round(p)));
        if (current !== active) {
          active = current;
          links.forEach((link, index) => {
            if (index === current) {
              link.setAttribute("aria-current", "step");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        }
      };

      const schedule = () => {
        frame ||= requestAnimationFrame(render);
      };
      const refresh = () => {
        measure();
        schedule();
      };

      const syncSeasonMotion = () => {
        seasonToggle.setAttribute("aria-pressed", String(seasonPaused));
        backdrop?.setPaused(seasonPaused || reducedMotion.matches);
      };

      addEventListener("scroll", schedule, { passive: true, signal: events.signal });
      reducedMotion.addEventListener("change", schedule, { signal: events.signal });
      reducedMotion.addEventListener("change", syncSeasonMotion, { signal: events.signal });
      seasonToggle.addEventListener(
        "click",
        () => {
          seasonPaused = !seasonPaused;
          writeSeasonPaused(seasonPaused);
          syncSeasonMotion();
        },
        { signal: events.signal },
      );
      const lightKey = (midi: number, ms: number) => {
        let folded = midi;
        while (folded < 65) {
          folded += 12;
        }
        while (folded > 89) {
          folded -= 12;
        }
        const key = keys.get(folded);
        if (!key) {
          return;
        }
        key.toggleAttribute("data-lit", true);
        clearTimeout(keyTimers.get(key));
        keyTimers.set(key, window.setTimeout(() => key.removeAttribute("data-lit"), ms));
      };
      // 唱片在季节画布上的位置；唱片滚出画面后不再发粒子
      const vinyl = () => {
        if (!turntable) {
          return null;
        }
        const canvas = seasonCanvas.getBoundingClientRect();
        const box = turntable.getBoundingClientRect();
        const y = box.top - canvas.top + (box.height * 59) / 132;
        if (y < 0 || y > canvas.height) {
          return null;
        }
        return { x: box.left - canvas.left + (box.width * 64) / 160, y, radius: (box.width * 40) / 160 };
      };
      this.addEventListener(
        "record-note",
        (event) => {
          const { midi, velocity, duration, jam } = (event as CustomEvent<RecordNote>).detail;
          lightKey(midi, Math.min(900, duration * 1000));
          const weight = Math.min(1, Math.max(0, (velocity - 0.45) / 0.47));
          if (jam) {
            if (tap) {
              backdrop?.emit(tap.x, tap.y, 0.15, weight);
            }
            return;
          }
          const record = vinyl();
          if (record) {
            const angle = -0.55 - Math.random() * 0.5;
            const lift = Math.min(1, Math.max(0, (midi - 64) / 24));
            backdrop?.emit(record.x + Math.cos(angle) * record.radius, record.y + Math.sin(angle) * record.radius, lift, weight);
          }
        },
        { signal: events.signal },
      );
      this.addEventListener(
        "record-beat",
        (event) => {
          const record = vinyl();
          if (record && (event as CustomEvent<number>).detail % 4 === 0) {
            backdrop?.ripple(record.x, record.y, record.radius * 0.9, record.radius * 3.2);
          }
        },
        { signal: events.signal },
      );
      scenes[0].addEventListener(
        "click",
        (event) => {
          const target = event.target as Element;
          if (
            !recordPlayer?.hasAttribute("data-playing") ||
            target.closest("a, button, input, textarea, select, label, record-player") ||
            !getSelection()?.isCollapsed
          ) {
            return;
          }
          const canvas = seasonCanvas.getBoundingClientRect();
          tap = { x: event.clientX - canvas.left, y: event.clientY - canvas.top };
          recordPlayer.dispatchEvent(new CustomEvent("record-jam", { detail: { height: 1 - tap.y / canvas.height } }));
          tap = null;
        },
        { signal: events.signal },
      );

      const resizeObserver = new ResizeObserver(refresh);
      resizeObserver.observe(this);
      this.dataset.season = season;
      syncSeasonMotion();
      measure();
      render();
      this.setAttribute("data-ready", "");
      void import("@/lib/season-backdrop").then(({ createSeasonBackdrop }) => {
        if (events.signal.aborted) {
          return;
        }
        backdrop = createSeasonBackdrop(seasonCanvas, season, seasonPaused || reducedMotion.matches);
        if (backdrop) {
          backdrop.setNight(nightAmount);
          seasonChip.hidden = false;
        }
      });
      this.cleanup = () => {
        events.abort();
        resizeObserver.disconnect();
        cancelAnimationFrame(frame);
        keyTimers.forEach((timer) => clearTimeout(timer));
        backdrop?.destroy();
        backdrop = null;
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get("home-story")) {
    customElements.define("home-story", HomeStory);
  }
</script>
