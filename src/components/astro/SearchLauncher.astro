---
import { localeFromPath } from "@/lib/i18n";
import { chromeMessages } from "@/lib/messages/chrome";
import { siteShortcuts } from "@/lib/site-shortcuts";

const t = chromeMessages[localeFromPath(Astro.url.pathname)];
---

<button
  type="button"
  data-search-trigger
  class="group flex h-9 min-w-0 flex-1 items-center gap-2 rounded-[8px] border border-line bg-paper px-2.5 text-left transition-[border-color,background-color] hover:border-ink-300 hover:bg-ink-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 sm:px-3"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    class="h-3.5 w-3.5 shrink-0 text-ink-400"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <span class="min-w-0 flex-1 truncate font-mono text-xs text-ink-400 sm:hidden">
    {t.searchShort}
  </span>
  <span class="hidden min-w-0 flex-1 truncate font-mono text-xs text-ink-400 sm:block">
    {t.searchLong}
  </span>
  <kbd
    class="hidden shrink-0 rounded-[4px] border border-ink-200 bg-surface px-1.5 py-0.5 font-mono text-[10px] font-normal text-ink-400 sm:inline-flex"
  >
    {siteShortcuts.search.hint}
  </kbd>
</button>
<div data-search-root>
  <div
    data-search-error
    role="alert"
    hidden
    class="fixed inset-x-4 top-20 z-50 rounded-lg border border-line bg-surface p-4 text-sm text-ink-600 shadow-lg sm:left-auto sm:right-6"
  >
    <p>{t.searchLoadFailed}</p>
    <div class="mt-2 flex gap-4">
      <button type="button" data-search-trigger class="text-accent underline">{t.retry}</button>
      <button type="button" data-search-reload class="text-accent underline">{t.reloadPage}</button>
    </div>
  </div>
</div>

<script>
  import { openSearch } from "@/lib/search-launcher";

  document.addEventListener("click", (event) => {
    if ((event.target as Element | null)?.closest("[data-search-trigger]")) {
      void openSearch();
    } else if ((event.target as Element | null)?.closest("[data-search-reload]")) {
      window.location.reload();
    }
  });
</script>
