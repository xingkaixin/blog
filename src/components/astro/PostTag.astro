---
import { tagHref } from "@/lib/post-tags";

type Props = {
  tag: string;
  linked: boolean;
};

const { tag, linked } = Astro.props;
const className =
  "inline-flex items-center rounded-[5px] border border-line bg-surface px-1.5 py-1 font-mono text-[10px] tracking-[0.03em] text-ink-500";
---

{
  linked ? (
    <a
      href={tagHref(tag)}
      class={`${className} transition-colors duration-(--duration-quick) hover:border-accent/40 hover:text-accent`}
    >
      {tag}
    </a>
  ) : (
    <span class={className}>{tag}</span>
  )
}
