---
import type { FooterScene } from "@/lib/footer-scene";
import { localeFromPath, translatedPath } from "@/lib/i18n";
import { chromeMessages } from "@/lib/messages/chrome";
import { siteShortcuts } from "@/lib/site-shortcuts";
import { stamps } from "@/lib/stamps";

type Props = { currentPath: string; stage?: boolean };
const { currentPath, stage = true } = Astro.props;
const t = chromeMessages[localeFromPath(currentPath)];
const basePath = translatedPath(currentPath, "zh") ?? currentPath;
const scene: FooterScene = basePath.startsWith("/photos")
  ? "photography"
  : basePath === "/projects/"
    ? "building"
    : basePath === "/rss/"
      ? "rss"
      : "writing";
const content = t.footer[scene];
---

<footer class="scene-footer print:hidden" data-scene={scene} data-stage={stage ? "" : undefined}>
  {
    stage && (
      <div class="footer-stage">
        <div class="footer-copy">
          <p class="footer-title">{content.title}</p>
          <p class="footer-description">{content.text}</p>
        </div>
        <canvas class="footer-art" aria-hidden="true" />
      </div>
    )
  }
  <div class="footer-bottom">
    <button type="button" class="stamps-entry" data-open-stamps>
      {t.stamps.title} <span data-stamp-count>0</span>/{stamps.length}
    </button>
    <span class="shortcuts">{siteShortcuts.search.hint} {t.commandPalette} · {siteShortcuts.theme.hint} {t.flipWorld}</span>
  </div>
</footer>

<style>
  .scene-footer { position: relative; border-top: 1px solid var(--line); background: var(--ink-50); overflow: hidden; }
  .footer-stage { position: relative; }
  .footer-copy { position: absolute; z-index: 1; top: 40px; left: max(32px, calc((100% - 1056px) / 2 + 32px)); max-width: 24em; }
  .footer-title { margin: 0; font-family: var(--font-display); font-size: 30px; color: var(--ink-700); }
  .footer-description { margin: 8px 0 0; color: var(--ink-500); font-size: 13px; line-height: 1.8; }
  /* 与 footer-scene.ts 的 400/1440 设计比例一致，缩放上下限对应 0.62 与 1.15 */
  .footer-art { display: block; width: 100%; height: clamp(248px, 27.78vw, 460px); }
  .footer-bottom { display: flex; max-width: 1280px; margin: auto; padding: 12px 32px; font-family: var(--font-mono); font-size: 10px; color: var(--ink-500); }
  .shortcuts { margin-left: auto; }
  .stamps-entry { position: relative; border-radius: 3px; font: inherit; color: inherit; cursor: pointer; transition: color var(--duration-quick) var(--ease-smooth-out); }
  .stamps-entry::before { content: ""; position: absolute; inset: -14px -8px; }
  .stamps-entry:hover { color: var(--accent); }
  .stamps-entry:focus-visible { outline: 2px solid color-mix(in oklab, var(--accent) 60%, transparent); outline-offset: 2px; }
  [data-stage] .footer-bottom {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: min(1056px, 100% - 32px);
    padding: 10px 16px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--ink-50) 62%, transparent);
    backdrop-filter: blur(8px);
    transform: translateX(-50%);
  }
  @media (max-width: 640px) {
    .footer-copy { position: static; padding: 28px 16px 0; }
    .footer-title { font-size: 23px; }
    .footer-description { font-size: 12px; }
    .footer-bottom { display: none; }
  }
</style>

<script>
  import type { FooterScene } from "@/lib/footer-scene";

  let handle: { setActive(on: boolean): void; destroy(): void } | null = null;
  let observer: IntersectionObserver | null = null;
  // 每次拆除都作废在途的挂载，避免动态 import 落地时页面已经切走
  let generation = 0;

  function teardown() {
    generation++;
    observer?.disconnect();
    observer = null;
    handle?.destroy();
    handle = null;
  }

  document.addEventListener("astro:page-load", () => {
    teardown();
    const canvas = document.querySelector<HTMLCanvasElement>(".footer-art");
    const footer = canvas?.closest<HTMLElement>(".scene-footer");
    if (!canvas || !footer) {
      return;
    }
    const mounting = generation;
    const scene = footer.dataset.scene as FooterScene;
    let visible = false;
    let loading = false;
    observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
        handle?.setActive(visible);
        if (!visible || handle || loading) {
          return;
        }
        loading = true;
        void import("@/lib/footer-scene").then(({ mountFooterScene }) => {
          if (mounting !== generation) {
            return;
          }
          const animate = !matchMedia("(prefers-reduced-motion: reduce)").matches;
          handle = mountFooterScene(canvas, scene, animate);
          handle.setActive(visible);
        });
      },
      { rootMargin: "200px 0px" },
    );
    observer.observe(footer);
  });
  document.addEventListener("astro:before-swap", teardown);
</script>
