---
import PostFilter from "@/components/astro/PostFilter.astro";
import PageArtwork from "@/components/astro/PageArtwork.astro";
import PostPreview from "@/components/astro/PostPreview.astro";
import { ProjectStickers } from "@/components/project-stickers";
import { resolveCover } from "@/lib/covers";
import { buildPostTaxonomy, relatedPosts } from "@/lib/post-tags";
import { postHref } from "@/lib/published-post";
import { groupPostsByMonth, type PostConsoleItem } from "@/lib/post-console";

type Props = {
  posts: PostConsoleItem[];
};

const { posts } = Astro.props;
const yearCounts = new Map<string, number>();
for (const post of posts) {
  const year = post.date.slice(0, 4);
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}
const years = [...yearCounts].map(([year, count]) => ({ value: year, label: year, count }));
const latestYear = years[0]?.value ?? "";
const months = groupPostsByMonth(posts);
const popularTags = buildPostTaxonomy(posts).tags
  .toSorted((left, right) => right.count - left.count || left.tag.localeCompare(right.tag, "zh-CN"))
  .slice(0, 9);
const totalWords = posts.reduce((sum, post) => sum + post.wordCount, 0);
const previewPost = posts[0];
---

<section data-post-console class="relative isolate mx-auto max-w-320">
  <div class="border-b border-line px-3 py-2 lg:hidden">
    <PostFilter
      layout="mobile"
      kind="year"
      label="年份"
      options={years}
      allLabel="全部年份"
      totalCount={posts.length}
      selected={latestYear}
      showCounts
    />
    <PostFilter
      layout="mobile"
      kind="tag"
      label="标签"
      options={popularTags.slice(0, 6).map(({ tag }) => ({ value: tag, label: tag }))}
      allLabel="全部"
    />
  </div>

  <div class="lg:grid lg:min-h-[calc(100dvh-90px)] lg:grid-cols-[220px_minmax(0,1fr)] xl:grid-cols-[220px_minmax(0,1fr)_300px]">
    <aside class="hidden border-r border-line px-[18px] py-5 lg:flex lg:flex-col lg:gap-6">
      <PostFilter
        layout="desktop"
        kind="year"
        label="年份"
        options={years}
        allLabel="全部"
        totalCount={posts.length}
        selected={latestYear}
        showCounts
      />
      <PostFilter
        layout="desktop"
        kind="tag"
        label="标签"
        options={popularTags.map(({ tag }) => ({ value: tag, label: tag }))}
        allLabel="全部"
      />

      <PageArtwork scene="writing" />

      <div class="mt-auto border-t border-line pt-4">
        <p class="font-mono text-[11px] leading-5 text-ink-500">
          {posts.length} 篇 · {totalWords.toLocaleString("zh-CN")} 字<br />
          最近更新 {posts[0]?.date ?? "-"}
        </p>
        <div class="relative mt-2.5 h-9 overflow-hidden">
          <ProjectStickers client:visible />
        </div>
      </div>
    </aside>

    <div class="min-w-0 py-2.5">
      <div class="flex items-center justify-between gap-3 border-b border-line px-3 pb-2.5 lg:px-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
          <span data-post-console-heading>全部文章</span> · 按时间倒序
        </p>
        <button
          type="button"
          data-post-months-toggle
          aria-expanded="false"
          class="rounded-[6px] px-2 py-1 font-mono text-[11px] text-ink-500 transition-colors hover:bg-ink-50 hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
        >
          全部展开
        </button>
      </div>

      <div
        data-post-console-list
        aria-label="文章日志"
      >
        {
          months.map((month, monthIndex) => (
            <details data-post-month={month.key} open={monthIndex === 0} class="group/month">
              <summary class="flex cursor-pointer list-none items-center gap-2 border-b border-line bg-paper px-3 py-2 font-mono text-[11px] text-ink-500 transition-colors hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/40 lg:px-5 [&::-webkit-details-marker]:hidden">
                <svg
                  aria-hidden="true"
                  class="h-3 w-3 shrink-0 transition-transform duration-(--duration-quick) group-open/month:rotate-90"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m9 6 6 6-6 6" />
                </svg>
                <span>{month.label}</span>
                <span data-post-month-count class="ml-auto">{month.posts.length} 篇</span>
              </summary>
              {
                month.posts.map((post) => {
                  const cover = resolveCover(post.cover);
                  return (
                    <a
                      data-post-row={post.slug}
                      data-post-date={post.date}
                      data-post-summary={post.summary}
                      data-post-tags={JSON.stringify(post.tags)}
                      data-post-cover-alt={post.coverAlt}
                      data-post-cover-mobile={cover.mobile}
                      data-post-cover-desktop={cover.desktop}
                      data-post-cover-width={cover.width}
                      data-post-cover-height={cover.height}
                      data-post-word-count={post.wordCount}
                      data-post-reading-minutes={post.readingMinutes}
                      data-active={post === posts[0] ? "" : undefined}
                      href={postHref(post.slug)}
                      class="post-row block border-b border-ink-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/40 data-active:bg-surface"
                    >
                      <span class="block px-3 py-3.5 lg:hidden">
                        <span class="flex items-center gap-2 font-mono text-[11px] text-ink-500">
                          <span>{post.date}</span>
                          {post.tags[0] && (
                            <>
                              <span class="text-ink-200">·</span>
                              <span class="text-accent">{post.tags[0]}</span>
                            </>
                          )}
                        </span>
                        <span class="mt-1 block text-[15px] leading-6 text-ink-800">{post.title}</span>
                      </span>

                      <span class="hidden items-center gap-3 px-5 py-2.5 lg:flex">
                        <span class="w-[80px] shrink-0 font-mono text-[11px] text-ink-500">{post.date}</span>
                        <span data-post-title class="min-w-0 flex-1 text-[14px] leading-6 text-ink-800">
                          {post.title}
                        </span>
                        <span class="hidden shrink-0 gap-1.5 2xl:flex">
                          {post.tags.slice(0, 1).map((tag) => (
                            <span class="rounded-[4px] border border-line bg-surface px-1.5 py-0.5 font-mono text-[11px] tracking-[0.04em] text-ink-500">
                              {tag}
                            </span>
                          ))}
                        </span>
                        <svg
                          aria-hidden="true"
                          class="post-open-arrow h-4 w-4 shrink-0 text-ink-500"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M5 12h14m-6-6 6 6-6 6" />
                        </svg>
                      </span>
                    </a>
                  );
                })
              }
            </details>
          ))
        }
      </div>

      <div data-post-console-empty hidden class="flex min-h-64 items-center justify-center px-6 text-center">
        <div>
          <p class="text-base text-ink-800">没有符合条件的文章</p>
          <button
            data-clear-tag
            type="button"
            class="mt-3 rounded-[6px] border border-line bg-surface px-3 py-2 text-sm text-ink-600"
          >
            清除标签筛选
          </button>
        </div>
      </div>
    </div>

    {
      previewPost && (
        <PostPreview post={previewPost} related={relatedPosts(posts, previewPost)} />
      )
    }
  </div>
</section>

<style>
  .post-open-arrow {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-open-arrow {
      transform: translateX(-4px);
      transition:
        opacity 140ms ease,
        transform 140ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .post-row:hover .post-open-arrow {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .post-row:focus-visible .post-open-arrow {
    opacity: 1;
    transform: none;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-open-arrow {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initializePostConsole } from "@/lib/post-console-browser";

  const initialize = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-post-console]")) {
      initializePostConsole(root);
    }
  };

  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
