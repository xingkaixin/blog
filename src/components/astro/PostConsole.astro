---
import PostFilter from "@/components/astro/PostFilter.astro";
import PageArtwork from "@/components/astro/PageArtwork.astro";
import PostPreview from "@/components/astro/PostPreview.astro";
import ProjectStickers from "@/components/astro/ProjectStickers.astro";
import { resolveCover } from "@/lib/covers";
import { localeFromPath, type Locale } from "@/lib/i18n";
import { postsMessages } from "@/lib/messages/posts";
import { buildPostTaxonomy, relatedPosts } from "@/lib/post-tags";
import { postHref } from "@/lib/published-post";
import { groupPostsByMonth, type PostConsoleItem } from "@/lib/post-console";

type Props = {
  posts: PostConsoleItem[];
  locale?: Locale;
};

const { posts, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = postsMessages[locale].console;
const yearCounts = new Map<string, number>();
for (const post of posts) {
  const year = post.date.slice(0, 4);
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}
const years = [...yearCounts].map(([year, count]) => ({ value: year, label: year, count }));
const latestYear = years[0]?.value ?? "";
const months = groupPostsByMonth(posts, locale);
const popularTags = buildPostTaxonomy(posts).tags
  .toSorted((left, right) => right.count - left.count || left.tag.localeCompare(right.tag, "zh-CN"))
  .slice(0, 9);
const previewPost = posts[0];
const consolePayload = posts.map((post) => {
  const cover = resolveCover(post.cover);
  const derivedMobile = cover.desktop.replace("-800.", "-400.");
  const derivedMobileAvif = cover.desktopAvif.replace("-800.", "-400.");
  return [
    post.slug,
    post.date,
    post.tags,
    "",
    post.coverAlt === post.title ? "" : post.coverAlt,
    cover.mobile === derivedMobile ? "" : cover.mobile,
    cover.desktop,
    cover.width,
    cover.height,
    post.wordCount,
    post.readingMinutes,
    cover.desktopAvif,
    cover.mobileAvif === derivedMobileAvif ? "" : cover.mobileAvif,
  ] as const;
});
const consoleDataJson = JSON.stringify(consolePayload).replaceAll("<", "\\u003c");
---

<section data-post-console class="relative isolate mx-auto max-w-320">
  <div class="border-b border-line px-3 py-2 lg:hidden">
    <PostFilter
      layout="mobile"
      kind="year"
      label={t.year}
      ariaLabel={t.filterAria(t.year)}
      options={years}
      allLabel={t.yearAllMobile}
      totalCount={posts.length}
      selected={latestYear}
      showCounts
    />
    <PostFilter
      layout="mobile"
      kind="tag"
      label={t.tag}
      ariaLabel={t.filterAria(t.tag)}
      options={popularTags.slice(0, 6).map(({ tag }) => ({ value: tag, label: tag }))}
      allLabel={t.tagAll}
    />
  </div>

  <div class="lg:grid lg:min-h-[calc(100dvh-90px)] lg:grid-cols-[220px_minmax(0,1fr)] xl:grid-cols-[220px_minmax(0,1fr)_300px]">
    <aside class="hidden border-r border-line px-[18px] py-5 lg:flex lg:flex-col lg:gap-6">
      <PostFilter
        layout="desktop"
        kind="year"
        label={t.year}
        ariaLabel={t.filterAria(t.year)}
        options={years}
        allLabel={t.yearAllDesktop}
        totalCount={posts.length}
        selected={latestYear}
        showCounts
      />
      <PostFilter
        layout="desktop"
        kind="tag"
        label={t.tag}
        ariaLabel={t.filterAria(t.tag)}
        options={popularTags.map(({ tag }) => ({ value: tag, label: tag }))}
        allLabel={t.tagAll}
      />

      <div class="relative flex flex-1 flex-col gap-6">
        <PageArtwork scene="writing" />

        <div class="mt-auto h-20"></div>

        <ProjectStickers />
      </div>
    </aside>

    <div class="min-w-0 py-2.5">
      <script type="application/json" data-post-console-data set:html={consoleDataJson}></script>
      <div class="flex items-center justify-between gap-3 border-b border-line px-3 pb-2.5 lg:px-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
          <span data-post-console-heading>{t.headingAll}</span>
        </p>
        <button
          type="button"
          data-post-months-toggle
          aria-expanded="false"
          class="rounded-[6px] px-2 py-1 font-mono text-[11px] text-ink-500 transition-colors hover:bg-ink-50 hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
        >
          {t.expandAll}
        </button>
      </div>

      <div
        data-post-console-list
        aria-label={t.listAria}
      >
        {
          months.map((month, monthIndex) => (
            <details
              data-post-month={month.key}
              open={monthIndex === 0}
              hidden={Boolean(latestYear && !month.key.startsWith(latestYear))}
              class="pc-m"
            >
              <summary class="pc-sum">
                <span>{month.label}</span>
                <span data-post-month-count class="ml-auto">{t.monthCount(month.posts.length)}</span>
              </summary>
              {
                month.posts.map((post) => (
                  <a
                    data-post-row={post.slug}
                    data-active={post === posts[0] ? "" : undefined}
                    href={postHref(post.slug, locale)}
                    class="post-row"
                  >
                    <span class="pc-in">
                      <span class="pc-meta">
                        <span>{post.date}</span>
                        {post.tags[0] && (
                          <>
                            <span class="pc-dot">·</span>
                            <span class="pc-mtag">{post.tags[0]}</span>
                          </>
                        )}
                      </span>
                      <span data-post-title class="pc-t">{post.title}</span>
                      {post.tags[0] && <span class="pc-g">{post.tags[0]}</span>}
                      <span aria-hidden="true" class="post-open-arrow">→</span>
                    </span>
                  </a>
                ))
              }
            </details>
          ))
        }
      </div>

      <div data-post-console-empty hidden class="flex min-h-64 items-center justify-center px-6 text-center">
        <div>
          <p class="text-base text-ink-800">{t.emptyTitle}</p>
          <button
            data-clear-tag
            type="button"
            class="mt-3 rounded-[6px] border border-line bg-surface px-3 py-2 text-sm text-ink-600"
          >
            {t.clearTag}
          </button>
        </div>
      </div>
    </div>

    {
      previewPost && (
        <PostPreview post={previewPost} related={relatedPosts(posts, previewPost)} locale={locale} />
      )
    }
  </div>
</section>

<style is:global>
  [data-post-console] .pc-sum {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-500);
    transition: color var(--duration-quick);
  }

  [data-post-console] .pc-sum::-webkit-details-marker {
    display: none;
  }

  [data-post-console] .pc-sum::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    flex-shrink: 0;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--duration-quick);
  }

  [data-post-console] .pc-m[open] > .pc-sum::before {
    transform: rotate(45deg);
  }

  [data-post-console] .pc-sum:hover {
    color: var(--ink-800);
  }

  [data-post-console] .pc-sum:focus-visible,
  [data-post-console] .post-row:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--accent) 40%, transparent);
  }

  [data-post-console] .post-row {
    display: block;
    border-bottom: 1px solid var(--ink-100);
  }

  [data-post-console] .post-row[data-active] {
    background: var(--surface);
  }

  [data-post-console] .pc-in {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 0.75rem;
  }

  [data-post-console] .pc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-500);
  }

  [data-post-console] .pc-dot {
    color: var(--ink-200);
  }

  [data-post-console] .pc-mtag {
    color: var(--accent);
  }

  [data-post-console] .pc-t {
    min-width: 0;
    flex: 1 1 0%;
    font-size: 15px;
    line-height: 1.5rem;
    color: var(--ink-800);
  }

  [data-post-console] .pc-g {
    display: none;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-500);
  }

  [data-post-console] .post-open-arrow {
    display: none;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1;
    color: var(--ink-500);
    opacity: 0;
  }

  @media (min-width: 64rem) {
    [data-post-console] .pc-sum {
      padding-inline: 1.25rem;
    }

    [data-post-console] .pc-in {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 1.25rem;
    }

    [data-post-console] .pc-meta {
      width: 80px;
      flex-shrink: 0;
    }

    [data-post-console] .pc-dot,
    [data-post-console] .pc-mtag {
      display: none;
    }

    [data-post-console] .pc-t {
      font-size: 14px;
    }

    [data-post-console] .post-open-arrow {
      display: block;
    }
  }

  @media (min-width: 96rem) {
    [data-post-console] .pc-g {
      display: inline-flex;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    [data-post-console] .post-open-arrow {
      transform: translateX(-4px);
      transition:
        opacity 140ms ease,
        transform 140ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-post-console] .post-row:hover .post-open-arrow {
      opacity: 1;
      transform: translateX(0);
    }
  }

  [data-post-console] .post-row:focus-visible .post-open-arrow {
    opacity: 1;
    transform: none;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-post-console] .post-open-arrow {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initializePostConsole } from "@/lib/post-console-browser";

  const initialize = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-post-console]")) {
      initializePostConsole(root);
    }
  };

  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
