---
/**
 * 屏保：桌面端访客无操作时淡入全屏锦鲤池。
 * 渲染代码在触发时才动态载入，退出后释放 WebGL 上下文。
 */
---

<template data-screensaver>
  <div class="screensaver" aria-hidden="true">
    <canvas class="screensaver-water"></canvas>
    <canvas class="screensaver-overlay"></canvas>
  </div>
</template>

<style>
  .screensaver {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    background: #0d2b2b;
    cursor: none;
    transition: opacity 1.5s var(--ease-smooth-out);
  }

  @starting-style {
    .screensaver {
      opacity: 0;
    }
  }

  .screensaver[data-leaving] {
    opacity: 0;
    transition-duration: var(--duration-fast);
  }

  .screensaver canvas {
    pointer-events: none;
  }

  /* 与 KoiPond 相同：宽度由高度和 aspect-ratio 推出，比 3:1 高的视口横向裁切。 */
  .screensaver-water {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    translate: -50% -50%;
    aspect-ratio: 3 / 1;
    height: 100%;
    width: auto;
  }

  .screensaver-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
