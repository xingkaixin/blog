---
type Props = { value: string };
const { value } = Astro.props;
---

<div class="tg-card">
  <span class="tg-plane">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 2 11 13" />
      <path d="M22 2 15 22l-4-9-9-4Z" />
    </svg>
  </span>
  <div class="tg-bubble">
    <p class="tg-handle">{value}</p>
    <p class="tg-msg">随时来聊：AI、摄影、数码。</p>
  </div>
</div>

<style>
  .tg-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    width: max-content;
  }

  .tg-plane {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #2aabee;
    color: #fff;
    box-shadow: 0 6px 14px -6px rgba(42, 171, 238, 0.6);
  }

  .tg-plane svg {
    width: 16px;
    height: 16px;
    transform: translate(-1px, 1px);
  }

  .tg-bubble {
    position: relative;
    padding: 0.625rem 0.875rem;
    background: #eaf5fd;
    border-radius: 1rem 1rem 1rem 0.25rem;
    box-shadow: 0 12px 28px -14px rgba(20, 21, 26, 0.35);
  }

  .tg-handle {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #2483b4;
  }

  .tg-msg {
    margin-top: 2px;
    font-size: 12px;
    color: #2e2f33;
    white-space: nowrap;
  }
</style>
