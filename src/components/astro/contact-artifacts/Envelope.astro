---
type Props = { value: string };
const { value } = Astro.props;
---

<div class="envelope">
  <div class="stamp">
    <div class="stamp-paper" />
    <img src="/avatar.webp" alt="" class="stamp-img" />
  </div>
  <div class="postmark">
    <span>SHANGHAI</span>
    <span>2026</span>
  </div>
  <div class="env-lines">
    <p class="env-to">TO</p>
    <p class="env-value">{value}</p>
  </div>
</div>

<style>
  .envelope {
    --paper-cream: #fdf9ee;
    --postal-blue: #3f5c9e;
    --postal-red: #c2402f;
    position: relative;
    isolation: isolate;
    box-shadow: var(--artifact-shadow);
    width: 16.5rem;
    padding: 1rem 1.125rem 1.125rem;
    background: var(--paper-cream);
    border: 6px solid;
    border-image: repeating-linear-gradient(
        45deg,
        var(--postal-red) 0 10px,
        var(--paper-cream) 10px 18px,
        var(--postal-blue) 18px 28px,
        var(--paper-cream) 28px 36px
      )
      6;
  }

  .envelope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at var(--pointer-x, 50%) var(--pointer-y, 50%), #fff9, transparent 75%);
    opacity: calc(var(--sheen, 0) * 0.3);
  }

  .stamp {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 1;
    width: 56px;
    height: 70px;
  }

  /* 邮票齿孔：白纸层被圆点网格镂空，孔距与尺寸对齐使孔心恰好落在四边；
     头像盖住内部的孔，只露出边缘的半孔 */
  .stamp-paper {
    position: absolute;
    inset: 0;
    background: #fff;
    -webkit-mask-image: radial-gradient(circle, transparent 1.6px, #000 1.7px);
    mask-image: radial-gradient(circle, transparent 1.6px, #000 1.7px);
    -webkit-mask-size: 7px 7px;
    mask-size: 7px 7px;
    -webkit-mask-position: -3.5px -3.5px;
    mask-position: -3.5px -3.5px;
  }

  .stamp-img {
    position: absolute;
    inset: 5px;
    width: calc(100% - 10px);
    height: calc(100% - 10px);
    object-fit: cover;
  }

  .stamp::after {
    content: "";
    position: absolute;
    inset: 5px;
    pointer-events: none;
    background:
      radial-gradient(ellipse at var(--pointer-x, 50%) var(--pointer-y, 50%), #fff9, transparent 65%),
      repeating-linear-gradient(125deg, #82ddd9 0%, #a5b8ed 15%, #edb9d5 30%, #f4dda1 45%, #a8dfc9 60%);
    background-size: 200% 200%;
    background-position: var(--pointer-x, 50%) var(--pointer-y, 50%);
    mix-blend-mode: hard-light;
    opacity: calc(var(--sheen, 0) * 0.7);
  }

  .postmark {
    position: absolute;
    top: 2.375rem;
    right: 3.25rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    width: 3.375rem;
    height: 3.375rem;
    border: 1.5px solid;
    border-radius: 50%;
    color: color-mix(in srgb, var(--postal-red) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 6px;
    letter-spacing: 0.05em;
    transform: rotate(-14deg);
  }

  .postmark::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in srgb, var(--postal-red) 45%, transparent);
    border-radius: 50%;
  }

  .postmark::after {
    content: "";
    position: absolute;
    left: 82%;
    top: 50%;
    width: 2.5rem;
    height: 13px;
    transform: translateY(-50%);
    background: repeating-linear-gradient(to bottom, currentColor 0 1.5px, transparent 1.5px 5.5px);
    opacity: 0.55;
  }

  .env-lines {
    margin-top: 2.5rem;
    color: #46474d;
  }

  .env-to {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.28em;
    color: #85868c;
  }

  .env-value {
    margin-top: 0.25rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px dashed #b4b4b6;
    font-family: var(--font-display);
    font-size: 1rem;
    color: #1b1c1f;
  }
</style>
