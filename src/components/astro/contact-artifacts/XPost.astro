---
import { siteConfig } from "@/lib/site";

type Props = { value: string };
const { value } = Astro.props;
---

<div class="x-card">
  <span class="x-logo">𝕏</span>
  <div class="x-head">
    <img src="/avatar.webp" alt="" class="x-avatar" />
    <div>
      <p class="x-name">{siteConfig.author}</p>
      <p class="x-handle">{value}</p>
    </div>
  </div>
  <p class="x-post">人生不该只有一种体验。</p>
</div>

<style>
  .x-card {
    position: relative;
    box-shadow: var(--artifact-shadow);
    width: 14.5rem;
    padding: 0.875rem 1rem;
    background: #fff;
    border: 1px solid #e6e4dd;
    border-radius: 1rem;
  }

  .x-logo {
    position: absolute;
    top: 0.75rem;
    right: 0.875rem;
    font-size: 14px;
    color: #1b1c1f;
  }

  .x-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .x-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .x-name {
    font-size: 12px;
    font-weight: 600;
    color: #1b1c1f;
  }

  .x-handle {
    font-size: 11px;
    color: #85868c;
  }

  .x-post {
    margin-top: 0.5rem;
    font-size: 12px;
    line-height: 1.6;
    color: #46474d;
  }
</style>
