---
import { siteConfig } from "@/lib/site";

type Props = { value: string };
const { value } = Astro.props;

// 构建间稳定的贡献格深浅（5 行 × 14 列）。
const ghCells = Array.from({ length: 70 }, (_, i) => ((i * 37 + 11) % 19) % 5);
---

<div class="gh-card">
  <div class="gh-bar">
    <span class="gh-dot" />
    <span class="gh-dot" />
    <span class="gh-dot" />
    <span class="gh-path">~/{siteConfig.author.toLowerCase()}</span>
  </div>
  <p class="gh-cmd">
    <span class="gh-prompt">$</span> git clone {value}
  </p>
  <div class="gh-graph">
    {ghCells.map((level) => <span class={`gh-cell gh-l${level}`} />)}
  </div>
</div>

<style>
  .gh-card {
    position: relative;
    box-shadow: var(--artifact-shadow);
    width: 15rem;
    padding: 0 0.875rem 0.875rem;
    background: #16171c;
    border-radius: 0.75rem;
    font-family: var(--font-mono);
  }

  .gh-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.625rem 0;
  }

  .gh-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #37383f;
  }

  .gh-path {
    margin-left: 0.375rem;
    font-size: 10px;
    color: #8b8c92;
  }

  .gh-cmd {
    font-size: 11px;
    color: #deddd8;
  }

  .gh-prompt {
    color: #7ee787;
  }

  .gh-graph {
    display: grid;
    grid-template-columns: repeat(14, 1fr);
    gap: 3px;
    margin-top: 0.75rem;
  }

  .gh-cell {
    aspect-ratio: 1;
    border-radius: 2px;
  }

  .gh-l0 {
    background: #23242b;
  }
  .gh-l1 {
    background: #0e4429;
  }
  .gh-l2 {
    background: #006d32;
  }
  .gh-l3 {
    background: #26a641;
  }
  .gh-l4 {
    background: #39d353;
  }
</style>
