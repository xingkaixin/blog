---
import { resolveCover } from "@/lib/covers";
import { postHref, type PublishedPost } from "@/lib/published-post";

type Props = {
  posts: PublishedPost[];
};

const records = Astro.props.posts.map((post) => {
  const cover = resolveCover(post.cover);
  return {
    href: postHref(post.slug),
    title: post.title,
    date: post.date,
    summary: post.summary,
    cover: cover.desktop,
  };
});
const first = records[0];
---

{
  first && (
    <section class="mx-auto max-w-320 border-t border-line px-3 py-12 sm:px-5 lg:px-8 lg:py-16 print:hidden">
      <record-shuffle
        data-records={JSON.stringify(records)}
        class="mx-auto grid max-w-5xl items-center gap-8 md:grid-cols-[minmax(0,440px)_minmax(0,1fr)] md:gap-14"
      >
        <div class="deck" aria-hidden="true">
          <img class="sleeve" data-record-cover src={first.cover} alt="" width="260" height="260" loading="lazy" decoding="async" />
          <svg class="turntable" viewBox="0 0 160 132" fill="none">
            <defs>
              <linearGradient id="shuffle-wood" x1="10" y1="20" x2="150" y2="120" gradientUnits="userSpaceOnUse">
                <stop stop-color="#c49c72" /><stop offset="1" stop-color="#97704f" />
              </linearGradient>
            </defs>
            <ellipse cx="81" cy="119" rx="68" ry="7" fill="#29251d" opacity=".09" />
            <rect x="20" y="111" width="15" height="9" rx="3" fill="#554b3e" />
            <rect x="124" y="111" width="15" height="9" rx="3" fill="#554b3e" />
            <rect x="8" y="16" width="144" height="100" rx="8" fill="#77583e" stroke="#594633" stroke-width="1.5" />
            <rect x="8" y="10" width="144" height="99" rx="8" fill="url(#shuffle-wood)" stroke="#75583e" stroke-width="1.5" />
            <path d="M17 100H142 M20 104H60 M113 14H141" stroke="#e0bc91" stroke-linecap="round" opacity=".4" />
            <circle cx="64" cy="59" r="43" fill="#47463d" />
            <g class="vinyl" data-record-vinyl>
              <circle cx="64" cy="59" r="40" fill="#252725" stroke="#151b19" />
              {[22, 26, 30, 34, 37].map((r) => <circle cx="64" cy="59" r={r} stroke="#9a9d90" stroke-width=".6" opacity=".19" />)}
              <path d="M44 26A39 39 0 0 1 74 21L68 42A17 17 0 0 0 55 44Z M55 76L44 93A39 39 0 0 0 72 98L67 77Z" fill="#c6ccc0" opacity=".1" />
              <circle class="label" cx="64" cy="59" r="16" />
              <text class="label-year" x="64" y="62" text-anchor="middle" data-record-year>{first.date.slice(0, 4)}</text>
              <circle cx="64" cy="52" r="1.6" fill="#282b25" />
            </g>
            <circle cx="64" cy="59" r="1.2" fill="#e5e0ce" />
            <rect x="126" y="67" width="8" height="20" rx="3" fill="#725943" />
            <circle cx="121" cy="30" r="11" fill="#6c6251" stroke="#584e41" />
            <circle cx="121" cy="30" r="7" fill="#b3b3a3" />
            <g class="tonearm">
              <path d="M121 20V63L130 76" stroke="#514d42" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M121 20V63L130 76" stroke="#d4d4c5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="116" y="14" width="10" height="9" rx="2" fill="#777b71" stroke="#555b51" />
              <rect x="125" y="72" width="10" height="16" rx="2" transform="rotate(-33 130 80)" fill="#343c35" stroke="#222b25" />
              <path d="M134 86L136 89" stroke="#dedbcc" stroke-width="1.5" />
            </g>
            <circle cx="121" cy="30" r="3" fill="#dfdfcf" stroke="#858777" />
            <circle cx="22" cy="96" r="2.3" fill="#dbe9a0" />
          </svg>
        </div>

        <div class="record-copy min-w-0" aria-live="polite">
          <p class="font-mono text-xs text-ink-500">
            <time data-record-date datetime={first.date}>{first.date}</time><span data-record-elapsed></span>
          </p>
          <h2 data-record-title class="mt-3.5 text-balance font-display text-4xl leading-[1.12] text-ink-800 sm:text-[44px]">
            {first.title}
          </h2>
          <p data-record-summary class="mt-4 line-clamp-3 max-w-[34em] text-[15px] leading-7 text-ink-500">
            {first.summary}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-2.5">
            <a
              data-record-link
              href={first.href}
              class="inline-flex h-10 items-center rounded-[6px] bg-ink-800 px-[18px] font-mono text-xs text-paper transition-colors hover:bg-accent hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
            >
              读这一篇 →
            </a>
            <button
              type="button"
              data-record-next
              disabled
              class="inline-flex h-10 items-center gap-2 rounded-[6px] border border-line bg-surface px-4 font-mono text-xs text-ink-700 transition-colors hover:border-ink-300 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 disabled:cursor-default disabled:opacity-60"
            >
              <svg aria-hidden="true" class="h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7h3.5c2.3 0 3.8 1.2 5 3.2l1 1.6c1.2 2 2.7 3.2 5 3.2H21M18 12l3 3-3 3M3 17h3.5c1.4 0 2.5-.4 3.4-1.2M14.1 8.2c.9-.8 2-1.2 3.4-1.2H21M18 4l3 3-3 3" />
              </svg>
              换一张
            </button>
          </div>
        </div>
      </record-shuffle>
    </section>
  )
}

<style>
  record-shuffle { display: grid; }
  .deck { position: relative; height: 320px; }
  .sleeve {
    position: absolute;
    top: 20px;
    left: 0;
    width: 260px;
    height: 260px;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: var(--shadow-card);
    rotate: -3deg;
    transition: opacity 300ms ease;
  }
  .turntable { position: absolute; top: 82px; left: 160px; width: 280px; overflow: visible; }
  .vinyl { transform-origin: 64px 59px; transition: transform 1400ms var(--ease-smooth-out); }
  .label { fill: var(--accent); }
  .label-year { fill: var(--accent-soft); font: 8px var(--font-mono); }
  .tonearm { transform-origin: 121px 30px; transform: rotate(44deg); transition: transform 420ms var(--ease-smooth-out); }
  .record-copy { transition: opacity 300ms ease; }
  [data-changing] .sleeve, [data-changing] .record-copy { opacity: 0; }
  [data-changing] .tonearm { transform: none; }
  @media (max-width: 47.999rem) {
    .deck { height: 250px; }
    .sleeve { width: 200px; height: 200px; }
    .turntable { top: 66px; left: 120px; width: 220px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sleeve, .vinyl, .tonearm, .record-copy { transition: none; }
  }
</style>

<script>
  import { elapsedSince, pickRandom } from "@/lib/record-shuffle";

  type ShuffleRecord = { href: string; title: string; date: string; summary: string; cover: string };

  // 唱臂抬起和文字淡出都在这段时间内完成，之后再换内容
  const LIFT_MS = 420;

  class RecordShuffle extends HTMLElement {
    private timer = 0;

    connectedCallback() {
      const records = JSON.parse(this.dataset.records ?? "[]") as ShuffleRecord[];
      const cover = this.querySelector<HTMLImageElement>("[data-record-cover]")!;
      const vinyl = this.querySelector<SVGGElement>("[data-record-vinyl]")!;
      const year = this.querySelector<SVGTextElement>("[data-record-year]")!;
      const date = this.querySelector<HTMLTimeElement>("[data-record-date]")!;
      const elapsed = this.querySelector<HTMLElement>("[data-record-elapsed]")!;
      const title = this.querySelector<HTMLElement>("[data-record-title]")!;
      const summary = this.querySelector<HTMLElement>("[data-record-summary]")!;
      const link = this.querySelector<HTMLAnchorElement>("[data-record-link]")!;
      const next = this.querySelector<HTMLButtonElement>("[data-record-next]")!;
      let current = pickRandom(records);
      let spin = 0;

      const show = (record: ShuffleRecord) => {
        cover.src = record.cover;
        year.textContent = record.date.slice(0, 4);
        date.textContent = record.date;
        date.dateTime = record.date;
        elapsed.textContent = ` · ${elapsedSince(record.date, new Date())}`;
        title.textContent = record.title;
        summary.textContent = record.summary;
        link.href = record.href;
      };

      if (!current) {
        return;
      }
      show(current);
      next.disabled = false;
      next.addEventListener("click", () => {
        if (this.hasAttribute("data-changing")) {
          return;
        }
        current = pickRandom(records, current);
        if (!current) {
          return;
        }
        const record = current;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          show(record);
          return;
        }
        this.toggleAttribute("data-changing", true);
        this.timer = window.setTimeout(async () => {
          show(record);
          spin += 540;
          vinyl.style.transform = `rotate(${spin}deg)`;
          await cover.decode().catch(() => undefined);
          this.removeAttribute("data-changing");
        }, LIFT_MS);
      });
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
    }
  }

  if (!customElements.get("record-shuffle")) {
    customElements.define("record-shuffle", RecordShuffle);
  }
</script>
