---
/**
 * 锦鲤池：WebGL2 实时水面。渲染代码在滚进视口时才动态载入，
 * 并只在可见且用户未要求减少动效时消耗 GPU。
 */
import { localeFromPath } from "@/lib/i18n";
import { homeMessages } from "@/lib/messages/home";

const t = homeMessages[localeFromPath(Astro.url.pathname)].koi;
---

<div class="pond-stage" data-pond-stage>
  <canvas
    class="pond-canvas"
    data-pond-canvas
    role="button"
    tabindex="0"
    aria-label={t.surface}
    aria-describedby="pond-instructions"></canvas>
  <canvas class="pond-overlay" data-pond-overlay aria-hidden="true"></canvas>
  <p class="pond-hint" data-pond-hint role="status" aria-live="polite" aria-atomic="true">{t.phases.idle}</p>
  <div class="pond-dock" data-pond-dock hidden>
    <button type="button" class="pond-rod" data-pond-rod aria-pressed="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
        <path d="M3 21 21 3" stroke="#d6b876" stroke-width="2" />
        <path d="M21 3c0 6-6 10-6 14" stroke-width="1.2" />
        <circle cx="15" cy="17" r="2" fill="#ee532f" stroke-width="0.8" />
      </svg>
      <span data-pond-rod-label>{t.rod}</span>
    </button>
    <span class="pond-basket" aria-label={t.basket}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m4 10 2 10h12l2-10M3 10h18M8 10l4-7 4 7M10 13v4m4-4v4" />
      </svg>
      <span data-pond-count>{t.caught(0)}</span>
    </span>
  </div>
  <aside class="pond-bottle" data-pond-bottle hidden aria-label={t.bottle.label}>
    <p class="pond-bottle-date" data-pond-bottle-date></p>
    <p class="pond-bottle-title" data-pond-bottle-title></p>
    <p class="pond-bottle-summary" data-pond-bottle-summary></p>
    <div class="pond-bottle-actions">
      <a class="pond-bottle-open" data-pond-bottle-open href="/posts/">{t.bottle.open}</a>
      <button type="button" class="pond-bottle-release" data-pond-bottle-release>{t.bottle.release}</button>
    </div>
  </aside>
  <p id="pond-instructions" class="sr-only">{t.instructions}</p>
</div>

<style>
  .pond-stage {
    position: relative;
    overflow: hidden;
    height: 100%;
    background: #0d2b2b;
    cursor: crosshair;
    /* 纵向留给页面滚动，只有横向拖动用来划水 */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* 池子的世界坐标是 3:1，取景框比它高时横向裁切，画面才不会被压扁。
     宽度必须由高度和 aspect-ratio 推出：一旦让 canvas 的内在尺寸参与布局，
     绘制缓冲会把自己撑大，再触发 ResizeObserver，一路放大到像素上限。 */
  .pond-canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    translate: -50% -50%;
    aspect-ratio: 3 / 1;
    height: 100%;
    width: auto;
  }

  .pond-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pond-stage:has(.pond-canvas:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .pond-hint {
    position: absolute;
    top: 12px;
    right: 12px;
    margin: 0;
    padding: 6px 12px;
    max-width: calc(100% - 24px);
    border-radius: 6px;
    background: rgba(6, 26, 24, 0.76);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    pointer-events: none;
    transition: opacity var(--duration-quick) var(--ease-smooth-out);
  }

  .pond-hint.is-hidden {
    opacity: 0;
  }

  .pond-stage[data-fishing="bite"] .pond-hint,
  .pond-stage[data-fishing="reeling"] .pond-hint {
    color: #ffe1a0;
  }

  .pond-dock {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    border: 1px solid rgba(235, 245, 240, 0.24);
    border-radius: 7px;
    background: rgba(6, 26, 24, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #edf4ed;
    cursor: default;
  }

  .pond-dock[hidden] {
    display: none;
  }

  .pond-rod {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    min-width: 112px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition: transform var(--duration-quick) var(--ease-smooth-out);
  }

  .pond-rod:active {
    transform: scale(0.97);
  }

  .pond-rod:focus-visible {
    outline: 2px solid #b2e8d5;
    outline-offset: -3px;
  }

  .pond-rod[aria-pressed="true"] {
    color: #a1ead3;
  }

  .pond-basket {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    border-left: 1px solid rgba(235, 245, 240, 0.2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .pond-bottle {
    /* 池子左侧站着人物和菲菲，卡片放在右上角的提示条下方 */
    position: absolute;
    top: 52px;
    right: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(340px, calc(100% - 24px));
    padding: 18px 20px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink-800);
    cursor: default;
    user-select: text;
    -webkit-user-select: text;
    transition:
      opacity var(--duration-fast) var(--ease-smooth-out),
      translate var(--duration-fast) var(--ease-smooth-out);
  }

  .pond-bottle[hidden] {
    display: none;
  }

  @starting-style {
    .pond-bottle {
      opacity: 0;
      translate: 0 8px;
    }
  }

  .pond-bottle p {
    margin: 0;
  }

  .pond-bottle-date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--film);
  }

  .pond-bottle-title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
    text-wrap: balance;
  }

  .pond-bottle-summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    line-height: 22px;
    color: var(--ink-600);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .pond-bottle-actions {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }

  .pond-bottle-open,
  .pond-bottle-release {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 6px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: transform var(--duration-quick) var(--ease-smooth-out);
  }

  .pond-bottle-open {
    background: var(--accent);
    color: var(--bg);
  }

  .pond-bottle-release {
    border: 1px solid var(--ink-200);
    color: var(--ink-800);
  }

  .pond-bottle-open:active,
  .pond-bottle-release:active {
    transform: scale(0.97);
  }

  .pond-bottle-open:focus-visible,
  .pond-bottle-release:focus-visible {
    outline: 2px solid #b2e8d5;
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    /* 窄屏的池子矮，摘要省掉 */
    .pond-bottle-summary {
      display: none;
    }
  }

  @media (min-width: 640px) {
    /* 让开右缘的场景导航 */
    .pond-bottle {
      right: 56px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .pond-rod:hover {
      background: rgba(235, 245, 240, 0.08);
    }
  }

  .pond-fail {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 24px;
    color: #cfe3da;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .pond-stage {
      cursor: default;
    }

    .pond-hint,
    .pond-dock {
      display: none;
    }
  }
</style>

<script>
  import type { PondHandle } from "@/lib/koi-pond/pond";
  import type { FishingStatus } from "@/lib/koi-pond/fishing";
  import { localeFromLang } from "@/lib/i18n";
  import { homeMessages } from "@/lib/messages/home";
  import { postHref } from "@/lib/published-post";
  import { pickRandom } from "@/lib/record-shuffle";
  import { loadSearchIndex, type SearchIndexItem } from "@/lib/search";
  import { collectStamp } from "@/lib/stamps";

  let pond: PondHandle | null = null;
  let pending: IntersectionObserver | null = null;
  // 每次拆除都作废在途的挂载，避免动态 import 落地时页面已经切走
  let generation = 0;
  let controls: AbortController | null = null;
  const motion = matchMedia("(prefers-reduced-motion: reduce)");

  function teardown(loseContext = false) {
    generation++;
    pending?.disconnect();
    pending = null;
    pond?.destroy(loseContext);
    pond = null;
    controls?.abort();
    controls = null;
  }

  async function mount(stage: HTMLElement, canvas: HTMLCanvasElement) {
    const hint = stage.querySelector<HTMLElement>("[data-pond-hint]");
    const overlay = stage.querySelector<HTMLCanvasElement>("[data-pond-overlay]");
    const dock = stage.querySelector<HTMLElement>("[data-pond-dock]");
    const button = stage.querySelector<HTMLButtonElement>("[data-pond-rod]");
    const label = stage.querySelector<HTMLElement>("[data-pond-rod-label]");
    const count = stage.querySelector<HTMLElement>("[data-pond-count]");
    const bottle = stage.querySelector<HTMLElement>("[data-pond-bottle]");
    const bottleOpen = stage.querySelector<HTMLAnchorElement>("[data-pond-bottle-open]");
    const bottleRelease = stage.querySelector<HTMLButtonElement>("[data-pond-bottle-release]");
    if (!hint || !overlay || !dock || !button || !label || !count || !bottle || !bottleOpen || !bottleRelease) {return;}
    const mine = generation;
    const t = homeMessages[localeFromLang(document.documentElement.lang)].koi;
    const [{ createPond }, { FishingPhase }] = await Promise.all([
      import("@/lib/koi-pond/pond"),
      import("@/lib/koi-pond/fishing"),
    ]);
    if (mine !== generation) {return;}

    let bottledPost: Promise<SearchIndexItem | undefined> | null = null;
    const showBottle = async (post: Promise<SearchIndexItem | undefined>) => {
      const item = await post.catch(() => undefined);
      if (mine !== generation || !item) {return;}
      pond?.setFishing(false);
      const text = (name: string, value: string) => {
        bottle.querySelector<HTMLElement>(`[data-pond-bottle-${name}]`)!.textContent = value;
      };
      text("date", item.date);
      text("title", item.title);
      text("summary", item.summary);
      bottleOpen.href = postHref(item.slug);
      bottle.hidden = false;
    };

    const updateFishing = (status: FishingStatus) => {
      stage.dataset.fishing = status.phase;
      button.setAttribute("aria-pressed", String(status.phase !== "idle"));
      label.textContent = status.phase === "idle" ? t.rod : t.dropRod;
      count.textContent = t.caught(status.caught);
      hint.classList.remove("is-hidden");
      hint.textContent =
        status.catch?.kind === "koi"
          ? t.landed(t.species[status.catch.palette], status.catch.length)
          : status.catch
            ? t.bottle.hooked
            : status.missed ? t.missed : t.phases[status.phase];
      if (status.catch) {
        collectStamp("catch");
      }
      if (status.catch?.kind === "bottle") {
        bottle.hidden = true;
        // 提竿的同时取一篇往年的文章，瓶子落进鱼篓时卡片正好能展开
        bottledPost = loadSearchIndex().then((posts) => {
          const thisYear = new Date().getFullYear();
          const earlier = posts.filter((post) => Number(post.date.slice(0, 4)) < thisYear);
          return pickRandom(earlier.length > 0 ? earlier : posts);
        });
      } else if (bottledPost) {
        void showBottle(bottledPost);
        bottledPost = null;
      }
    };
    updateFishing({ phase: FishingPhase.Idle, caught: 0 });
    canvas.tabIndex = motion.matches ? -1 : 0;
    canvas.setAttribute("role", motion.matches ? "img" : "button");
    if (motion.matches) {
      canvas.removeAttribute("aria-describedby");
    } else {
      canvas.setAttribute("aria-describedby", "pond-instructions");
    }
    const result = createPond(canvas, {
      animated: !motion.matches,
      overlay,
      onFishingChange: updateFishing,
      onFirstDrop: () => hint?.classList.add("is-hidden"),
      onContextRestored: setup,
    });

    if (!result.ok) {
      hint?.remove();
      dock.hidden = true;
      canvas.tabIndex = -1;
      canvas.setAttribute("role", "img");
      canvas.removeAttribute("aria-describedby");
      const message = document.createElement("p");
      message.className = "pond-fail";
      message.textContent = t.failures[result.reason];
      stage.append(message);
      return;
    }
    pond = result.pond;
    dock.hidden = motion.matches;
    controls = new AbortController();
    button.addEventListener("click", () => {
      const active = button.getAttribute("aria-pressed") !== "true";
      pond?.setFishing(active);
      if (active) {
        bottle.hidden = true;
        canvas.focus({ preventScroll: true });
      }
    }, { signal: controls.signal });
    bottleRelease.addEventListener("click", () => {
      bottle.hidden = true;
      button.focus({ preventScroll: true });
    }, { signal: controls.signal });
  }

  function setup() {
    teardown();
    const stage = document.querySelector<HTMLElement>("[data-pond-stage]");
    const canvas = stage?.querySelector<HTMLCanvasElement>("[data-pond-canvas]");
    if (!stage || !canvas) {return;}

    // 池子在首页最后一幕，滚近了再拉取渲染代码，首屏不为它付出 JS 成本
    pending = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) {return;}
        teardown();
        void mount(stage, canvas);
      },
      { rootMargin: "200px" },
    );
    pending.observe(stage);
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", () => teardown(true));
  motion.addEventListener("change", setup);
</script>
