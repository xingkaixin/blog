---
import type { Locale } from "@/lib/i18n";
import { chromeMessages } from "@/lib/messages/chrome";
import { isSiteRouteActive, mobileNavigation, type SiteRouteId } from "@/lib/site-navigation";
import { siteShortcuts } from "@/lib/site-shortcuts";
import { stamps } from "@/lib/stamps";

type Props = {
  currentPath: string;
  locale: Locale;
};

const { currentPath, locale } = Astro.props;
const t = chromeMessages[locale];
const routes = mobileNavigation(locale);
const menuId = "mobile-header-nav-menu";
const menuItemClass =
  "t-dropdown-item flex w-full items-center gap-3 rounded-[6px] px-3 py-2.5 text-left text-sm text-ink-600 transition-colors hover:bg-ink-50 hover:text-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 aria-[current=page]:bg-ink-50 aria-[current=page]:text-ink-800";

const routeIconPaths: Record<SiteRouteId, string> = {
  home: "M219.31,108.68l-80-80a16,16,0,0,0-22.62,0l-80,80A15.87,15.87,0,0,0,32,120v96a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V160h32v56a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V120A15.87,15.87,0,0,0,219.31,108.68ZM208,208H160V152a8,8,0,0,0-8-8H104a8,8,0,0,0-8,8v56H48V120l80-80,80,80Z",
  posts:
    "M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z",
  projects:
    "M223.85,47.12a16,16,0,0,0-15-15c-12.58-.75-44.73.4-71.41,27.07L132.69,64H74.36A15.91,15.91,0,0,0,63,68.68L28.7,103a16,16,0,0,0,9.07,27.16l38.47,5.37,44.21,44.21,5.37,38.49a15.94,15.94,0,0,0,10.78,12.92,16.11,16.11,0,0,0,5.1.83A15.91,15.91,0,0,0,153,227.3L187.32,193A15.91,15.91,0,0,0,192,181.64V123.31l4.77-4.77C223.45,91.86,224.6,59.71,223.85,47.12ZM74.36,80h42.33L77.16,119.52,40,114.34Zm74.41-9.45a76.65,76.65,0,0,1,59.11-22.47,76.46,76.46,0,0,1-22.42,59.16L128,164.68,91.32,128ZM176,181.64,141.67,216l-5.19-37.17L176,139.31Zm-74.16,9.5C97.34,201,82.29,224,40,224a8,8,0,0,1-8-8c0-42.29,23-57.34,32.86-61.85a8,8,0,0,1,6.64,14.56c-6.43,2.93-20.62,12.36-23.12,38.91,26.55-2.5,36-16.69,38.91-23.12a8,8,0,1,1,14.56,6.64Z",
  photos:
    "M216,40H72A16,16,0,0,0,56,56V72H40A16,16,0,0,0,24,88V200a16,16,0,0,0,16,16H184a16,16,0,0,0,16-16V184h16a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM72,56H216v62.75l-10.07-10.06a16,16,0,0,0-22.63,0l-20,20-44-44a16,16,0,0,0-22.62,0L72,109.37ZM184,200H40V88H56v80a16,16,0,0,0,16,16H184Zm32-32H72V132l36-36,49.66,49.66a8,8,0,0,0,11.31,0L194.63,120,216,141.38V168ZM160,84a12,12,0,1,1,12,12A12,12,0,0,1,160,84Z",
  tags: "M243.31,136,144,36.69A15.86,15.86,0,0,0,132.69,32H40a8,8,0,0,0-8,8v92.69A15.86,15.86,0,0,0,36.69,144L136,243.31a16,16,0,0,0,22.63,0l84.68-84.68a16,16,0,0,0,0-22.63ZM147.31,232,48,132.69V48h84.69L232,147.31ZM96,84A12,12,0,1,1,84,72,12,12,0,0,1,96,84Z",
  feed: "M106.91,149.09A71.53,71.53,0,0,1,128,200a8,8,0,0,1-16,0,56,56,0,0,0-56-56,8,8,0,0,1,0-16A71.53,71.53,0,0,1,106.91,149.09ZM56,80a8,8,0,0,0,0,16A104,104,0,0,1,160,200a8,8,0,0,0,16,0A120,120,0,0,0,56,80Zm118.79,1.21A166.9,166.9,0,0,0,56,32a8,8,0,0,0,0,16A151,151,0,0,1,163.48,92.52,151,151,0,0,1,208,200a8,8,0,0,0,16,0A166.9,166.9,0,0,0,174.79,81.21ZM60,184a12,12,0,1,0,12,12A12,12,0,0,0,60,184Z",
};
---

<mobile-header-menu
  class="relative shrink-0 lg:hidden"
  data-open-label={t.openNav}
  data-close-label={t.closeNav}
>
  <button
    type="button"
    data-mobile-menu-trigger
    aria-label={t.openNav}
    aria-expanded="false"
    aria-controls={menuId}
    class="relative inline-flex h-[34px] w-[34px] items-center justify-center rounded-[8px] border border-line bg-surface text-ink-600 transition-[transform,background-color] before:absolute before:-inset-[5px] hover:bg-ink-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 active:scale-[0.96]"
  >
    <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor" class="h-4 w-4">
      <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z" />
    </svg>
  </button>

  <div
    id={menuId}
    data-mobile-menu-panel
    data-origin="top-right"
    aria-hidden="true"
    inert
    class="t-dropdown absolute right-0 top-11 z-30 w-56 rounded-[10px] border border-line bg-surface p-2 shadow-[0_22px_60px_-36px_rgba(0,0,0,0.5)]"
  >
    <nav aria-label={t.mobileNav} class="space-y-1">
      {
        routes.map((route, index) => {
          const active = isSiteRouteActive(currentPath, route.path);
          return (
            <a
              href={route.href}
              data-mobile-menu-first={index === 0 ? "" : undefined}
              data-astro-reload={route.reload ? "" : undefined}
              aria-current={active ? "page" : undefined}
              style={`--item-index: ${index}`}
              class={menuItemClass}
            >
              <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor" class="h-4 w-4 shrink-0">
                <path d={routeIconPaths[route.id]} />
              </svg>
              {route.label}
            </a>
          );
        })
      }
      <div class="my-1 h-px bg-line"></div>
      <button
        type="button"
        data-mobile-menu-stamps
        style={`--item-index: ${routes.length}`}
        class={menuItemClass}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 shrink-0"
        >
          <circle cx="12" cy="12" r="8.5" />
          <circle cx="12" cy="12" r="5" stroke-dasharray="2 2" />
        </svg>
        {t.stamps.title}
        <span class="ml-auto font-mono text-[10px] text-ink-400">
          <span data-stamp-count>0</span>/{stamps.length}
        </span>
      </button>
      <button
        type="button"
        data-mobile-menu-theme
        style={`--item-index: ${routes.length + 1}`}
        class={menuItemClass}
      >
        <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor" class="h-4 w-4 shrink-0">
          <path d="M240,96a8,8,0,0,1-8,8H216v16a8,8,0,0,1-16,0V104H184a8,8,0,0,1,0-16h16V72a8,8,0,0,1,16,0V88h16A8,8,0,0,1,240,96ZM144,56h8v8a8,8,0,0,0,16,0V56h8a8,8,0,0,0,0-16h-8V32a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16Zm72.77,97a8,8,0,0,1,1.43,8A96,96,0,1,1,95.07,37.8a8,8,0,0,1,10.6,9.06A88.07,88.07,0,0,0,209.14,150.33,8,8,0,0,1,216.77,153Zm-19.39,14.88c-1.79.09-3.59.14-5.38.14A104.11,104.11,0,0,1,88,64c0-1.79,0-3.59.14-5.38A80,80,0,1,0,197.38,167.86Z" />
        </svg>
        {t.flipWorld}
        <span class="ml-auto font-mono text-[10px] text-ink-400 pointer-coarse:hidden">
          {siteShortcuts.theme.hint}
        </span>
      </button>
    </nav>
  </div>
</mobile-header-menu>
