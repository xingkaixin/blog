---
import { getImage } from "astro:assets";
import curtain from "@/assets/travel-window/curtain.webp";
import frame from "@/assets/travel-window/frame.webp";
import bangkok from "@/assets/travel-window/scenes/bangkok.webp";
import chongqing from "@/assets/travel-window/scenes/chongqing.webp";
import harbin from "@/assets/travel-window/scenes/harbin.webp";
import hongKong from "@/assets/travel-window/scenes/hong-kong.webp";
import kyoto from "@/assets/travel-window/scenes/kyoto.webp";
import suzhou from "@/assets/travel-window/scenes/suzhou.webp";
import { localeFromPath } from "@/lib/i18n";
import { homeMessages } from "@/lib/messages/home";

const places = homeMessages[localeFromPath(Astro.url.pathname)].places;
const scenes = await Promise.all(
  (
    [
      ["kyoto", kyoto],
      ["hong-kong", hongKong],
      ["bangkok", bangkok],
      ["chongqing", chongqing],
      ["suzhou", suzhou],
      ["harbin", harbin],
    ] as const
  ).map(async ([id, src]) => {
    const image = await getImage({ src, widths: [360, 720], format: "webp" });
    return { name: places[id], src: image.src, srcset: image.srcSet.attribute };
  }),
);
const frameImage = await getImage({ src: frame, widths: [420, 840], format: "webp" });
const curtainImage = await getImage({ src: curtain, width: 400, format: "webp" });
const [first] = scenes;
---

<travel-window data-story-art data-stamped data-scenes={JSON.stringify(scenes.map(({ src, srcset }) => ({ src, srcset })))}>
  <!-- 窄屏不显示窗户，地址由脚本在宽屏时填入 -->
  <div class="glass">
    <img class="view" data-src={first.src} data-srcset={first.srcset} sizes="28vh" alt="" decoding="async" />
    <canvas class="scenery" aria-hidden="true"></canvas>
  </div>
  <img class="frame" data-src={frameImage.src} data-srcset={frameImage.srcSet.attribute} sizes="44vh" alt="" decoding="async" />
  <span class="stamp">
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor"><circle cx="60" cy="60" r="56" stroke-width="3" /><circle cx="60" cy="60" r="48" stroke-width="1.2" stroke-dasharray="3 3" /></svg>
    <!-- 地名全部写进页面，字体裁剪脚本才收集得到这些字 -->
    {scenes.map((scene, index) => <span class="stamp-name" hidden={index > 0}>{scene.name}</span>)}
  </span>
  <canvas class="curtains" data-src={curtainImage.src}></canvas>
</travel-window>

<style>
  /* 按 1024px 的 frame.webp 换算：玻璃孔 (184, 197)–(840, 888)，窗帘杆两端约在 10% 与 90% */
  travel-window {
    --glass-top: 19.24%;
    --glass-left: 17.97%;
    --glass-right: 17.97%;
    --glass-bottom: 13.28%;
    --rod-end: 10.5%;
    --curtain-w: 16.5%;
    position: absolute;
    top: 8cqh;
    /* 沙发中线 68% 右侧紧挨头部；右边给场景导航的标签留出位置 */
    left: calc(68% + 1cqh);
    width: min(44cqh, calc(32% - 1cqh - 110px));
    aspect-ratio: 1;
    opacity: var(--art-fade, 1);
  }
  :global([data-theme="dark"]) travel-window { filter: brightness(.82) saturate(.9); }
  .glass { position: absolute; inset: var(--glass-top) var(--glass-right) var(--glass-bottom) var(--glass-left); overflow: hidden; background: var(--ink-50); }
  .view { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scenery { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  travel-window[data-scenery-ready] .scenery { opacity: 1; }
  travel-window[data-scenery-ready] .view { visibility: hidden; }
  .frame { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* 左右外扩的 8% 与 travel-curtains.ts 的 curtainBleed 一致 */
  .curtains { position: absolute; top: 0; left: -8%; width: 116%; height: 100%; }
  .stamp {
    position: absolute;
    right: calc(var(--rod-end) + var(--curtain-w) + 3%);
    bottom: calc(var(--glass-bottom) + 4%);
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    container-type: inline-size;
    color: var(--accent);
    opacity: 0;
    scale: 1.4;
    rotate: -12deg;
    mix-blend-mode: multiply;
    transition: opacity 200ms ease-out, scale 200ms ease-out;
  }
  .stamp svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stamp-name { font-family: var(--font-display); font-size: 15cqi; line-height: 1; letter-spacing: .04em; white-space: nowrap; }
  travel-window[data-stamped] .stamp { opacity: .9; scale: 1; transition: opacity 120ms ease-out, scale 320ms var(--ease-smooth-out); }
  @media (prefers-reduced-motion: reduce) {
    travel-window[data-scenery-ready] .scenery { opacity: 0; }
    travel-window[data-scenery-ready] .view { visibility: visible; }
  }
  @media (max-width: 47.999rem) {
    travel-window { display: none; }
  }
</style>

<script>
  import { createCurtains, type TravelCurtains } from "@/lib/travel-curtains";
  import { createTravelScenery, type TravelScenery } from "@/lib/travel-scenery";
  import { HOLD_DURATION_MS, RIDE_DURATION_MS, sampleTravelRide } from "@/lib/travel-window-motion";

  type Scene = { src: string; srcset: string };

  const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

  class TravelWindow extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const scenes = JSON.parse(this.dataset.scenes!) as Scene[];
      const view = this.querySelector<HTMLImageElement>(".view")!;
      const sceneryCanvas = this.querySelector<HTMLCanvasElement>(".scenery")!;
      const curtainsCanvas = this.querySelector<HTMLCanvasElement>(".curtains")!;
      const names = [...this.querySelectorAll<HTMLElement>(".stamp-name")];
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const wide = matchMedia("(min-width: 48rem)");
      const events = new AbortController();
      const loader = new Image();
      loader.decoding = "async";
      loader.sizes = "28vh";

      let stopped = false;
      let index = 0;
      let scenery: TravelScenery | null = null;
      let sceneryInitialized = false;
      let curtains: TravelCurtains | null = null;

      let frame = 0;
      let lastTime = 0;
      let rideStart = 0;
      let rideActive = false;
      let curtainsMoving = false;
      let rideResolve: (() => void) | null = null;

      const stampArrival = () => {
        view.srcset = scenes[index].srcset;
        view.src = scenes[index].src;
        names.forEach((name, stop) => {
          name.hidden = stop !== index;
        });
        this.toggleAttribute("data-stamped", true);
      };

      const finishActiveRide = (snapCurtains: boolean) => {
        if (rideActive) {
          rideActive = false;
          scenery?.commitRide();
          if (!stopped) {
            stampArrival();
          }
        }
        if (snapCurtains) {
          cancelAnimationFrame(frame);
          frame = 0;
          curtainsMoving = false;
          curtains?.reset();
        }
        const resolve = rideResolve;
        rideResolve = null;
        resolve?.();
      };

      const tick = (now: number) => {
        frame = 0;
        if (stopped) {
          return;
        }
        if (reducedMotion.matches || document.hidden) {
          finishActiveRide(true);
          return;
        }
        const dt = Math.min(0.05, Math.max(0, (now - lastTime) / 1000));
        lastTime = now;

        let speed = 0;
        let acceleration = 0;
        if (rideActive) {
          const tau = (now - rideStart) / RIDE_DURATION_MS;
          const ride = sampleTravelRide(tau);
          if (tau >= 1 || !scenery || !scenery.renderRide(ride.track, ride.blur)) {
            finishActiveRide(false);
          } else {
            speed = ride.speed;
            acceleration = ride.acceleration;
          }
        }

        curtainsMoving = curtains?.step(dt, speed, acceleration) ?? false;
        if (rideActive || curtainsMoving) {
          frame = requestAnimationFrame(tick);
        }
      };

      const wake = () => {
        if (!frame && !stopped) {
          lastTime = performance.now();
          frame = requestAnimationFrame(tick);
        }
      };

      const load = () => {
        if (!wide.matches) {
          return;
        }
        for (const image of this.querySelectorAll<HTMLImageElement>("img[data-src]")) {
          image.srcset = image.dataset.srcset!;
          image.src = image.dataset.src!;
          image.removeAttribute("data-src");
        }
        curtains ??= createCurtains(curtainsCanvas, curtainsCanvas.dataset.src!);
        if (!sceneryInitialized) {
          sceneryInitialized = true;
          scenery = createTravelScenery(sceneryCanvas);
          if (scenery) {
            void view
              .decode()
              .catch(() => undefined)
              .then(() => {
                if (!stopped && scenery?.setInitial(view)) {
                  this.setAttribute("data-scenery-ready", "");
                }
              });
          }
        }
      };

      const handleInterruption = () => {
        if ((reducedMotion.matches || document.hidden) && (rideActive || curtainsMoving)) {
          finishActiveRide(true);
        }
      };

      load();
      wide.addEventListener("change", load, { signal: events.signal });
      reducedMotion.addEventListener("change", handleInterruption, { signal: events.signal });
      document.addEventListener("visibilitychange", handleInterruption, { signal: events.signal });
      sceneryCanvas.addEventListener(
        "webglcontextlost",
        () => {
          this.removeAttribute("data-scenery-ready");
          scenery = null;
          finishActiveRide(true);
        },
        { signal: events.signal },
      );

      // 页面隐藏、窄屏不显示、窗户随滚动淡出或要求减少动态时停在当前城市
      const idle = () =>
        document.hidden || reducedMotion.matches || !wide.matches || Number(getComputedStyle(this).opacity) < 0.05;

      const travel = async () => {
        while (!stopped) {
          await wait(HOLD_DURATION_MS);
          if (stopped || idle()) {
            continue;
          }
          index = (index + 1) % scenes.length;
          loader.srcset = scenes[index].srcset;
          loader.src = scenes[index].src;
          await loader.decode().catch(() => undefined);
          if (stopped || idle()) {
            continue;
          }
          this.removeAttribute("data-stamped");
          if (scenery !== null && scenery.prepareRide(loader)) {
            await new Promise<void>((resolve) => {
              rideStart = performance.now();
              rideActive = true;
              rideResolve = resolve;
              wake();
            });
            if (stopped) {
              return;
            }
          } else {
            view.srcset = scenes[index].srcset;
            view.src = scenes[index].src;
            await view.decode().catch(() => undefined);
            if (stopped) {
              return;
            }
            stampArrival();
          }
        }
      };

      void travel();
      this.cleanup = () => {
        stopped = true;
        events.abort();
        finishActiveRide(true);
        scenery?.destroy();
        scenery = null;
        curtains?.destroy();
        curtains = null;
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get("travel-window")) {
    customElements.define("travel-window", TravelWindow);
  }
</script>
