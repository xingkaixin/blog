---
import { getImage } from "astro:assets";
import frame from "@/assets/travel-window/frame.webp";
import curtain from "@/assets/travel-window/curtain.webp";
import bangkok from "@/assets/travel-window/scenes/bangkok.webp";
import chongqing from "@/assets/travel-window/scenes/chongqing.webp";
import harbin from "@/assets/travel-window/scenes/harbin.webp";
import hongKong from "@/assets/travel-window/scenes/hong-kong.webp";
import kyoto from "@/assets/travel-window/scenes/kyoto.webp";
import suzhou from "@/assets/travel-window/scenes/suzhou.webp";
import { localeFromPath } from "@/lib/i18n";
import { homeMessages } from "@/lib/messages/home";

const places = homeMessages[localeFromPath(Astro.url.pathname)].places;
const scenes = await Promise.all(
  ([["kyoto", kyoto], ["hong-kong", hongKong], ["bangkok", bangkok], ["chongqing", chongqing], ["suzhou", suzhou], ["harbin", harbin]] as const).map(
    async ([id, src]) => {
      const image = await getImage({ src, widths: [360, 720], format: "webp" });
      return { name: places[id], src: image.src, srcset: image.srcSet.attribute };
    },
  ),
);
const frameImage = await getImage({ src: frame, widths: [420, 840], format: "webp" });
const curtainImage = await getImage({ src: curtain, width: 360, format: "webp" });
const [first] = scenes;
---

<travel-window data-story-art data-stamped data-scenes={JSON.stringify(scenes.map(({ src, srcset }) => ({ src, srcset })))}>
  <!-- 窄屏不显示窗户，地址由脚本在宽屏时填入 -->
  <div class="glass">
    <img class="view" data-current data-src={first.src} data-srcset={first.srcset} sizes="28vh" alt="" decoding="async" />
    <img class="view" sizes="28vh" alt="" decoding="async" />
  </div>
  <img class="frame" data-src={frameImage.src} data-srcset={frameImage.srcSet.attribute} sizes="44vh" alt="" decoding="async" />
  <canvas class="curtains" data-src={curtainImage.src}></canvas>
  <span class="stamp">
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor"><circle cx="60" cy="60" r="56" stroke-width="3" /><circle cx="60" cy="60" r="48" stroke-width="1.2" stroke-dasharray="3 3" /></svg>
    <!-- 地名全部写进页面，字体裁剪脚本才收集得到这些字 -->
    {scenes.map((scene, index) => <span class="stamp-name" hidden={index > 0}>{scene.name}</span>)}
  </span>
</travel-window>

<style>
  /* 按 1024px 的 frame.webp 换算：玻璃孔 (184, 197)–(840, 888)，窗帘杆两端约在 10% 与 90% */
  travel-window {
    --glass-top: 19.24%;
    --glass-left: 17.97%;
    --glass-right: 17.97%;
    --glass-bottom: 13.28%;
    --rod-end: 10.5%;
    --curtain-w: 16.5%;
    position: absolute;
    top: 8cqh;
    /* 沙发中线 68% 右侧紧挨头部；右边给场景导航的标签留出位置 */
    left: calc(68% + 1cqh);
    width: min(44cqh, calc(32% - 1cqh - 110px));
    aspect-ratio: 1;
    opacity: var(--art-fade, 1);
  }
  :global([data-theme="dark"]) travel-window { filter: brightness(.82) saturate(.9); }
  .glass { position: absolute; inset: var(--glass-top) var(--glass-right) var(--glass-bottom) var(--glass-left); overflow: hidden; background: var(--ink-50); }
  .view { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: translateX(100%); }
  .view[data-current] { transform: none; }
  .frame { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* 左右外扩的 8% 与 travel-curtains.ts 的 curtainBleed 一致 */
  .curtains { position: absolute; top: 0; left: -8%; width: 116%; height: 100%; }
  .stamp {
    position: absolute;
    right: calc(var(--rod-end) + var(--curtain-w) + 3%);
    bottom: calc(var(--glass-bottom) + 4%);
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    container-type: inline-size;
    color: var(--accent);
    opacity: 0;
    scale: 1.4;
    rotate: -12deg;
    mix-blend-mode: multiply;
    transition: opacity 200ms ease-out, scale 200ms ease-out;
  }
  .stamp svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stamp-name { font-family: var(--font-display); font-size: 15cqi; line-height: 1; letter-spacing: .04em; white-space: nowrap; }
  travel-window[data-stamped] .stamp { opacity: .9; scale: 1; transition: opacity 120ms ease-out, scale 320ms var(--ease-smooth-out); }
  @media (max-width: 47.999rem) {
    travel-window { display: none; }
  }
</style>

<script>
  import { createCurtains } from "@/lib/travel-curtains";

  type Scene = { src: string; srcset: string };

  const hold = 7000;
  const ride = 2600;

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  class TravelWindow extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const scenes = JSON.parse(this.dataset.scenes!) as Scene[];
      let [current, spare] = [...this.querySelectorAll<HTMLImageElement>(".view")];
      const canvas = this.querySelector<HTMLCanvasElement>(".curtains")!;
      const names = [...this.querySelectorAll<HTMLElement>(".stamp-name")];
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const wide = matchMedia("(min-width: 48rem)");
      const events = new AbortController();
      let stopped = false;
      let index = 0;
      let curtains: ReturnType<typeof createCurtains> = null;

      const load = () => {
        if (!wide.matches) {
          return;
        }
        for (const image of this.querySelectorAll<HTMLImageElement>("img[data-src]")) {
          image.srcset = image.dataset.srcset!;
          image.src = image.dataset.src!;
          image.removeAttribute("data-src");
        }
        curtains ??= createCurtains(canvas, canvas.dataset.src!);
      };
      load();
      wide.addEventListener("change", load, { signal: events.signal });

      // 页面隐藏、窄屏不显示、窗户随滚动淡出或要求减少动态时停在当前城市
      const idle = () =>
        document.hidden || reducedMotion.matches || !wide.matches || Number(getComputedStyle(this).opacity) < 0.05;

      const travel = async () => {
        while (!stopped) {
          await wait(hold);
          if (stopped || idle()) {
            continue;
          }
          index = (index + 1) % scenes.length;
          spare.srcset = scenes[index].srcset;
          spare.src = scenes[index].src;
          await spare.decode().catch(() => undefined);
          if (stopped) {
            return;
          }
          this.removeAttribute("data-stamped");
          curtains?.ride(ride);
          const timing = { duration: ride, easing: "cubic-bezier(.62, 0, .3, 1)" };
          const blur = { offset: 0.5, filter: "blur(1.4px)" };
          current.animate([{ transform: "none", filter: "none" }, blur, { transform: "translateX(-100%)", filter: "none" }], timing);
          const arrival = spare.animate([{ transform: "translateX(100%)", filter: "none" }, blur, { transform: "none", filter: "none" }], timing);
          current.removeAttribute("data-current");
          spare.toggleAttribute("data-current", true);
          [current, spare] = [spare, current];
          await arrival.finished.catch(() => undefined);
          names.forEach((name, stop) => (name.hidden = stop !== index));
          this.toggleAttribute("data-stamped", true);
        }
      };

      void travel();
      this.cleanup = () => {
        stopped = true;
        events.abort();
        curtains?.destroy();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get("travel-window")) {
    customElements.define("travel-window", TravelWindow);
  }
</script>
