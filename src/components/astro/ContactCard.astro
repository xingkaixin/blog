---
import type { SiteContact, SiteContactId } from "@/lib/site";
import Envelope from "./contact-artifacts/Envelope.astro";
import GithubTerminal from "./contact-artifacts/GithubTerminal.astro";
import XPost from "./contact-artifacts/XPost.astro";
import TelegramBubble from "./contact-artifacts/TelegramBubble.astro";

type Props = { contact: SiteContact };
const { contact } = Astro.props;

const contactPresentations = {
  email: {
    icon: {
      fill: false,
      path: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 3-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
    },
    Artifact: Envelope,
  },
  github: {
    icon: {
      fill: true,
      path: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z",
    },
    Artifact: GithubTerminal,
  },
  x: {
    icon: {
      fill: true,
      path: "M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12Z",
    },
    Artifact: XPost,
  },
  telegram: {
    icon: {
      fill: false,
      path: "M22 2 11 13m11-11-7 20-4-9-9-4Z",
    },
    Artifact: TelegramBubble,
  },
} as const satisfies Record<
  SiteContactId,
  { icon: { fill: boolean; path: string }; Artifact: typeof Envelope }
>;

const { icon, Artifact } = contactPresentations[contact.id];
---

<div class="contact-anchor relative border-b border-ink-100">
  <a
    href={contact.href}
    class="group flex items-center gap-2 py-3 text-ink-500 focus-visible:rounded-[4px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg
      aria-hidden="true"
      class="h-[15px] w-[15px]"
      viewBox="0 0 24 24"
      fill={icon.fill ? "currentColor" : "none"}
      stroke={icon.fill ? "none" : "currentColor"}
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={icon.path} />
    </svg>
    <span class="min-w-0 flex-1">
      <span class="block text-[12px] text-ink-700 group-hover:text-accent">{contact.label}</span>
      <span class="mt-0.5 block truncate font-mono text-[9px] text-ink-400">{contact.value}</span>
    </span>
    <span aria-hidden="true"
      class="font-mono text-[11px] text-ink-300 group-hover:text-accent">↗</span>
  </a>
  <div class="artifact" aria-hidden="true">
    <Artifact value={contact.value} />
  </div>
</div>

<style>
  /* 实物卡保留自身颜色，不随站点主题翻转。 */
  .artifact {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: -0.5rem;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px) rotate(-4deg) scale(0.95);
    transform-origin: bottom left;
    --artifact-shadow: 0 2px 6px rgba(20, 21, 26, 0.08), 0 18px 36px -14px rgba(20, 21, 26, 0.35);
    width: max-content;
    transition:
      transform var(--duration-fast) var(--ease-smooth-out),
      opacity var(--duration-fast) var(--ease-smooth-out);
    will-change: transform, opacity;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-anchor:hover .artifact {
      opacity: 1;
      transform: translateY(0) rotate(-1deg) scale(1);
    }
  }

  .contact-anchor:focus-within .artifact {
    opacity: 1;
    transform: translateY(0) rotate(-1deg) scale(1);
  }

  @media (min-width: 80rem) {
    .artifact {
      top: 50%;
      right: calc(100% + 0.75rem);
      bottom: auto;
      left: auto;
      transform: translate(10px, -50%) rotate(4deg) scale(0.95);
      transform-origin: right center;
    }

    .contact-anchor:focus-within .artifact {
      transform: translate(0, -50%) rotate(1deg) scale(1);
    }
  }

  @media (min-width: 80rem) and (hover: hover) and (pointer: fine) {
    .contact-anchor:hover .artifact {
      transform: translate(0, -50%) rotate(1deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artifact {
      transform: none;
      transition: opacity var(--duration-quick) var(--ease-smooth-out);
      will-change: opacity;
    }

    .contact-anchor:hover .artifact,
    .contact-anchor:focus-within .artifact {
      transform: none;
    }
  }
</style>
