/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://umami.xingkaixin.me; connect-src 'self' https://umami.xingkaixin.me https://photos.xingkaixin.me; img-src 'self' data: https://photos.xingkaixin.me; media-src 'self' https://photos.xingkaixin.me; style-src 'self' 'unsafe-inline'; font-src 'self' data:; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/cover/*
  Cache-Control: public, max-age=31536000, immutable

/posts/images/*
  Cache-Control: public, max-age=31536000, immutable

/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/holiday-logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/avatar.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/logo.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/f1-car.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/finish-flag.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/search-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/analytics/*
  X-Robots-Tag: noindex

/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Link: <https://xingkaixin.me/.well-known/api-catalog>; rel="api-catalog"
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, follow

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/feed-ai.xml
  Content-Type: application/rss+xml; charset=utf-8

/feed-life.xml
  Content-Type: application/rss+xml; charset=utf-8

/openapi.json
  Content-Type: application/vnd.oai.openapi+json;version=3.1
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, follow
