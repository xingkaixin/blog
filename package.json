{
  "name": "xingkaixin-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:config && bun run build:search && bun run build:covers && bun run build:post-images && bun run build:og && astro build --force && bun run build:redirects && bun run build:worker",
    "build:config": "bun scripts/validate-deployment-config.ts",
    "build:covers": "bun scripts/generate-covers.ts",
    "build:og": "bun scripts/generate-og-images.ts",
    "build:post-images": "bun scripts/generate-post-images.ts",
    "build:redirects": "bun scripts/generate-redirects.ts",
    "build:search": "bun scripts/generate-search-index.ts",
    "build:worker": "bun scripts/build-worker.ts",
    "check:generated": "bun scripts/check-generated-artifacts.ts",
    "check:source": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "deploy": "bun run photos:verify && bun run build && cf deploy --prebuilt",
    "dev": "astro dev",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "generate:signature-glyphs": "bun scripts/generate-signature-glyphs.ts",
    "isok": "bun run check:source && bun run build && bun run check:generated",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "photos:delete": "bun scripts/delete-photos.ts",
    "photos:gc": "bun scripts/collect-photo-garbage.ts",
    "photos:migrate": "bun scripts/migrate-photo-catalog.ts",
    "photos:publish": "bun scripts/publish-photos.ts",
    "photos:verify": "bun scripts/verify-photo-catalog.ts",
    "postinstall": "bun scripts/patch-smiley-font.ts",
    "preview": "astro preview",
    "test": "bun --bun vitest run",
    "typecheck": "astro check && tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn-fontsource-smiley-sans-oblique-regular": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tegaki": "^0.22.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/internal-helpers": "0.12.0",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@iannuttall/seo-graph-astro": "0.0.9",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.6",
    "exiftool-vendored": "^38.3.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "fflate": "0.7.5",
    "postcss-selector-parser": "7.1.6"
  },
  "packageManager": "bun@1.4.2"
}
